#!/usr/bin/env bash
# Number the open issues that a branch adds, when the branch is brought up to date with main
# (docs/09-open-issues.md). scripts/reverify runs both steps; running either again is a no-op.
#
# Usage: scripts/assign-oi-ids number [<dir>]    before the merge of origin/main
#        scripts/assign-oi-ids resolve [<dir>]   in a merge of origin/main that conflicted
#        scripts/assign-oi-ids tidy [<dir>]      after the merge
# <dir> is a worktree of the branch (default: the current directory; any directory of it), clean
# and on the branch, except for `resolve`, which runs in the conflicted merge.
#
# A branch writes `OI-NEW-<slug>` (slug: lowercase letters, digits, inner hyphens) for each new
# open issue, in its table row and in every reference. `number` replaces each placeholder, in the
# files the branch changed against its merge-base with origin/main, by the next free number
# (one above the highest OI of the branch and of origin/main), in the order of the rows, and
# commits the result. It also renumbers an open issue that the branch added with a number that
# origin/main has taken since (the branch was numbered while another pull request was not yet
# merged), with the same rewrite of the references. An open issue of the merge-base is never
# renumbered. A branch stacked on a pull request that has merged inherits that pull request's
# placeholders: when the merge-base still holds a placeholder row, `number` gives it the number
# recorded in the `OI-Assigned: <placeholder> <OI-nn>` trailer of a number commit between the
# merge-base and origin/main, and only such a placeholder (one that was already in the merge-base)
# takes a number from a trailer. A placeholder whose row is also in the merge-base with another open
# pull request (a parent this branch is stacked on, still open) stays unnumbered, with a line naming
# that pull request: numbering it now would give it a second number when the parent merges.
# scripts/reverify passes the other open pull requests as the file OI_OPEN_PRS (`<number> <sha>`
# lines) and its own number as OI_PR; a pull request that descends from this branch is no parent.
# The gate refuses the placeholder until the parent has merged and the branch is reverified.
# `resolve` finishes a merge whose only conflict is in the table
# of docs/09-open-issues.md, when every line on both sides of every hunk is a table row
# (`| OI-`), by keeping both sides; any other conflict is left alone and the exit status is 1.
# `tidy` puts the rows of the table in number order again after the merge, and commits.
# Exit status: 0 on success (also when nothing changed), 1 on a failure, 2 on a usage error.
set -euo pipefail

doc=docs/09-open-issues.md
mode="${1:-}"
dir="${2:-.}"
{ [ "$mode" = number ] || [ "$mode" = tidy ] || [ "$mode" = resolve ]; } || {
    awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
    exit 2
}
cd "$dir"
cd "$(git rev-parse --show-toplevel)"

if [ "$mode" = resolve ]; then
    [ "$(git diff --name-only --diff-filter=U)" = "$doc" ] || exit 1
    perl -e '
        my $file = shift;
        open my $in, "<", $file or die "$file: $!";
        my ($state, @out) = ("text");
        while (my $l = <$in>) {
            if ($l =~ /^<<<<<<< / && $state eq "text") { $state = "ours"; next; }
            if ($l =~ /^\|\|\|\|\|\|\| / && $state eq "ours") { $state = "base"; next; }
            if ($l =~ /^=======$/ && ($state eq "ours" || $state eq "base")) {
                $state = "theirs"; next;
            }
            if ($l =~ /^>>>>>>> / && $state eq "theirs") { $state = "text"; next; }
            exit 1 if $state ne "text" && $state ne "base" && $l !~ /^\| OI-/;
            push @out, $l unless $state eq "base";
        }
        exit 1 if $state ne "text";
        close $in;
        open my $o, ">", $file or die "$file: $!";
        print $o @out;
        close $o or die "$file: $!";
    ' "$doc" || exit 1
    git add -- "$doc"
    git commit -q --no-edit
    echo "assign-oi-ids: kept both sides of the open-issue rows that conflicted"
    exit 0
fi

[ -z "$(git status --porcelain)" ] || { echo "assign-oi-ids: $dir is dirty" >&2; exit 1; }
[ -f "$doc" ] || exit 0

# The OI numbers of the table at revision $1, one per line, without leading zeros.
oi_numbers() {
    { git show "$1:$doc" 2>/dev/null || true; } | { grep -oE '^\| OI-[0-9]+ \|' || true; } |
        sed 's/^| OI-0*//; s/ |$//'
}

if [ "$mode" = tidy ]; then
    # Sort the rows `| OI-<n> |` among the lines they occupy, by number, stably.
    perl -e '
        my $file = shift;
        open my $in, "<", $file or die "$file: $!";
        my @lines = <$in>;
        close $in;
        my @at = grep { $lines[$_] =~ /^\| OI-(\d+) \|/ } 0 .. $#lines;
        my @rows = sort { ($a->[0] <=> $b->[0]) || ($a->[1] <=> $b->[1]) }
            map { [$lines[$_] =~ /^\| OI-(\d+) \|/, $_] } @at;
        my @text = map { $lines[$_->[1]] } @rows;
        @lines[@at] = @text;
        open my $out, ">", $file or die "$file: $!";
        print $out @lines;
        close $out or die "$file: $!";
    ' "$doc"
    if [ -n "$(git status --porcelain)" ]; then
        git add -- "$doc"
        git commit -q -m "chore(oi): Put the open issues in number order"
        echo "assign-oi-ids: open issues put in number order"
    fi
    exit 0
fi

base="$(git merge-base HEAD origin/main)"
added="$(comm -13 <(oi_numbers "$base" | sort) <(oi_numbers HEAD | sort))"
taken="$(oi_numbers origin/main | sort)"
clash="$(comm -12 <(printf '%s\n' "$added") <(printf '%s\n' "$taken") | sort -n)"
next="$(printf '%s\n%s\n0\n' "$(oi_numbers HEAD)" "$taken" | sort -n | tail -n 1)"

map="$(mktemp "${TMPDIR:-/tmp}/assign-oi-ids.XXXXXX")"
trap 'rm -f "$map"' EXIT
for n in $clash; do
    next=$((next + 1))
    printf 'OI-%02d OI-%02d\n' "$n" "$next" >>"$map"
done
# The placeholders, in the order of the rows of the table.
placeholders="$(grep -oE '^\| OI-NEW-[a-z0-9]+(-[a-z0-9]+)* \|' "$doc" | sed 's/^| //; s/ |$//' ||
    true)"
assigned=""
base_doc="$(git show "$base:$doc" 2>/dev/null || true)"
for p in $placeholders; do
    grep -q "^$p " "$map" && continue
    # Inherited from a pull request this branch is stacked on, which has merged since.
    given=""
    if grep -qF "| $p |" <<<"$base_doc"; then
        given="$(git log --format=%B "$base..origin/main" |
            sed -n "s/^OI-Assigned: $p \(OI-[0-9][0-9]*\)$/\1/p" | head -n 1)"
    fi
    if [ -n "$given" ]; then
        printf '%s %s\n' "$p" "$given" >>"$map"
        continue
    fi
    # Held by an open parent: leave it until the parent has merged.
    waits=""
    if [ -n "${OI_OPEN_PRS:-}" ] && [ -s "$OI_OPEN_PRS" ]; then
        while read -r num sha; do
            ! git merge-base --is-ancestor HEAD "$sha" || continue
            mb="$(git merge-base HEAD "$sha")" || continue
            if git show "$mb:$doc" 2>/dev/null | grep -qF "| $p |"; then waits="$num"; break; fi
        done <"$OI_OPEN_PRS"
    fi
    if [ -n "$waits" ]; then
        echo "${OI_PR:+#$OI_PR: }OI placeholder $p waits for #$waits to merge"
        continue
    fi
    next=$((next + 1))
    printf '%s OI-%02d\n' "$p" "$next" >>"$map"
    assigned+="OI-Assigned: $p OI-$(printf %02d "$next")"$'\n'
done
[ -s "$map" ] || exit 0

# The files the branch changed (not deleted), and only text.
changed=()
while IFS= read -r -d '' f; do
    if [ -f "$f" ] && grep -Iq . "$f"; then changed+=("$f"); fi
done < <(git diff --name-only --no-renames --diff-filter=AM -z "$base" HEAD)
[ "${#changed[@]}" -gt 0 ] || exit 0

MAP="$map" perl -i -pe '
    BEGIN { open my $m, "<", $ENV{MAP} or die; %m = map { split } <$m>; }
    s/(?<![A-Za-z0-9])(OI-NEW-[a-z0-9]+(?:-[a-z0-9]+)*|OI-[0-9]+)/exists $m{$1} ? $m{$1} : $1/ge;
' -- "${changed[@]}"
[ -n "$(git status --porcelain)" ] || exit 0
git add -- "${changed[@]}"
summary="$(awk '{ printf "%s%s as %s", sep, $1, $2; sep = ", " }' "$map")"
git commit -q -m "chore(oi): Number open issues $summary" ${assigned:+-m "${assigned%$'\n'}"}
echo "assign-oi-ids: $summary"
