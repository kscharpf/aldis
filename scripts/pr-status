#!/usr/bin/env bash
# Is a pull request ready to merge? Read-only: it posts nothing.
#
# Usage: scripts/pr-status [--train] <pr-number>...   (flags in any position)
#
# Verdicts. Default: the merge gate's verdict, `READY` or `NOT READY: <reasons>`, for a PR that
# merges alone and for a train PR (head branch `train/*`). With --train: the verdict of a
# constituent of a merge train (docs/process/coordinator.md, Merge trains), `READY FOR TRAIN` or
# `NOT READY: <reasons>`. A constituent needs no verify record of its own and no merge of
# origin/<base>, since the train PR is verified once; its review is the only per-PR gate, so
# `READY FOR TRAIN` needs: open, not a draft, no changes requested, at least one submitted review,
# a later reply ending in the marker (below) that names the current head (`headRefOid`, a hex
# prefix of at least 7 characters anywhere in the reply, so a push after the reply is caught), no
# force-push of the head branch after the reply (`head_ref_force_pushed` in the issue timeline),
# and no label `needs-maintainer` (a PR that waits on a maintainer decision stays out of trains),
# and a head that merges into origin/main (`git merge-tree`, no worktree): otherwise `conflicts with
# origin/main: <paths>`. A conflict only in a Cargo.lock does not count, since scripts/train
# regenerates it. `scripts/train --plan` checks the order of a whole train.
#
# Per PR: state, head, commits behind origin/<base>, the required status contexts of branch
# protection with their state on the head, the other checks (not required), the newest
# verify.yml run on the head branch, whether a record is published for the head, the latest
# review in full, the PR comments, and one verdict line: `READY`, `READY FOR TRAIN` (with --train),
# or `NOT READY: <reasons>`.
# READY means: open, not a draft, the head contains the tip of origin/<base> (otherwise `behind
# origin/<base> by <n>`), no changes requested and no review outstanding, the review to answer
# has a reply, and every required context is success on the head.
# A reply: a PR comment (`gh pr comment`) posted after the newest submitted review whose last
# non-empty line is the marker `🤖 Generated with [Claude Code](https://claude.com/claude-code)`
# (AGENTS.md, `MARKER` in xtask/src/metrics/pr.rs). Every review needs one, also a review without
# findings and a review that itself ends in the marker; a later review is not a reply. Reviews
# not yet submitted and inline comments do not count.
# Exit status: 0 once every verdict is printed; 2 on a usage error or when gh fails.
set -euo pipefail

marker='🤖 Generated with [Claude Code](https://claude.com/claude-code)'

train=0
nums=()
for a in "$@"; do
    case "$a" in
    --train) train=1 ;;
    -*) nums=() && break ;;
    *) nums+=("$a") ;;
    esac
done
set -- ${nums[@]+"${nums[@]}"}

if [ $# -eq 0 ]; then
    awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
    exit 2
fi

export NO_COLOR=1 GH_FORCE_TTY=0 GH_NO_UPDATE_NOTIFIER=1

main_checkout="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
g() { git -C "$main_checkout" "$@"; }

g fetch --quiet origin
if g ls-remote --exit-code origin refs/notes/verify >/dev/null 2>&1; then
    g fetch --quiet origin '+refs/notes/verify:refs/notes/verify-origin'
fi

# conflicted_paths <a> <b>: the paths where merging b into a conflicts, one per line (none when
# it merges cleanly), from `git merge-tree`: no worktree, nothing written but objects.
conflicted_paths() {
    local out
    out="$(g merge-tree --write-tree --name-only --no-messages "$1" "$2" 2>/dev/null)" || true
    printf '%s\n' "$out" | sed '1d' | grep . || true
}

status_one() {
    local paths n="$1" info state draft head branch base decision behind checks required ctx s
    local labels reply_at reply_body force_at reviews_n
    local run run_id run_status run_conclusion run_sha record reasons="" inline unanswered of
    info="$(gh pr view "$n" --json state,isDraft,headRefOid,headRefName,baseRefName,reviewDecision \
        --jq '[.state, (.isDraft|tostring), .headRefOid, .headRefName, .baseRefName,
               (if (.reviewDecision // "") == "" then "none" else .reviewDecision end)]
              | @tsv')" \
        || { echo "#$n: gh could not read the pull request" >&2; return 1; }
    IFS=$'\t' read -r state draft head branch base decision <<<"$info"

    if g cat-file -e "$head^{commit}" 2>/dev/null; then
        behind="$(g rev-list --count "$head..origin/$base")"
    else
        behind="?"
    fi

    checks="$(gh pr view "$n" --json statusCheckRollup --jq '.statusCheckRollup[]
        | [(.context // .name),
           ((if (.state // "") != "" then .state
             elif (.conclusion // "") != "" then .conclusion
             else (.status // "unknown") end) | ascii_upcase)] | @tsv')"
    required="$(gh api "repos/{owner}/{repo}/branches/$base/protection" \
        --jq '[(.required_status_checks.contexts // [])[],
               ((.required_status_checks.checks // [])[] | .context)] | unique | .[]' \
        2>/dev/null)" || required="?"

    state_of() { printf '%s\n' "$checks" | awk -F'\t' -v c="$1" '$1 == c { print $2; exit }'; }

    run="$(gh run list --workflow verify.yml --branch "$branch" -L 1 \
        --json databaseId,status,conclusion,headSha \
        --jq '.[0] // empty | [.databaseId, .status,
              ((.conclusion // "") | if . == "" then "-" else . end), .headSha] | @tsv')"
    run_id="" run_status="" run_conclusion="" run_sha=""
    if [ -n "$run" ]; then
        IFS=$'\t' read -r run_id run_status run_conclusion run_sha <<<"$run"
    fi
    if g notes --ref=refs/notes/verify-origin show "$head" >/dev/null 2>&1; then
        record=yes
    else
        record=no
    fi
    inline="$(gh api "repos/{owner}/{repo}/pulls/$n/comments" --jq 'length' 2>/dev/null ||
        echo "?")"

    echo "== #$n $state$([ "$draft" = true ] && echo ' (draft)') ${head:0:7} -> $base," \
        "$behind commit(s) behind origin/$base"
    echo "required contexts:"
    if [ "$required" = "?" ]; then
        echo "  (unreadable: branch protection of $base)"
    elif [ -z "$required" ]; then
        echo "  (none)"
    else
        while IFS= read -r ctx; do
            s="$(state_of "$ctx")"
            echo "  $ctx: ${s:-missing}"
        done <<<"$required"
    fi
    echo "other checks (not required):"
    while IFS=$'\t' read -r ctx s; do
        [ -n "$ctx" ] || continue
        if ! printf '%s\n' "$required" | grep -Fxq -- "$ctx"; then
            echo "  $ctx: $s"
        fi
    done <<<"$checks"
    if [ -n "$run_id" ]; then
        if [ "$run_sha" = "$head" ]; then of="the PR head"; else of="NOT the PR head"; fi
        echo "newest verify run: $run_id $run_status/$run_conclusion on ${run_sha:0:7} ($of)"
    else
        echo "newest verify run: none"
    fi
    echo "published record for the head: $record"
    echo "review decision: $decision; inline review comments: $inline"
    echo "latest review:"
    gh pr view "$n" --json reviews --jq '.reviews | if length == 0 then "  (none)"
        else .[-1] | "  \(.author.login) \(.state) \(.submittedAt)\n\(.body)" end'
    # The newest submitted review, unless a later PR comment ends with the marker line. A later
    # review is not a reply.
    # shellcheck disable=SC2016  # $r is a jq variable
    reply_filter='
        ([.reviews[] | select(.submittedAt != null)] | max_by(.submittedAt)) as $r
        | if $r == null then empty
          elif any(.comments[];
                   .createdAt > $r.submittedAt
                   and ((.body // "") | gsub("\\s+$"; "") | split("\n") | last) == "@MARKER@")
          then empty
          else "\($r.author.login) \($r.state) \($r.submittedAt)" end'
    unanswered="$(gh pr view "$n" --json reviews,comments --jq "${reply_filter//@MARKER@/$marker}")"
    # The newest reply that ends with the marker and follows the newest submitted review: its time
    # and its text.
    # shellcheck disable=SC2016  # $r is a jq variable
    reply_filter_new='
        ([.reviews[] | select(.submittedAt != null)] | max_by(.submittedAt)) as $r
        | if $r == null then empty
          else [.comments[]
                | select(.createdAt > $r.submittedAt
                    and ((.body // "") | gsub("\\s+$"; "") | split("\n") | last) == "@MARKER@")]
               | max_by(.createdAt) // empty | @MODE@ end'
    reply_filter_new="${reply_filter_new//@MARKER@/$marker}"
    reply_at="$(gh pr view "$n" --json reviews,comments \
        --jq "${reply_filter_new//@MODE@/.createdAt}")"
    reply_body="$(gh pr view "$n" --json reviews,comments \
        --jq "${reply_filter_new//@MODE@/.body}")"
    reviews_n="$(gh pr view "$n" --json reviews --jq '[.reviews[] | select(.submittedAt != null)]
        | length')"
    labels="$(gh pr view "$n" --json labels --jq '[.labels[].name] | join(",")')"
    # The latest force-push of the head branch (server time), unreadable: "?".
    if [ "$train" -eq 1 ]; then
        force_at="$(gh api "repos/{owner}/{repo}/issues/$n/timeline" --paginate \
            --jq '.[] | select(.event == "head_ref_force_pushed") | .created_at' 2>/dev/null |
            sort | tail -n 1)" || force_at="?"
    fi
    echo "comments:"
    gh pr view "$n" --json comments --jq 'if (.comments | length) == 0 then "  (none)"
        else .comments[]
          | "  \(.author.login) \(.createdAt): \(.body[0:300] | gsub("\n"; " "))" end'

    [ "$state" = OPEN ] || reasons="$reasons; PR is $state"
    [ "$draft" != true ] || reasons="$reasons; draft"
    if [ "$state" != OPEN ] || [ "$train" -eq 1 ]; then
        :
    elif [ "$behind" = "?" ]; then
        reasons="$reasons; head not fetched, cannot tell whether it contains origin/$base"
    elif [ "$behind" -gt 0 ]; then
        reasons="$reasons; behind origin/$base by $behind"
    fi
    [ -z "$unanswered" ] ||
        reasons="$reasons; review unanswered ($unanswered): no later reply ends in the marker"
    [ "$decision" != CHANGES_REQUESTED ] || reasons="$reasons; changes requested"
    [ "$decision" != REVIEW_REQUIRED ] || reasons="$reasons; review required"
    if [ "$train" -eq 1 ]; then
        # The review is the only per-PR gate of a constituent: it must exist, be answered, and
        # still describe the head (the reply names it, no force-push after it); and a decision
        # of the maintainer must not be pending.
        [ "$reviews_n" -gt 0 ] || reasons="$reasons; no review"
        if [ -n "$reply_at" ] && ! grep -Fqi -- "${head:0:7}" <<<"$reply_body"; then
            reasons="$reasons; the reply does not name the head ${head:0:7}"
        fi
        if [ "$force_at" = "?" ]; then
            reasons="$reasons; the timeline of the PR is unreadable"
        elif [ -n "$force_at" ] && [ -n "$reply_at" ] && [[ $force_at > $reply_at ]]; then
            reasons="$reasons; head branch force-pushed ($force_at) after the reply ($reply_at)"
        fi
        case ",$labels," in
        *,needs-maintainer,*) reasons="$reasons; label needs-maintainer (waits on a decision)" ;;
        esac
        if [ "$state" = OPEN ] && [ "$behind" != "?" ]; then
            paths="$(conflicted_paths "origin/main" "$head")" || paths=""
            paths="$(printf '%s\n' "$paths" |
                grep -Ev '^((refapp|exerciser|fuzz|crosscheck)/)?Cargo\.lock$' | grep . |
                paste -sd ' ' -)" || paths=""
            [ -z "$paths" ] || reasons="$reasons; conflicts with origin/main: $paths"
        fi
    elif [ "$required" = "?" ]; then
        reasons="$reasons; required contexts unreadable"
    elif [ -n "$required" ]; then
        while IFS= read -r ctx; do
            s="$(state_of "$ctx")"
            if [ -z "$s" ]; then
                reasons="$reasons; $ctx missing"
                if [ "$run_sha" = "$head" ] &&
                    { [ "$run_status" = in_progress ] || [ "$run_status" = queued ]; }; then
                    reasons="$reasons (run $run_id $run_status)"
                fi
            elif [ "$s" != SUCCESS ]; then
                reasons="$reasons; $ctx $s"
            fi
        done <<<"$required"
    fi
    if [ -z "$reasons" ] && [ "$train" -eq 1 ]; then
        echo "#$n: READY FOR TRAIN"
    elif [ -z "$reasons" ]; then
        echo "#$n: READY"
    else
        echo "#$n: NOT READY:${reasons#;}"
    fi
}

failed=0
for n in "$@"; do
    status_one "$n" || failed=1
    echo
done
[ "$failed" -eq 0 ] || exit 2
