#!/usr/bin/env bash
# Test scripts/train without a network and without the real gh: a scratch bare origin, a clone,
# and a stub `gh` that answers from files.
#
# Usage: scripts/test-train
# Cases: a train of two PRs merges both in order with `Merge pull request #N from owner/branch`
# merge commits whose body is the PR title, pushes `train/<date>-1`, and opens a PR titled
# `chore(train): ...` whose body lists both; a conflict between two PRs names the later one and
# pushes nothing; a closed PR, a draft, and a train PR cannot ride; --dry-run pushes nothing
# and leaves no branch or worktree, so that a real run with the same PRs follows it;
# a further train of the day takes the next number; --rebuild --without drops a PR, opens the
# new train, and closes the old one; another open train PR refuses a real build (but not
# --dry-run, or the --rebuild of that PR while it is open, but a second open train PR still
# refuses a --rebuild) unless --allow-open-train is given; --plan (a preflight with no worktree
# and no push) says clean for PRs that merge, names the paths of a conflict with origin/main,
# the first PR that conflicts with the ones before it and the pairwise matrix, and exits 1; a
# build whose only conflict is Cargo.lock (root and a workspace) regenerates it with a stub
# `cargo` and commits the merge, a lockfile left stale by clean merges is reported by --plan and
# regenerated in a commit on the train branch, while a lockfile conflict next to another conflict
# is refused.
# Exit status: 0 when every case holds, 1 otherwise.
set -uo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
script="$here/train"
work="$(mktemp -d "${TMPDIR:-/tmp}/train-test.XXXXXX")"
trap 'rm -rf "$work"' EXIT
repo="$work/repo"
today="$(date -u +%Y-%m-%d)"

git init -q --bare "$work/origin.git"
git -C "$work/origin.git" symbolic-ref HEAD refs/heads/main
git clone -q "$work/origin.git" "$repo" 2>/dev/null
git -C "$repo" symbolic-ref HEAD refs/heads/main
git -C "$repo" config user.email test@example.com
git -C "$repo" config user.name test
echo base >"$repo/shared"
pkg() { printf '[[package]]\nname = "%s"\nversion = "%s"\n' "$1" "$2"; }
pkg x 1.0 >"$repo/Cargo.lock"
mkdir "$repo/refapp"
echo base >"$repo/refapp/Cargo.lock"
git -C "$repo" add shared Cargo.lock refapp
git -C "$repo" commit -q -m base
git -C "$repo" push -q -u origin main

branch() { # branch <name> <file> <content>: a branch off main with one commit
    git -C "$repo" checkout -q -b "$1" main
    echo "$3" >"$repo/$2"
    git -C "$repo" add "$2"
    git -C "$repo" commit -q -m "$1"
    git -C "$repo" push -q origin "$1"
    git -C "$repo" checkout -q main
}
branch a fa 1
branch b fb 1
branch c shared "changed by c"
branch d shared "changed by d"

mkdir "$work/bin" "$work/stub"
# A stub cargo: `metadata` appends a line to the Cargo.lock of the current directory; with
# --locked it fails while the lockfile still has conflict markers.
cat >"$work/bin/cargo" <<'STUB'
#!/usr/bin/env bash
echo "cargo $* in $(basename "$PWD")" >>"$STUB/cargo-calls"
[ "$1" = metadata ] || exit 1
if [[ " $* " == *" --locked "* ]]; then ! grep -q '^<<<<<<<\|^stale' Cargo.lock; else
    sed -i.bak '/^stale/d; s/^version = "0.9"/version = "1.0"/' Cargo.lock && rm -f Cargo.lock.bak
    echo regenerated >>Cargo.lock
fi
STUB
chmod +x "$work/bin/cargo"
cat >"$work/bin/gh" <<'STUB'
#!/usr/bin/env bash
echo "$*" >>"$STUB/calls"
filter=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
    [ "${args[i]}" = --jq ] && filter="${args[i + 1]}"
    [ "${args[i]}" = --body ] && printf '%s' "${args[i + 1]}" >"$STUB/created-body"
    [ "${args[i]}" = --title ] && printf '%s' "${args[i + 1]}" >"$STUB/created-title"
    [ "${args[i]}" = --comment ] && printf '%s' "${args[i + 1]}" >"$STUB/close-comment"
done
case "$1 $2" in
"pr view") jq -r "$filter" "$STUB/pr-$3.json" ;;
"pr list") # --state open lists only the open PRs, as gh does (the stub reads the "state"
    # field of its data)
    case " $* " in
    *" --state open "*) jq -c '[.[] | select(.state == "OPEN")]' "$STUB/all-prs.json" ;;
    *) cat "$STUB/all-prs.json" ;;
    esac | jq -r "$filter" ;;
"pr create")
    [ ! -e "$STUB/create-fails" ] || exit 1
    echo "https://github.test/o/r/pull/99"
    ;;
"pr close") ;;
"repo view") echo '{"url":"https://github.test/o/r"}' | jq -r "$filter" ;;
"api "*)
    case "$2" in
    */protection) echo '{}' | jq -r "$filter" ;;
    */timeline) echo '[]' | jq -r "$filter" ;;
    *) echo '[]' ;;
    esac
    ;;
"run list") ;;
*) exit 1 ;;
esac
STUB
chmod +x "$work/bin/gh"
export STUB="$work/stub"
echo '[]' >"$STUB/all-prs.json"
marker='🤖 Generated with [Claude Code](https://claude.com/claude-code)'

# pr <n> <branch> <title> [state] [draft] [labels] [reviewed: 1|0] [committed]: the JSON that
# gh prints for the PR, with the head of origin/<branch>, a review of 2026-01-02 and, when
# reviewed, a reply of 2026-01-03 that ends with the marker.
pr() {
    local sha reviews comments
    sha="$(git -C "$repo" rev-parse "origin/$2")"
    reviews='[]'
    comments='[]'
    if [ "${7:-1}" = 1 ]; then
        reviews='[{"author":{"login":"rev"},"state":"COMMENTED","body":"ok",
                   "submittedAt":"2026-01-02T00:00:00Z"}]'
        comments="$(jq -nc --arg m "$marker" '[{author: {login: "me"},
            createdAt: "2026-01-03T00:00:00Z",
            body: ("Fix round, head " + ($sha | .[0:9]) + ".\n\n" + $m)}]' --arg sha "$sha")"
    fi
    jq -nc --arg b "$2" --arg t "$3" --arg s "${4:-OPEN}" --argjson d "${5:-false}" \
        --arg sha "$sha" --arg base "${BASE:-main}" --arg labels "${6:-}" \
        --argjson reviews "$reviews" \
        --argjson comments "$comments" '{
        state: $s, isDraft: $d, headRefName: $b, headRepositoryOwner: {login: "o"},
        baseRefName: $base,
        headRefOid: $sha, reviewDecision: "", title: $t, body: "",
        statusCheckRollup: [], reviews: $reviews, comments: $comments,
        labels: ($labels | split(",") | map(select(. != "") | {name: .})),
        }' >"$STUB/pr-$1.json"
}
lbranch() { # lbranch <name> <file> <content>...: one commit editing several files
    local name="$1"
    shift
    git -C "$repo" checkout -q -b "$name" main
    while [ $# -gt 0 ]; do
        echo "$2" >"$repo/$1"
        git -C "$repo" add "$1"
        shift 2
    done
    git -C "$repo" commit -q -m "$name"
    git -C "$repo" push -q origin "$name"
    git -C "$repo" checkout -q main
}
lbranch k1 Cargo.lock one refapp/Cargo.lock one
lbranch k2 Cargo.lock two refapp/Cargo.lock two
lbranch k3 Cargo.lock three refapp/Cargo.lock three
lbranch s1 Cargo.lock "stale
$(pkg x 0.9)"
lbranch v1 Cargo.lock "$(pkg x 1.1)
# v1"
lbranch v2 Cargo.lock "$(pkg x 1.2)
# v2"
lbranch v3 Cargo.lock "$(pkg x 1.1)
# v3"
lbranch s2 fs2 x
lbranch m1 Cargo.lock one shared m1
lbranch m2 Cargo.lock two shared m2
branch train/x ftx 1
branch e fe 1
branch f ff 1
pr 11 a "feat(m1/wp-1): add a"
pr 12 b "fix(spp): fix b"
pr 13 c "feat: change c"
pr 14 d "feat: change d"
pr 15 a "feat: closed" CLOSED
pr 16 a "feat: draft" OPEN true
pr 17 train/x "chore(train): other"
pr 18 e "feat: unreviewed" OPEN false "" 0
pr 19 f "feat: waits" OPEN false "needs-maintainer"
pr 20 f "feat: reply names no current head" OPEN false "" 1
pr 31 k1 "feat: lock one"
pr 32 k2 "feat: lock two"
pr 33 k3 "feat: lock three"
pr 41 v1 "feat: bump x to 1.1"
pr 42 v2 "feat: bump x to 1.2"
pr 43 v3 "feat: bump x to 1.1 too"
pr 36 s1 "feat: manifest change without its lock"
pr 37 s2 "feat: other file"
pr 34 m1 "feat: lock and shared one"
pr 35 m2 "feat: lock and shared two"
branch g fg 1
BASE=a pr 21 g "feat: stacked on a"

failures=0
run() { (cd "$repo" && : >"$STUB/cargo-calls" && PATH="$work/bin:$PATH" "$script" "$@" 2>&1); }
check() { # check <case> <condition exit status>
    if [ "$2" -eq 0 ]; then echo "ok: $1"; else echo "FAIL: $1"; failures=$((failures + 1)); fi
}
remote_has() { git -C "$work/origin.git" rev-parse -q --verify "refs/heads/$1" >/dev/null; }
t() { "$@"; }
contains() { grep -Fq -- "$2" <<<"$1"; }

: >"$STUB/calls"
out="$(run 11 12)"
status=$?
check "a train of two PRs builds" "$status"
remote_has "train/$today-1"
check "pushes train/<date>-1" $?
log="$(git -C "$work/origin.git" log --first-parent --format='%s|%b' "train/$today-1")"
contains "$log" "Merge pull request #12 from o/b|fix(spp): fix b"
check "merge commit of #12 carries the title" $?
contains "$log" "Merge pull request #11 from o/a|feat(m1/wp-1): add a"
check "merge commit of #11 carries the title" $?
t [ "$(git -C "$work/origin.git" log --first-parent --format=%s -n 2 "train/$today-1" |
    sed -n '2p')" = "Merge pull request #11 from o/a" ]
check "merged in the order given" $?
t [ "$(cat "$STUB/created-title")" = "chore(train): $today-1, #11, #12" ]
check "the train PR is chore(train)" $?
body="$(cat "$STUB/created-body")"
contains "$body" "- #11 [feat(m1/wp-1): add a](https://github.test/o/r/pull/11)" &&
    contains "$body" "- #12 [fix(spp): fix b](https://github.test/o/r/pull/12)" &&
    contains "$body" "## Merge Danger" &&
    contains "$body" "🤖 Generated with [Claude Code](https://claude.com/claude-code)"
check "the body lists the PRs and has the three sections" $?
contains "$out" "https://github.test/o/r/pull/99"
check "prints the PR URL" $?
t [ ! -d "$repo/.claude/worktrees/train/$today-1" ]
check "removes its worktree" $?

out="$(run 11 13 14)"
status=$?
t [ "$status" -eq 1 ]
check "a conflict exits 1" $?
contains "$out" "#14 conflicts"
check "names the later PR of the conflict" $?
! remote_has "train/$today-2"
check "pushes nothing on a conflict" $?
t [ -z "$(git -C "$repo" branch --list "train/$today-2")" ]
check "leaves no local train branch" $?

for n in 15 16 17 18 19; do
    out="$(run 11 "$n")"
    [ $? -eq 1 ] && contains "$out" "#$n"
    check "#$n cannot ride" $?
done

out="$(run 18)"
contains "$out" "no review"
check "an unreviewed PR is refused with its reason" $?
out="$(run 19)"
contains "$out" "needs-maintainer"
check "a PR that waits on the maintainer is refused with its reason" $?
git -C "$repo" checkout -q f
echo more >"$repo/more"
git -C "$repo" add more
git -C "$repo" commit -q -m more
git -C "$repo" push -q origin f
git -C "$repo" checkout -q main
git -C "$repo" fetch -q origin
pr 20 f "feat: pushed after the reply" OPEN false "" 1
sed -i.bak 's/head [0-9a-f]\{9\}/head 000000000/' "$STUB/pr-20.json"
out="$(run 20)"
contains "$out" "does not name the head"
check "a PR whose reply does not name the head is refused" $?
out="$(run 21 11)"
contains "$out" "#21 is stacked on a"
check "a stacked PR before its base PR is refused" $?
out="$(run --dry-run 21)"
contains "$out" "#21 is stacked on a"
check "a stacked PR without its base PR is refused" $?
out="$(run --dry-run 11 21)"
contains "$out" "dry run"
check "a stacked PR after its base PR rides the train" $?

# The train merges the SHA that was checked: a push after the check is not merged.
pr 11 a "feat(m1/wp-1): add a"
git -C "$repo" checkout -q a
echo late >"$repo/late"
git -C "$repo" add late
git -C "$repo" commit -q -m late
git -C "$repo" push -q origin a
git -C "$repo" checkout -q main
out="$(run 11)"
status=$?
{ [ "$status" -eq 1 ] && contains "$out" "is not at the checked head"; }
check "a push between the check and the merge refuses the PR" $?
pr 11 a "feat(m1/wp-1): add a"

out="$(run --dry-run 11 12)"
status=$?
{ [ "$status" -eq 0 ] && contains "$out" "dry run" && ! remote_has "train/$today-2"; }
check "--dry-run pushes nothing" $?
t [ ! -d "$repo/.claude/worktrees/train/$today-2" ] &&
    t [ -z "$(git -C "$repo" branch --list "train/$today-2")" ]
check "--dry-run leaves no branch or worktree" $?

out="$(run 11 12)"
status=$?
{ [ "$status" -eq 0 ] && remote_has "train/$today-2" && contains "$out" "train $today-2"; }
check "a real run after a dry run with the same PRs succeeds" $?
out="$(run 12)"
remote_has "train/$today-3"
check "a further train of the day takes the next number" $?
git -C "$repo" branch -D "train/$today-3" >/dev/null 2>&1
git -C "$work/origin.git" branch -D "train/$today-1" "train/$today-2" "train/$today-3" >/dev/null
echo "[{\"headRefName\":\"train/$today-1\"},{\"headRefName\":\"train/$today-2\"}]" \
    >"$STUB/all-prs.json"
out="$(run 12)"
remote_has "train/$today-3"
check "numbers count train PRs of any state, not live branches" $?
git -C "$work/origin.git" branch -D "train/$today-3" >/dev/null
echo '[]' >"$STUB/all-prs.json"
git -C "$repo" branch -D "train/$today-1" "train/$today-2" "train/$today-3" >/dev/null 2>&1

touch "$STUB/create-fails"
out="$(run 12)"
status=$?
rm "$STUB/create-fails"
{ [ "$status" -eq 2 ] && ! remote_has "train/$today-1"; }
check "a failing gh pr create exits 2 and deletes the pushed branch" $?
t [ ! -d "$repo/.claude/worktrees/train/$today-1" ]
check "it leaves no worktree" $?
git -C "$repo" branch -D "train/$today-1" >/dev/null 2>&1
out="$(run 11 12)"

pr 99 "train/$today-1" "chore(train): $today-1, #11, #12"
jq -c --arg b "$(cat "$STUB/created-body")" '.body = $b' "$STUB/pr-99.json" >"$STUB/t" &&
    mv "$STUB/t" "$STUB/pr-99.json"
: >"$STUB/calls"
out="$(run --rebuild 99 --without 11)"
status=$?
{ [ "$status" -eq 0 ] && remote_has "train/$today-2"; }
check "--rebuild builds a new train" $?
git -C "$work/origin.git" log --first-parent --format=%s "train/$today-2" | grep -Fq "#12" &&
    ! git -C "$work/origin.git" log --first-parent --format=%s "train/$today-2" | grep -Fq "#11"
check "--rebuild leaves the dropped PR out" $?
grep -Fq "pr close 99" "$STUB/calls" && contains "$(cat "$STUB/close-comment")" "without #11"
check "--rebuild closes the old train PR" $?

echo '[{"number":50,"headRefName":"train/other","state":"OPEN"}]' >"$STUB/all-prs.json"
out="$(run 12)"
status=$?
{ [ "$status" -eq 1 ] && contains "$out" "#50 is open" && ! remote_has "train/$today-3"; }
check "another open train PR refuses a build" $?
out="$(run --dry-run 12)"
status=$?
check "--dry-run is not refused by an open train PR" "$status"
out="$(run --allow-open-train 12)"
status=$?
{ [ "$status" -eq 0 ] && remote_has "train/$today-3"; }
check "--allow-open-train builds despite an open train PR" $?
echo '[{"number":99,"headRefName":"train/rebuilt","state":"OPEN"}]' >"$STUB/all-prs.json"
: >"$STUB/calls"
out="$(run --rebuild 99 --without 11)"
status=$?
{ [ "$status" -eq 0 ] && grep -Fq "pr close 99" "$STUB/calls"; }
check "--rebuild of the open train is allowed while that train is open" $?
echo '[{"number":99,"headRefName":"train/rebuilt","state":"OPEN"},
       {"number":50,"headRefName":"train/other","state":"OPEN"}]' >"$STUB/all-prs.json"
: >"$STUB/calls"
out="$(run --rebuild 99 --without 11)"
status=$?
{ [ "$status" -eq 1 ] && contains "$out" "#50 is open" && ! grep -Fq "pr close 99" "$STUB/calls"; }
check "--rebuild of a train is refused while a second train PR is open" $?
out="$(run --rebuild 99 --without 11 --allow-open-train)"
status=$?
{ [ "$status" -eq 0 ] && grep -Fq "pr close 99" "$STUB/calls"; }
check "--rebuild with a second train PR open is allowed with --allow-open-train" $?
echo '[]' >"$STUB/all-prs.json"

# --plan: no worktree, no push, no branch.
before="$(git -C "$work/origin.git" for-each-ref | wc -l)"
: >"$STUB/calls"
out="$(run --plan 11 12)"
status=$?
{ [ "$status" -eq 0 ] && contains "$out" "plan: no conflict" &&
    contains "$out" "#11" && contains "$out" "cumulative"; }
check "--plan of PRs that merge is clean and exits 0" $?
t [ "$(git -C "$work/origin.git" for-each-ref | wc -l)" -eq "$before" ] &&
    t [ "$(git -C "$repo" worktree list | wc -l)" -eq 1 ] && ! grep -Fq "pr create" "$STUB/calls"
check "--plan pushes nothing and opens nothing" $?
out="$(run --plan 11 13)"
status=$?
{ [ "$status" -eq 0 ] && contains "$out" "plan: no conflict"; }
check "--plan of two PRs that touch other files is clean" $?
git -C "$repo" fetch -q origin
mainfile() { # a commit on main that conflicts with c
    git -C "$repo" checkout -q main
    echo "main edit" >"$repo/shared"
    git -C "$repo" commit -q -am "main moves shared"
    git -C "$repo" push -q origin main
}
mainfile
out="$(run --plan 11 13)"
status=$?
{ [ "$status" -eq 1 ] && grep -Eq '^  #13 [0-9a-f]+: conflict \(shared\)' <<<"$out"; }
check "--plan names the paths of a conflict with origin/main" $?
out="$(run --plan 11 12 14 13)"
status=$?
{ [ "$status" -eq 1 ] &&
    contains "$out" "#14: conflicts with origin/main (shared)"; }
check "--plan names a PR that conflicts with origin/main in the cumulative merge" $?
git -C "$repo" reset -q --hard origin/main~1
git -C "$repo" push -q -f origin main
out="$(run --plan 11 13 14)"
status=$?
{ [ "$status" -eq 1 ] &&
    contains "$out" "#14: conflicts with #13 (shared)" &&
    contains "$out" "#13 x #14: shared" && ! contains "$out" "#11 x"; }
check "--plan names the first PR that conflicts with an earlier one and the pair" $?
out="$(run --plan 31 32)"
status=$?
{ [ "$status" -eq 0 ] && contains "$out" "lock"; }
check "--plan treats a lockfile-only conflict as no conflict" $?
out="$(run --plan 34 35)"
status=$?
{ [ "$status" -eq 1 ] && contains "$out" "#34 x #35: Cargo.lock shared"; }
check "--plan reports a lockfile conflict next to another one" $?
run --plan >/dev/null
t [ $? -eq 2 ]
check "--plan without a PR is a usage error" $?

# A lockfile-only conflict: the build regenerates it and commits the merge.
out="$(run 31 32)"
status=$?
tb="train/$(sed -n 's/^train \([^:]*\):.*/\1/p' <<<"$out")"
{ [ "$status" -eq 0 ] && contains "$out" "#32: Cargo.lock regenerated" &&
    contains "$out" "#32: refapp/Cargo.lock regenerated"; }
check "a lockfile-only conflict is regenerated and the build succeeds" $?
t [ "$(git -C "$work/origin.git" show "$tb:Cargo.lock" | tail -n 1)" = regenerated ] &&
    t [ "$(git -C "$work/origin.git" show "$tb:Cargo.lock" | head -n 1)" = one ]
check "it kept the side of the train and regenerated" $?
grep -Fq "metadata --offline --locked --format-version 1 in refapp" "$STUB/cargo-calls" &&
    grep -Fq "metadata --offline --format-version 1 in ${tb#train/}" "$STUB/cargo-calls"
check "it ran cargo in the workspace of each lockfile" $?
t [ "$(git -C "$work/origin.git" log --first-parent --format=%s -n 1 "$tb")" = \
    "Merge pull request #32 from o/k2" ]
check "the merge commit is the usual one" $?
tbranches="$(git -C "$repo" branch --list "train/*")"
out="$(run 34 35)"
status=$?
{ [ "$status" -eq 1 ] && contains "$out" "#35 conflicts" && ! contains "$out" "regenerated"; }
check "a lockfile conflict next to another conflict is refused" $?
t [ "$(git -C "$repo" branch --list "train/*")" = "$tbranches" ]
check "the refused build leaves no branch" $?

# A deliberate lockfile bump that the regeneration would lose is a conflict, in --plan and in
# the build; the same bump on both sides is not.
out="$(run --plan 41 42)"
status=$?
{ [ "$status" -eq 1 ] && contains "$out" "version bump lost (x@1.2)"; }
check "--plan reports a lockfile version bump that would be lost" $?
out="$(run --plan 41 43)"
status=$?
{ [ "$status" -eq 0 ] && contains "$out" "lock"; }
check "--plan accepts the same bump on both sides" $?
tbranches="$(git -C "$repo" branch --list "train/*")"
out="$(run 41 42)"
status=$?
{ [ "$status" -eq 1 ] && contains "$out" "#42: Cargo.lock: versions the PR locked are not" &&
    contains "$out" "(x@1.2)" && contains "$out" "#42 conflicts"; }
check "the build refuses a PR whose lockfile bump the regeneration would lose" $?
t [ "$(git -C "$repo" branch --list "train/*")" = "$tbranches" ] &&
    t [ "$(git -C "$repo" worktree list | wc -l)" -eq 1 ]
check "it leaves no branch or worktree" $?
out="$(run 41 43)"
status=$?
{ [ "$status" -eq 0 ] && contains "$out" "#43: Cargo.lock regenerated"; }
check "the build accepts the same bump on both sides" $?

# A merged result whose lockfile is stale, though nothing conflicted.
out="$(run --plan 36 37)"
status=$?
{ [ "$status" -eq 0 ] && contains "$out" "lockfile needs regenerating: Cargo.lock" &&
    contains "$out" "not in the new one: x@0.9"; }
check "--plan reports a stale lockfile of the merged result" $?
out="$(run --plan 31)"
! contains "$out" "needs regenerating"
check "--plan of PRs with fresh lockfiles reports none" $?
out="$(run 36 37)"
status=$?
tb="train/$(sed -n 's/^train \([^:]*\):.*/\1/p' <<<"$out")"
{ [ "$status" -eq 0 ] && contains "$out" "Cargo.lock was stale after the merges" &&
    contains "$out" "not in the new one: x@0.9"; }
check "the build regenerates a stale lockfile" $?
t [ "$(git -C "$work/origin.git" log --format=%s -n 1 "$tb")" = \
    "chore(train): regenerate Cargo.lock for the merged manifests" ] &&
    t [ "$(git -C "$work/origin.git" show "$tb:Cargo.lock" | tail -n 1)" = regenerated ] &&
    ! git -C "$work/origin.git" show "$tb:Cargo.lock" | grep -q '^stale'
check "it commits the regenerated lock on the train branch" $?

run >/dev/null
t [ $? -eq 2 ]
check "no argument is a usage error" $?
run --without 11 >/dev/null
t [ $? -eq 2 ]
check "--without alone is a usage error" $?

t [ "$failures" -eq 0 ] || exit 1
echo "all cases hold"
