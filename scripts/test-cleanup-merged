#!/usr/bin/env bash
# Test scripts/cleanup-merged without a network and without the real gh: a scratch bare origin,
# a clone of it, and a stub `gh` that reports chosen branches as having a merged pull request.
#
# Usage: scripts/test-cleanup-merged
# Cases: a dry run changes nothing; a merged branch is cleaned (worktree, local branch, remote
# branch); the branch whose remote is already gone is cleaned; each of these is kept with its
# reason: a dirty worktree, commits after the merge, no merged pull request, the main checkout;
# a closed train whose non-merge commits are all on main is cleaned (worktree, local and remote
# branch), and is kept when a commit is not;
# a closed non-train PR whose head commit is on main is cleaned (also a stacked one, whose base is
# another branch), and is kept when its head is not on main, or when its local branch has a newer
# commit, or when only its remote branch has a commit main lacks (both refs kept, with the
# reason), and with its own reason when GitHub gives no head commit; a closed train is kept, both
# refs, when only the remote has a unique commit; the closed-PR filter
# drops merged PRs (a closed listing with a merged and an unmerged PR picks the unmerged one; one
# with only a merged PR is kept);
# a worktree locked by Claude Code (reason `claude agent agent-<id> (pid N)`, with or without
# ` start <time>`) is unlocked and
# removed when clean, and kept when dirty; a failed step (any other locked worktree) stops the
# branch and leaves its branches in place.
# the main checkout's main is fast-forwarded to origin/main after an --apply run, and left alone
# with a warning when it is not on main, has local changes, or has a local commit; a dry run leaves
# it alone.
# Exit status: 0 when every case holds, 1 otherwise.
set -uo pipefail

command -v jq >/dev/null || {
    echo "test-cleanup-merged: jq is required (the gh stub runs the --jq filters)" >&2
    exit 2
}

here="$(cd "$(dirname "$0")" && pwd)"
script="$here/cleanup-merged"
work="$(mktemp -d "${TMPDIR:-/tmp}/cleanup-merged-test.XXXXXX")"
trap 'rm -rf "$work"' EXIT
repo="$work/repo"

git init -q --bare "$work/origin.git"
git -C "$work/origin.git" symbolic-ref HEAD refs/heads/main
git clone -q "$work/origin.git" "$repo" 2>/dev/null
git -C "$repo" symbolic-ref HEAD refs/heads/main
git -C "$repo" config user.email test@example.com
git -C "$repo" config user.name test
echo init >"$repo/init.txt"
git -C "$repo" add init.txt
git -C "$repo" commit -q -m init
git -C "$repo" push -q -u origin main

branch() { # branch <name>: one commit on its own branch, pushed
    git -C "$repo" checkout -q -b "$1" main
    echo "$1" >"$repo/$1.txt"
    git -C "$repo" add "$1.txt"
    git -C "$repo" commit -q -m "$1"
    git -C "$repo" push -q -u origin "$1"
    git -C "$repo" checkout -q main
}
for b in merged-clean merged-dirty merged-after not-merged-pr merged-remote-gone merged-locked \
    merged-claude merged-claude-dirty merged-claude-nostart merged-foreign; do
    branch "$b"
    git -C "$repo" merge -q --no-ff "$b" -m "merge $b"
done
git -C "$repo" push -q origin main

# Closed trains: a train branch carries the constituents' commits and train merge commits. In
# train/closed-ok the constituent reached main by its own merge; train/closed-new has a commit main
# lacks. closed-other is a closed non-train PR with the same shape as closed-ok.
git -C "$repo" checkout -q -b train/closed-ok main
echo c1 >"$repo/c1.txt"; git -C "$repo" add c1.txt; git -C "$repo" commit -q -m c1
git -C "$repo" checkout -q main
git -C "$repo" merge -q --no-ff train/closed-ok -m "merge c1"
git -C "$repo" checkout -q -b train/closed-new main
echo c2 >"$repo/c2.txt"; git -C "$repo" add c2.txt; git -C "$repo" commit -q -m c2
git -C "$repo" checkout -q main
git -C "$repo" checkout -q -b closed-other main
echo c3 >"$repo/c3.txt"; git -C "$repo" add c3.txt; git -C "$repo" commit -q -m c3
git -C "$repo" checkout -q main
git -C "$repo" merge -q --no-ff closed-other -m "merge c3"
# A train merge commit (no conflict) on top of each train branch: not an ancestor of origin/main.
for b in train/closed-ok train/closed-new; do
    git -C "$repo" checkout -q "$b"
    git -C "$repo" merge -q --no-ff main -m "train merge"
    git -C "$repo" checkout -q main
    git -C "$repo" push -q origin "$b"
done
git -C "$repo" push -q origin closed-other
# Filter cases: no unique commits, differing only in what the stub's closed listing holds.
for b in train/closed-both train/closed-onlymerged; do
    git -C "$repo" push -q origin "main:refs/heads/$b"
    git -C "$repo" branch -q "$b" main
done
# train/closed-remote-new: the local tip is on main, origin has a commit main lacks.
git -C "$repo" checkout -q -b train/closed-remote-new main
echo c4 >"$repo/c4.txt"; git -C "$repo" add c4.txt; git -C "$repo" commit -q -m c4
git -C "$repo" push -q origin train/closed-remote-new
git -C "$repo" checkout -q main
git -C "$repo" branch -q -f train/closed-remote-new main
git -C "$repo" push -q origin main

# Closed non-train PRs. closed-head-ok: the head landed on main by a merge. closed-head-no: the
# head is not on main. closed-head-newer: the head is on main, the local branch has one more
# commit. closed-stacked-child sits on closed-stacked-parent (its PR's base); both heads landed.
for b in closed-head-ok closed-head-newer closed-head-remote-new closed-stacked-parent; do
    branch "$b"
done
git -C "$repo" checkout -q -b closed-stacked-child closed-stacked-parent
echo sc >"$repo/sc.txt"; git -C "$repo" add sc.txt; git -C "$repo" commit -q -m sc
git -C "$repo" push -q -u origin closed-stacked-child
git -C "$repo" checkout -q main
branch closed-head-no
for b in closed-head-ok closed-head-newer closed-head-remote-new closed-stacked-child; do
    git -C "$repo" merge -q --no-ff "$b" -m "merge $b"
done
git -C "$repo" push -q origin main
git -C "$repo" checkout -q closed-head-newer
echo newer >"$repo/newer.txt"; git -C "$repo" add newer.txt; git -C "$repo" commit -q -m newer
git -C "$repo" checkout -q main
# closed-head-remote-new: the head is on main, the local tip is that head, origin has one more.
rhead="$(git -C "$repo" rev-parse closed-head-remote-new)"
git -C "$repo" checkout -q closed-head-remote-new
echo rnew >"$repo/rnew.txt"; git -C "$repo" add rnew.txt; git -C "$repo" commit -q -m rnew
git -C "$repo" push -q origin closed-head-remote-new
git -C "$repo" checkout -q main
git -C "$repo" branch -q -f closed-head-remote-new "$rhead"
git -C "$repo" worktree add -q "$work/wt-head-ok" closed-head-ok
git -C "$repo" worktree add -q "$work/wt-closed-ok" train/closed-ok

# merged-after: a commit on the branch after the merge, which origin/main lacks.
git -C "$repo" checkout -q merged-after
echo more >"$repo/more.txt"
git -C "$repo" add more.txt
git -C "$repo" commit -q -m after
git -C "$repo" checkout -q main
git -C "$repo" worktree add -q "$work/wt-clean" merged-clean
git -C "$repo" worktree add -q "$work/wt-dirty" merged-dirty
echo untracked >"$work/wt-dirty/untracked.txt"
git -C "$repo" worktree add -q "$work/wt-locked" merged-locked
git -C "$repo" worktree lock "$work/wt-locked"
git -C "$repo" worktree add -q "$work/wt-claude" merged-claude
real_reason="claude agent agent-a21e24a259f0a8ec5 (pid 11671 start Sat Nov  7 14:26:54 2026)"
git -C "$repo" worktree lock --reason "$real_reason" "$work/wt-claude"
git -C "$repo" worktree add -q "$work/wt-claude-nostart" merged-claude-nostart
git -C "$repo" worktree lock --reason "claude agent agent-a1b2c3 (pid 4242)" \
    "$work/wt-claude-nostart"
git -C "$repo" worktree add -q "$work/wt-foreign" merged-foreign
git -C "$repo" worktree lock --reason "$real_reason trailing" "$work/wt-foreign"
git -C "$repo" worktree add -q "$work/wt-claude-dirty" merged-claude-dirty
echo x >"$work/wt-claude-dirty/u.txt"
git -C "$repo" worktree lock --reason "claude agent agent-d4e5f6 (pid 4242)" "$work/wt-claude-dirty"
git -C "$repo" push -q origin --delete merged-remote-gone

mkdir "$work/bin"
cat >"$work/bin/gh" <<'EOF'
#!/usr/bin/env bash
# Stub of `gh pr list --head <branch> --state merged|closed --json <f> --jq <filter>`: builds the
# JSON gh would print and runs the script's own --jq filter over it with jq. $STUB_MERGED lists
# branches with a merged PR (#42); $STUB_CLOSED those with a closed, unmerged PR (#43);
# $STUB_BOTH those whose closed listing holds a merged PR (#44) and an unmerged one (#45), as
# gh's `--state closed` does, while the merged listing is empty; $STUB_ONLYMERGED those whose
# closed listing holds only a merged PR (#46). A closed unmerged PR reports the head commit the
# file $STUB_HEADS gives for its branch ("<branch> <oid>" lines; none: an empty headRefOid).
b="" st="" filter=""
while [ $# -gt 0 ]; do
    [ "$1" = --head ] && b="$2"
    [ "$1" = --state ] && st="$2"
    [ "$1" = --jq ] && filter="$2"
    shift
done
json='[]'
in_list() { case " $1 " in *" $b "*) return 0 ;; esac; return 1; }
case "$st" in
    merged) in_list "$STUB_MERGED" && json='[{"number":42,"mergedAt":"2026-11-01T00:00:00Z"}]' ;;
    closed)
        head="$(awk -v b="$b" '$1 == b { print $2 }' "$STUB_HEADS")"
        if in_list "$STUB_CLOSED"; then
            json="[{\"number\":43,\"mergedAt\":null,\"headRefOid\":\"$head\"}]"
        elif in_list "$STUB_STACKED"; then
            # Its base is another branch (closed-stacked-parent); the script does not read it.
            json="[{\"number\":47,\"mergedAt\":null,\"headRefOid\":\"$head\"}]"
        elif in_list "$STUB_BOTH"; then
            json='[{"number":44,"mergedAt":"2026-11-01T00:00:00Z"},{"number":45,"mergedAt":null}]'
        elif in_list "$STUB_ONLYMERGED"; then
            json='[{"number":46,"mergedAt":"2026-11-01T00:00:00Z"}]'
        fi ;;
esac
printf '%s' "$json" | jq -r "$filter"
EOF
chmod +x "$work/bin/gh"

merged="merged-claude merged-claude-dirty merged-claude-nostart merged-foreign"
merged="$merged merged-clean merged-dirty merged-after"
merged="$merged merged-remote-gone merged-locked main"
closed="train/closed-ok train/closed-new closed-other train/closed-remote-new"
closed="$closed closed-head-ok closed-head-no closed-head-newer closed-head-remote-new"
stacked="closed-stacked-child"
# The head of each closed non-train PR (closed-head-no: a tip not on main). closed-other has
# none (an empty headRefOid): kept.
heads="$work/heads"
for b in closed-head-ok closed-head-newer closed-stacked-child closed-head-no; do
    echo "$b $(git -C "$repo" rev-parse "origin/$b")" >>"$heads"
done
echo "closed-head-remote-new $rhead" >>"$heads"
both="train/closed-both"
onlymerged="train/closed-onlymerged"
out="" rc=0
run() {
    out="$(cd "$repo" && PATH="$work/bin:$PATH" STUB_MERGED="$merged" STUB_CLOSED="$closed" \
        STUB_BOTH="$both" STUB_ONLYMERGED="$onlymerged" STUB_STACKED="$stacked" \
        STUB_HEADS="$heads" \
        "$script" "$@" 2>&1)"
    rc=$?
    [ -z "${DEBUG:-}" ] || printf '%s\n' "$out"
}

failures=0
ok() { echo "ok:   $1"; }
bad() { echo "FAIL: $1"; failures=$((failures + 1)); }
expect() { # expect <description> <command...>
    local what="$1"
    shift
    if "$@" >/dev/null 2>&1; then ok "$what"; else bad "$what"; fi
}
expect_not() {
    local what="$1"
    shift
    if "$@" >/dev/null 2>&1; then bad "$what"; else ok "$what"; fi
}
local_has() { git -C "$repo" show-ref --verify --quiet "refs/heads/$1"; }
remote_has() { git -C "$repo" ls-remote --exit-code --heads origin "$1" >/dev/null 2>&1; }
dir_has() { [ -d "$1" ]; }
said() { printf '%s\n' "$out" | grep -Fq -- "$1"; }
status_is() { [ "$rc" -eq "$1" ]; }

echo "# dry run"
run merged-clean merged-remote-gone
expect "dry run: says what it would remove" said "would remove: local branch merged-clean"
expect "dry run: the local branch stays" local_has merged-clean
expect "dry run: the remote branch stays" remote_has merged-clean
expect "dry run: the worktree stays" dir_has "$work/wt-clean"
expect "dry run: exit status 0" status_is 0

echo "# apply, merged and clean"
run --apply merged-clean merged-remote-gone
expect "the worktree is removed" test ! -d "$work/wt-clean"
expect_not "the local branch is deleted" local_has merged-clean
expect_not "the remote branch is deleted" remote_has merged-clean
expect_not "a branch whose remote is gone: the local branch is deleted" local_has merged-remote-gone
expect "a branch whose remote is gone: says so" said "the remote branch is already gone"
expect "exit status 0" status_is 0

echo "# kept, each with its reason"
run --apply merged-dirty merged-after not-merged-pr nonexistent main
expect "a dirty worktree is kept" said "wt-dirty is dirty"
expect "commits after the merge are kept" said "the tip is not an ancestor of origin/main"
expect "no merged pull request is kept" said "no merged pull request has it"
expect "a missing branch is nothing to clean" said "nonexistent: nothing to clean"
expect "the main checkout is kept" said "main is checked out in the main checkout"
expect "exit status 1" status_is 1
for b in merged-dirty merged-after not-merged-pr; do
    expect "$b: the local branch stays" local_has "$b"
done
expect "merged-dirty: the remote branch stays" remote_has merged-dirty
expect "merged-dirty: the worktree stays" dir_has "$work/wt-dirty"

echo "# a failed step stops the branch"
run --apply merged-locked
expect "the failed step is reported" said "FAILED: worktree"
expect "exit status 1" status_is 1
expect "the summary counts it" said "kept or failed 1 of 1"
expect "the local branch stays" local_has merged-locked
expect "the remote branch stays" remote_has merged-locked
expect "the worktree stays" dir_has "$work/wt-locked"

echo "# a Claude Code lock"
run --apply merged-claude merged-claude-dirty
expect "a clean worktree is unlocked" said "removing: the Claude Code lock"
expect "and removed" test ! -d "$work/wt-claude"
expect_not "and its local branch is deleted" local_has merged-claude
expect "a dirty one is kept" said "wt-claude-dirty is dirty"
expect "and keeps its directory" dir_has "$work/wt-claude-dirty"
expect "and its branch" local_has merged-claude-dirty

echo "# a Claude Code lock without a start time"
run --apply merged-claude-nostart
expect "is unlocked and removed" test ! -d "$work/wt-claude-nostart"

echo "# a foreign lock reason"
run --apply merged-foreign
expect "is not unlocked" dir_has "$work/wt-foreign"
expect "and fails" status_is 1
expect "and its branch stays" local_has merged-foreign

echo "# a closed train with a commit outside main, and a closed non-train PR"
run --apply train/closed-new closed-other
expect "a non-merge commit outside main is kept" said "non-merge commit outside origin/main"
expect "a closed non-train PR is kept" said "closed-other: KEEP (no merged pull request"
expect "exit status 1" status_is 1
expect "train/closed-new: the local branch stays" local_has train/closed-new
expect "train/closed-new: the remote branch stays" remote_has train/closed-new
expect "closed-other: the local branch stays" local_has closed-other
expect "closed-other: the remote branch stays" remote_has closed-other

echo "# a closed non-train PR: head not on main, and head on main with a newer local commit"
run --apply closed-head-no closed-head-newer
expect "a head outside main is kept" said "closed-head-no: KEEP (no merged pull request"
expect "and says the head is outside origin/main" said "outside origin/main)"
expect "a newer local commit is kept with the reason" \
    said "closed-head-newer: KEEP (PR #43 closed with head"
expect "and names the local branch" said "the local branch is not an ancestor of origin/main"
expect "exit status 1" status_is 1
for b in closed-head-no closed-head-newer; do
    expect "$b: the local branch stays" local_has "$b"
    expect "$b: the remote branch stays" remote_has "$b"
done

echo "# a closed non-train PR whose head is on main, but whose remote has a newer commit"
run --apply closed-head-remote-new
expect "the remote is named" said "origin/closed-head-remote-new is not an ancestor of origin/main"
expect "both refs are kept" said "both refs kept"
expect "exit status 1" status_is 1
expect "the local branch stays" local_has closed-head-remote-new
expect "the remote branch stays" remote_has closed-head-remote-new

echo "# a closed non-train PR for which GitHub reports no head commit"
run closed-other
expect "the message says so" said "GitHub reported no head commit for closed PR #43"
expect "exit status 1" status_is 1

echo "# a closed non-train PR whose head is on main, dry run then apply"
run closed-head-ok
short="$(git -C "$repo" rev-parse --short=8 origin/closed-head-ok)"
expect "dry run names the PR and the head" said "PR #43 closed, head $short on origin/main"
expect "dry run: the remote branch stays" remote_has closed-head-ok
run --apply closed-head-ok
expect "the worktree is removed" test ! -d "$work/wt-head-ok"
expect_not "the local branch is deleted" local_has closed-head-ok
expect_not "the remote branch is deleted" remote_has closed-head-ok
expect "exit status 0" status_is 0

echo "# a stacked closed PR (base another branch) whose head is on main"
run --apply closed-stacked-child
expect "names PR #47" said "PR #47 closed, head"
expect_not "the local branch is deleted" local_has closed-stacked-child
expect_not "the remote branch is deleted" remote_has closed-stacked-child
expect "exit status 0" status_is 0

echo "# a closed train whose remote alone has a unique commit"
run --apply train/closed-remote-new
expect "the failing ref is named" said "origin/train/closed-remote-new has a non-merge commit"
expect "both refs are kept" said "both refs kept"
expect "exit status 1" status_is 1
expect "the local branch stays" local_has train/closed-remote-new
expect "the remote branch stays" remote_has train/closed-remote-new

echo "# the closed-PR filter drops merged PRs"
run train/closed-both
expect "a merged and an unmerged closed PR: the unmerged one (#45) is chosen" \
    said "PR #45 closed train"
run train/closed-onlymerged
expect "only a merged PR in the closed listing: kept" said "KEEP (no merged pull request"
expect "exit status 1" status_is 1

echo "# a closed train, dry run then apply"
run train/closed-ok
expect "dry run names the closed PR" said "PR #43 closed train, no commits outside origin/main"
expect "dry run: the remote branch stays" remote_has train/closed-ok
run --apply train/closed-ok
expect "the worktree is removed" test ! -d "$work/wt-closed-ok"
expect_not "the local branch is deleted" local_has train/closed-ok
expect_not "the remote branch is deleted" remote_has train/closed-ok
expect "the output says the remote has no unique commits" said "has no commits outside origin/main"
expect "exit status 0" status_is 0

echo "# the main checkout is fast-forwarded to origin/main"
other="$work/other"
git clone -q "$work/origin.git" "$other" 2>/dev/null
git -C "$other" config user.email test@example.com
git -C "$other" config user.name test
advance() { # advance <file>: a new commit on origin's main, from the second clone
    git -C "$other" checkout -q main
    git -C "$other" pull -q --ff-only
    echo "$1" >"$other/$1.txt"
    git -C "$other" add "$1.txt"
    git -C "$other" commit -q -m "$1"
    git -C "$other" push -q origin main
}
tip() { git -C "$repo" rev-parse "$1"; }
git -C "$repo" checkout -q main
advance ff1
run merged-after
expect "dry run: main stays" test "$(tip main)" != "$(git -C "$other" rev-parse HEAD)"
run --apply nonexistent
expect "apply: main is at origin/main" test "$(tip main)" = "$(tip origin/main)"
expect "apply: main is at the new commit" test "$(tip main)" = "$(git -C "$other" rev-parse HEAD)"
expect "apply: says so" said "main checkout: main fast-forwarded"
run --apply nonexistent
expect "already current: says so" said "main is already at origin/main"

advance ff2
echo "# not on main: warn, change nothing"
git -C "$repo" checkout -q merged-after
before="$(tip main)"
run --apply nonexistent
expect "warns" said "WARNING: the main checkout is on merged-after"
expect "main is unchanged" test "$(tip main)" = "$before"
now="$(git -C "$repo" symbolic-ref --short HEAD)"
expect "the checkout stays on its branch" test "$now" = merged-after
git -C "$repo" checkout -q main

echo "# local changes: warn, change nothing"
echo dirt >>"$repo/init.txt"
before="$(tip main)"
run --apply nonexistent
expect "warns" said "WARNING: the main checkout has local changes"
expect "main is unchanged" test "$(tip main)" = "$before"
expect "the change is kept" grep -q dirt "$repo/init.txt"
git -C "$repo" checkout -q -- init.txt

echo "# cannot fast-forward: warn, change nothing"
echo local >"$repo/local.txt"
git -C "$repo" add local.txt
git -C "$repo" commit -q -m "local only"
before="$(tip main)"
run --apply nonexistent
expect "warns" said "WARNING: main cannot fast-forward"
expect "main is unchanged" test "$(tip main)" = "$before"
expect "exit status 0" status_is 0

if [ "$failures" -eq 0 ]; then
    echo "cleanup-merged: every case holds"
else
    echo "cleanup-merged: $failures case(s) failed"
    exit 1
fi
