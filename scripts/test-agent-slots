#!/usr/bin/env bash
# Test scripts/agent-slots with a scratch repository, stub worktrees and a scratch CLAUDE_HOME.
#
# Usage: scripts/test-agent-slots
# Cases: no agents is 0 and exit 0; a locked worktree whose pid is alive counts; one whose pid
# is dead, an unlocked worktree, and a lock that is not an agent's do not count; a recent
# transcript counts and an old one does not; a transcript outranks a lock of the same id; the
# limit (AGENT_SLOTS_MAX) gives exit 1 when reached and 0 below; --list names each agent; a bad
# argument is exit 2.
# Exit status: 0 when every case holds, 1 otherwise.
set -uo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
script="$here/agent-slots"
work="$(mktemp -d "${TMPDIR:-/tmp}/agent-slots-test.XXXXXX")"
trap 'rm -rf "$work"' EXIT
repo="$work/repo"
export CLAUDE_HOME="$work/claude"
mkdir -p "$CLAUDE_HOME"

git init -q "$repo"
git -C "$repo" symbolic-ref HEAD refs/heads/main
git -C "$repo" config user.email test@example.com
git -C "$repo" config user.name test
echo init >"$repo/init.txt"
git -C "$repo" add init.txt
git -C "$repo" commit -q -m init
repo="$(cd "$repo" && pwd -P)"
enc="${repo//[\/.]/-}"

failures=0
check() { # check <case> <condition exit status>
    if [ "$2" -eq 0 ]; then echo "ok: $1"; else echo "FAIL: $1"; failures=$((failures + 1)); fi
}
run() { (cd "$repo" && "$script" "$@" 2>&1); }
contains() { grep -Fq -- "$2" <<<"$1"; }
wt() { # wt <name> [lock reason]: a worktree, locked when a reason is given
    git -C "$repo" worktree add -q -b "$1" "$work/wt-$1" main
    [ -z "${2:-}" ] || git -C "$repo" worktree lock --reason "$2" "$work/wt-$1"
}
transcript() { # transcript <id> <age in seconds>
    local d="$CLAUDE_HOME/projects/$enc/sess/subagents"
    mkdir -p "$d"
    : >"$d/agent-$1.jsonl"
    touch -t "$(date -v-"$2"S +%Y%m%d%H%M.%S 2>/dev/null || date -d "-$2 sec" +%Y%m%d%H%M.%S)" \
        "$d/agent-$1.jsonl"
}

out="$(run)"
status=$?
{ [ "$status" -eq 0 ] && contains "$out" "agents: 0 of 4"; }
check "no agents: 0 of 4, exit 0" $?

sleep 60 &
live=$!
sleep 0.1
kill -0 "$live"
dead="$(sh -c 'echo $$')" # a pid that has exited
wt live "claude agent agent-a1 (pid $live start Sat Nov  7 14:26:54 2026)"
wt dead "claude agent agent-a2 (pid $dead)"
wt open
wt other "some other lock"
out="$(run --list)"
{ contains "$out" "agents: 1 of 4" && contains "$out" "a1 lock" && ! contains "$out" "a2"; }
check "a locked worktree with a live pid counts; dead pid, unlocked, other lock do not" $?

transcript b1 5
transcript b2 4000
out="$(run --list)"
{ contains "$out" "agents: 2 of 4" && contains "$out" "b1 transcript" && ! contains "$out" "b2"; }
check "a recent transcript counts, an old one does not" $?

transcript a1 4000
out="$(run)"
contains "$out" "agents: 1 of 4"
check "a transcript outranks the lock of the same id" $?

transcript c1 1
transcript c2 1
transcript c3 1
out="$(run)"
status=$?
{ [ "$status" -eq 1 ] && contains "$out" "agents: 4 of 4"; }
check "the limit reached is exit 1" $?
out="$(AGENT_SLOTS_MAX=5 run)"
status=$?
{ [ "$status" -eq 0 ] && contains "$out" "agents: 4 of 5"; }
check "AGENT_SLOTS_MAX raises the limit" $?

run --bogus >/dev/null
[ $? -eq 2 ]
check "a bad argument is exit 2" $?
AGENT_SLOTS_MAX=x run >/dev/null
[ $? -eq 2 ]
check "a bad limit is exit 2" $?

kill "$live" 2>/dev/null
wait "$live" 2>/dev/null
[ "$failures" -eq 0 ] || exit 1
echo "all cases hold"
