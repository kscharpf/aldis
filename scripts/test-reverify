#!/usr/bin/env bash
# Test scripts/reverify without a network, a container, or the real gh and cargo: a scratch bare
# origin, a clone of it, and stubs of `gh`, `cargo`, and `sleep` on the PATH.
#
# Usage: scripts/test-reverify
# Cases: the lock refuses a second run of the same PR (exit 3, holder's pid) and lets another PR
# run beside it; `--wait` queues behind the holder and then runs; a lock whose process is gone is
# taken over; the lock is released after a success, a failure, and a TERM; `--status` reports
# running, the last success, the last failure, and no record, and with `--wait` returns when the
# run ends; a run that main overtook (STALE) is brought up to date and run again, at most
# `--stale-retries` times, for a local and for a dispatched run; a failure with main unmoved
# (FAILED) is never retried; a run that aborts leaves no record of an earlier run; a PR's lock is
# released at its own final line; a PR number is digits only and `07` is `7`; `--cancel` cancels
# the PR's own in-flight run of a head that is behind main and no other (not another PR's run, not
# an older head's, not a current head's), only with the flag, then verifies as usual, and ends a
# reverify that was watching the cancelled run; a cancelled run is reported `cancelled`, neither
# FAILED nor STALE, and `--status` shows it (VER-060); the stub feeds gh's JSON through the script's
# own jq filter (so that a completed run is not cancelled; the cases need `jq` and are skipped
# without it), and a failing `gh pr view`, a PR that is not open, a failing `git fetch`, a
# merge-base that exits 128, and a failing `gh run list` each cancel nothing.
# Every wait times out (`--timeout <min>`, exit 5, with a TIMEOUT line, the lock released, and the
# line shown by `--status`): the hosted run, the `--wait` queue, `--cancel`, and `--status --wait`;
# a bad `--timeout` or REVERIFY_SECONDS_PER_MIN is a usage error; a waiter behind another reverify
# follows the deadline the holder records in the sidecar `<n>.deadline` and gives up only when it
# is overdue by 15 minutes (or, with no sidecar, after its own --timeout plus 15), and not while the
# holder renews it; the holder renews its own deadlines while it queues; the copy of main before
# #213 reads a new holder's lock (`running`, no takeover); a FAILED PR decides the exit status of
# several; the background watcher is gone after a
# timeout. The cases run a minute as a second (REVERIFY_SECONDS_PER_MIN)
# against stubs that never finish; the test kills its stubs on exit.
# Open-issue IDs are assigned at merge (scripts/assign-oi-ids): a placeholder in the branch is
# numbered in the row and in every reference, a second run changes nothing, two PRs that append a
# row at the end of the table merge without a conflict and get consecutive numbers, a number the
# branch added that main has taken since is renumbered with its references, and a failed merge
# keeps no number commit; a conflict that is only table rows is resolved by keeping both sides, a
# conflict in prose of docs/09 or in another file fails; a branch stacked on a merged PR that added
# an open issue takes the number of its parent (the OI-Assigned trailer), and a fresh placeholder
# with the same slug does not.
# Not covered: GitHub itself (dispatch, watch, the real STALE gate of `verify assemble`).
# VERBOSE=1 prints the output of the script under test after each failed case.
# Exit status: 0 when every case holds, 1 otherwise.
# shellcheck disable=SC2016  # the bash -c scripts are single-quoted on purpose: $0, $1 are theirs
set -uo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
script="$here/reverify"
work="$(mktemp -d "${TMPDIR:-/tmp}/reverify-test.XXXXXX")"
# On exit, kill every child of the test: the background runs and, below them, the stubs (their
# command lines hold $work/bin), so that a run of the test leaves no process holding a lock.
cleanup() {
    jobs -p | xargs kill 2>/dev/null
    ps -axo pid=,command= | awk -v dir="$work/bin/" 'index($0, dir) { print $1 }' |
        xargs kill 2>/dev/null
    rm -rf "$work"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
repo="$work/repo"
stub="$work/stub"
mkdir -p "$stub" "$work/bin"

git init -q --bare "$work/origin.git"
git -C "$work/origin.git" symbolic-ref HEAD refs/heads/main
git clone -q "$work/origin.git" "$repo" 2>/dev/null
git -C "$repo" symbolic-ref HEAD refs/heads/main
git -C "$repo" config user.email test@example.com
git -C "$repo" config user.name test
echo init >"$repo/init.txt"
# The open-issue table (docs/09-open-issues.md).
mkdir -p "$repo/docs"
printf '%s\n' "# 09 - Open issues" "" "| ID | Issue | Status |" "|---|---|---|" \
    "| OI-01 | first | Open |" "| OI-02 | second | Open |" >"$repo/docs/09-open-issues.md"
git -C "$repo" add init.txt docs
git -C "$repo" commit -q -m init
git -C "$repo" push -q -u origin main

for n in 7 8 9; do # PR n is branch pr-n, one commit, pushed
    git -C "$repo" checkout -q -b "pr-$n" main
    echo "$n" >"$repo/f$n.txt"
    git -C "$repo" add "f$n.txt"
    git -C "$repo" commit -q -m "pr-$n"
    git -C "$repo" push -q -u origin "pr-$n"
    echo "pr-$n" >"$stub/pr-$n"
done
git -C "$repo" checkout -q main

# A second clone moves origin/main, as another merge would.
git clone -q "$work/origin.git" "$work/other" 2>/dev/null
git -C "$work/other" config user.email test@example.com
git -C "$work/other" config user.name test
move_main() {
    n="$(($(cat "$stub/moves" 2>/dev/null || echo 0) + 1))"
    echo "$n" >"$stub/moves"
    echo "$n" >"$work/other/m$n.txt"
    git -C "$work/other" add "m$n.txt" >/dev/null
    git -C "$work/other" commit -q -m "main $n" >/dev/null
    git -C "$work/other" push -q origin main >/dev/null 2>&1
}

# gh: the pull request's branch, no run to reuse, a dispatched run whose conclusion the test sets.
cat >"$work/bin/gh" <<'EOF'
#!/usr/bin/env bash
# Stub of the gh calls of scripts/reverify.
case "$1 $2" in
"pr view")
    [ ! -e "$STUB/pr-view-fails" ] || exit 1
    echo "$(cat "$STUB/pr-state" 2>/dev/null || echo OPEN) $(cat "$STUB/pr-$3")"
    ;;
"pr list")
    # $STUB/open-prs holds `<number> <branch>` lines; the stub prints them as the JSON that gh
    # does and applies the script's own --jq filter with jq.
    filter=""
    prev=""
    for a in "$@"; do
        [ "$prev" = --jq ] && filter="$a"
        prev="$a"
    done
    jq -Rn '[inputs | split(" ") | {number: (.[0] | tonumber), headRefName: .[1]}]' \
        <"$STUB/open-prs" | jq -r "$filter"
    ;;
"workflow run") ;;
"run cancel")
    echo "$3" >>"$STUB/cancelled"
    touch "$STUB/release-watch"
    # A cancelled run is no longer in flight.
    if [ -e "$STUB/inflight" ]; then
        grep -v " $3 " "$STUB/inflight" >"$STUB/inflight.new"
        mv "$STUB/inflight.new" "$STUB/inflight"
    fi
    ;;
"run list")
    case "$*" in
    *"headSha,status --jq"*)
        # The in-flight runs: $STUB/inflight holds `<branch> <id> <head> [<status>]`; the stub
        # prints them as the JSON that gh does and applies the script's own --jq filter with jq.
        [ ! -e "$STUB/list-fails" ] || exit 1
        branch=""
        filter=""
        prev=""
        for a in "$@"; do
            [ "$prev" = --branch ] && branch="$a"
            [ "$prev" = --jq ] && filter="$a"
            prev="$a"
        done
        json="["
        sep=""
        if [ -e "$STUB/inflight" ]; then
            while read -r b id sha st; do
                [ "$b" = "$branch" ] || continue
                json+="$sep{\"databaseId\":$id,\"headSha\":\"$sha\","
                json+="\"status\":\"${st:-in_progress}\"}"
                sep=","
            done <"$STUB/inflight"
        fi
        printf '%s]' "$json" | jq -r "$filter"
        ;;
    *createdAt*)
        n="$(($(cat "$STUB/runs" 2>/dev/null || echo 0) + 1))"
        echo "$n" >"$STUB/runs"
        echo "$((100 + n))"
        ;;
    *"-L 1"*) echo 0 ;;
    esac
    ;;
"run watch")
    if { [ "$3" = 102 ] && [ -e "$STUB/hold-watch" ]; } || [ -e "$STUB/hold-watch-all" ]; then
        # bound: polls until the test releases the watch.
        while [ ! -e "$STUB/release-watch" ]; do /bin/sleep 0.1; done
    fi
    ;;
"run view")
    id="$3"
    # $STUB/dispatch-script lists one line per dispatched run, in order: fail-moved, fail,
    # cancelled, cancelled-moved (also moves main), or ok.
    kind="$(sed -n "$((id - 100))p" "$STUB/dispatch-script")"
    case "$kind" in
    fail-moved) "$STUB_MOVE"; echo failure ;;
    fail) echo failure ;;
    cancelled) echo cancelled ;;
    cancelled-moved) "$STUB_MOVE"; echo cancelled ;;
    *) echo success ;;
    esac
    ;;
esac
EOF
# cargo: ci passes; verify list says whether a container is needed (the file `container`);
# verify --publish follows the script `publish-script`, one line per call: ok, block, fail,
# fail-moved (also moves main), as long as `publish-always` is not set (then the last line repeats).
cat >"$work/bin/cargo" <<'EOF'
#!/usr/bin/env bash
case "$2 $3" in
"ci ") exit 0 ;;
"verify list")
    if [ -e "$STUB/container" ]; then
        echo "the run would start a container"
    else
        echo "no container would be started"
    fi
    exit 0
    ;;
"verify --publish")
    n="$(($(cat "$STUB/publishes" 2>/dev/null || echo 0) + 1))"
    echo "$n" >"$STUB/publishes"
    kind="$(sed -n "${n}p" "$STUB/publish-script")"
    [ -n "$kind" ] || kind="$(tail -n 1 "$STUB/publish-script")"
    echo "$$" >>"$STUB/publish-pids"
    case "$kind" in
    block)
        # bound: polls until the test releases the run.
        while [ ! -e "$STUB/release" ]; do /bin/sleep 0.1; done
        exit 0
        ;;
    fail-moved) "$STUB_MOVE"; exit 1 ;;
    fail) exit 1 ;;
    *) exit 0 ;;
    esac
    ;;
esac
EOF
printf '#!/usr/bin/env bash\nexec /bin/sleep 0.05\n' >"$work/bin/sleep"
# git: passes through, except that `merge-base --is-ancestor` exits 128 while $STUB/mb-fail exists.
real_git="$(command -v git)"
cat >"$work/bin/git" <<EOF
#!/usr/bin/env bash
if [ -e "\$STUB/mb-fail" ] && [[ "\$*" == *"merge-base --is-ancestor"* ]]; then exit 128; fi
exec "$real_git" "\$@"
EOF
cat >"$work/move-main" <<EOF
#!/usr/bin/env bash
$(declare -f move_main)
stub="$stub"
work="$work"
move_main
EOF
chmod +x "$work/bin/"* "$work/move-main"

failures=0
ok() { echo "ok   $1"; }
bad() {
    echo "FAIL $1"
    failures=$((failures + 1))
    [ -z "${VERBOSE:-}" ] || printf '%s\n' "$out" | sed 's/^/     | /'
}
expect() { # expect <description> <command...>
    local what="$1"
    shift
    if "$@" >/dev/null 2>&1; then ok "$what"; else bad "$what"; fi
}
expect_not() {
    local what="$1"
    shift
    if "$@" >/dev/null 2>&1; then bad "$what"; else ok "$what"; fi
}
said_re() { printf '%s\n' "$out" | grep -Eq -- "$1"; }
said() { printf '%s\n' "$out" | grep -Fq -- "$1"; }
status_is() { [ "$rc" -eq "$1" ]; }
publishes_are() { [ "$(cat "$stub/publishes" 2>/dev/null || echo 0)" -eq "$1" ]; }
lock_gone() { [ ! -e "$repo/.git/reverify/$1.lock" ] && [ ! -L "$repo/.git/reverify/$1.lock" ]; }

# Run scripts/reverify in the scratch repo with the stubs; sets $out and $rc.
export STUB="$stub" STUB_MOVE="$work/move-main"
run() {
    # A hang is a failure: perl's alarm ends the run after a minute.
    out="$(cd "$repo" && PATH="$work/bin:$PATH" perl -e 'alarm 60; exec @ARGV' "$script" "$@" 2>&1)"
    rc=$?
}
# Start one in the background; its output goes to $work/bg.<tag>.
bg() { # bg <tag> <args...>
    local tag="$1"
    shift
    (cd "$repo" && PATH="$work/bin:$PATH" exec "$script" "$@") >"$work/bg.$tag" 2>&1 &
    echo $! >"$work/pid.$tag"
}
pid_of() { cat "$work/pid.$1"; } # pid_of <tag>: the pid bg started
reset() { # reset <publish-script...>: clean counters, one script line per argument
    (cd "$stub" && rm -f publishes runs release release-watch hold-watch hold-watch-all container \
        publish-pids inflight cancelled pr-view-fails pr-state list-fails mb-fail)
    printf '%s\n' "$@" >"$stub/publish-script"
    printf '%s\n' ok >"$stub/dispatch-script"
}
wait_for() { # wait_for <file>: until it exists (10 s at most)
    local i
    for i in $(seq 1 100); do
        [ -e "$1" ] && return 0
        /bin/sleep 0.1
    done
    return 1
}

echo "# a success: the lock is released, --status says so"
reset ok
run 7
expect "a local run succeeds" said "#7 pr-7 local success"
expect "exit status 0" status_is 0
expect "the lock is released" lock_gone 7
run --status 7
expect "--status: the last success" said_re "#7 pr-7 local success \\(head [0-9a-f]{7}, finished"
expect "--status: exit status 0" status_is 0
run --status 9
expect "--status: no record" said "#9 no reverify recorded"
expect "--status: exit status 4" status_is 4

echo "# a failure: FAILED is not retried, the lock is released, --status says so"
reset fail
run 7
expect "the failure is labelled FAILED" said "#7 failed: FAILED: cargo xtask verify --publish"
expect "exit status 1" status_is 1
expect "FAILED is run once" publishes_are 1
expect "no retry is announced" bash -c '! printf "%s\n" "$0" | grep -Fq retry' "$out"
expect "the lock is released" lock_gone 7
run --status 7
expect "--status: the last failure" said "#7 failed: FAILED"
expect "--status: exit status 1" status_is 1

echo "# the lock refuses a second run of the same PR and lets another PR run"
reset block
bg a 7
wait_for "$stub/publish-pids"
run 7
expect "the second run is refused" said "a reverify is running (pid $(pid_of a)"
expect "exit status 3" status_is 3
expect "the second run did not start" publishes_are 1
run --status 7
expect "--status: running" said "#7 running: reverify pid $(pid_of a)"
expect "--status: exit status 3" status_is 3
printf '%s\n' block ok >"$stub/publish-script"
run 8
expect "another PR runs beside it" said "#8 pr-8 local success"
touch "$stub/release"
wait "$(pid_of a)"
expect "the holder finishes" grep -Fq "#7 pr-7 local success" "$work/bg.a"
expect "the lock is released" lock_gone 7

echo "# --wait queues behind the holder and then runs"
reset block
bg a 7
wait_for "$stub/publish-pids"
printf '%s\n' block ok >"$stub/publish-script"
bg b --wait 7
/bin/sleep 1
expect "the waiter says it waits" \
    grep -Fq "waiting for the reverify of pid $(pid_of a)" "$work/bg.b"
expect "the waiter has not run" publishes_are 1
touch "$stub/release"
wait "$(pid_of a)"
wait "$(pid_of b)"
rc_b=$?
expect "the waiter ran after the holder" publishes_are 2
expect "the waiter succeeded" grep -Fq "#7 pr-7 local success" "$work/bg.b"
expect "the waiter's exit status is 0" [ "$rc_b" -eq 0 ]
expect "the lock is released" lock_gone 7

echo "# --status --wait returns the final line once the run has ended"
reset block
bg a 7
wait_for "$stub/publish-pids"
bg b --status --wait 7
/bin/sleep 1
expect "--status --wait has not returned while the run holds the lock" kill -0 "$(pid_of b)"
touch "$stub/release"
wait "$(pid_of a)"
wait "$(pid_of b)"
rc_b=$?
expect "--status --wait prints the final line" \
    grep -Eq "#7 pr-7 local success \(head [0-9a-f]{7}, finished" "$work/bg.b"
expect "--status --wait: exit status 0" [ "$rc_b" -eq 0 ]

echo "# a lock whose process is gone is taken over"
reset ok
/bin/sleep 0 &
dead=$!
wait "$dead"
mkdir -p "$repo/.git/reverify"
ln -s "$dead|Thu Jan  1 00:00:00 1970" "$repo/.git/reverify/7.lock"
run 7
expect "the stale lock is taken over" said "the lock of pid $dead is stale; taking it over"
expect "the run succeeds" said "#7 pr-7 local success"
expect "the lock is released" lock_gone 7
# A live pid with another start time is a reused pid, not the holder.
ln -s "$$|Thu Jan  1 00:00:00 1970" "$repo/.git/reverify/7.lock"
run 7
expect "a reused pid is not a holder" said "is stale; taking it over"
expect "the run after a reused pid succeeds" said "#7 pr-7 local success"

echo "# the lock is released when the script is terminated"
reset block
bg a 7
wait_for "$stub/publish-pids"
kill -TERM "$(pid_of a)"
touch "$stub/release"
wait "$(pid_of a)"
expect "the terminated run left no lock" lock_gone 7

echo "# STALE (main moved) is run again, a local run"
reset fail-moved ok
run 7
expect "the stale run is announced" said "#7 failed: STALE: cargo xtask verify --publish"
expect "the retry is announced" said "retry 1 of 2"
expect "the retry succeeds" said "#7 pr-7 local success"
expect "exit status 0" status_is 0
expect "two runs" publishes_are 2
run --status 7
expect "--status: the retry's success" said_re "#7 pr-7 local success \\(head [0-9a-f]{7}, finished"

echo "# STALE every time stops at the bound"
reset fail-moved
run 7
expect "two retries are announced" said "retry 2 of 2"
expect "no third retry" bash -c '! printf "%s\n" "$0" | grep -Fq "retry 3"' "$out"
expect "three runs: the first and two retries" publishes_are 3
expect "the last stale line stays the result" said "#7 failed: STALE:"
expect "exit status 1" status_is 1
reset fail-moved
run --stale-retries 0 7
expect "--stale-retries 0 runs once" publishes_are 1
expect "--stale-retries 0: exit status 1" status_is 1
reset fail-moved
run --stale-retries 1 7
expect "--stale-retries 1 runs twice" publishes_are 2

echo "# STALE, a dispatched run"
reset ok
touch "$stub/container"
printf '%s\n' fail-moved ok >"$stub/dispatch-script"
run 7
expect "the stale run is labelled" said "pr-7 101 STALE (failure)"
expect "the retry is announced" said "retry 1 of 2"
expect "the second run succeeds" said "#7 pr-7 102 success"
expect "exit status 0" status_is 0
reset ok
touch "$stub/container"
printf '%s\n' fail >"$stub/dispatch-script"
run 7
expect "a failed run with main unmoved is FAILED" said "pr-7 101 FAILED (failure)"
expect "a FAILED run is not retried" bash -c '! printf "%s\n" "$0" | grep -Fq retry' "$out"
expect "exit status 1" status_is 1

echo "# an aborted run leaves no record of an earlier run"
reset ok
run 7
run --status 7
expect "the earlier run is recorded" said_re "#7 pr-7 local success \\(head"
git -C "$repo" remote set-url origin "$work/missing.git"
run 7
git -C "$repo" remote set-url origin "$work/origin.git"
expect "the aborted run fails" status_is 128
expect "the aborted run released the lock" lock_gone 7
run --status 7
expect "--status: no record after an abort" said "#7 no reverify recorded"
expect "--status: exit status 4 after an abort" status_is 4

echo "# a PR's lock is released at its final line, not at the end of the invocation"
reset ok
touch "$stub/container"
printf '%s\n' ok ok >"$stub/dispatch-script"
touch "$stub/hold-watch"
bg a 7 8
i=0
# Both locks are taken first; then PR 7's goes at its final line while PR 8's run is watched.
until [ -L "$repo/.git/reverify/8.lock" ] || [ "$i" -ge 100 ]; do /bin/sleep 0.1; i=$((i + 1)); done
until lock_gone 7 || [ "$i" -ge 200 ]; do /bin/sleep 0.1; i=$((i + 1)); done
expect "PR 7's lock is released while PR 8 is still being watched" lock_gone 7
expect_not "PR 8's lock is still held" lock_gone 8
run --status 7
expect "--status 7 has its final line already" said "#7 pr-7 101 success"
touch "$stub/release-watch"
wait "$(pid_of a)"
expect "both locks are released at the end" bash -c "[ ! -e '$repo/.git/reverify/8.lock' ]"
rm -f "$stub/container"

echo "# PR numbers are digits, and 07 is 7"
reset block
run ../x
expect "a path is not a PR number" status_is 2
run --status 7x
expect "--status: a non-number is a usage error" status_is 2
bg a 7
wait_for "$stub/publish-pids"
run 07
expect "07 is refused while 7 runs" said "a reverify is running (pid $(pid_of a)"
expect "07: exit status 3" status_is 3
touch "$stub/release"
wait "$(pid_of a)"

echo "# several PRs, one invocation"
reset ok
run 9 8
expect "both PRs run" \
    bash -c 'printf "%s\n" "$0" | grep -Fq "#8 pr-8 local success" &&
        printf "%s\n" "$0" | grep -Fq "#9 pr-9 local success"' "$out"
expect "both locks are released" \
    bash -c "[ ! -e '$repo/.git/reverify/8.lock' ] && [ ! -e '$repo/.git/reverify/9.lock' ]"

tip() { git -C "$work/origin.git" rev-parse "refs/heads/$1"; }
cancelled_is() { [ "$(tr '\n' ' ' <"$stub/cancelled" 2>/dev/null)" = "$1" ]; }

if ! command -v jq >/dev/null 2>&1; then
    echo "skip the --cancel cases: they need jq"
else
echo "# --cancel: the PR's own in-flight run of a head behind main, and no other"
reset ok
move_main
# PR 7 is behind main now. Its run 555 is in flight; so are PR 8's run 556, an older head's run 557
# of PR 7, and a run of a PR 7 head that is not in flight is not listed at all.
printf '%s\n' "pr-7 555 $(tip pr-7)" "pr-8 556 $(tip pr-8)" \
    "pr-7 557 0000000000000000000000000000000000000000" >"$stub/inflight"
run 7
expect "no flag, no cancel" [ ! -e "$stub/cancelled" ]
# That run merged main into pr-7; main moves again, so that pr-7's head is behind it once more.
move_main
printf '%s\n' "pr-7 555 $(tip pr-7)" "pr-8 556 $(tip pr-8)" \
    "pr-7 557 0000000000000000000000000000000000000000" "pr-7 554 $(tip pr-7) completed" \
    >"$stub/inflight"
run --cancel 7
expect "the run of the PR's head is cancelled" said "#7: cancelled run 555 of"
expect "only that run is cancelled (not a completed, another PR's, or an older head's)" \
    cancelled_is "555 "
expect "then it verifies as usual" said "#7 pr-7 local success"
expect "exit status 0" status_is 0
expect "the lock is released" lock_gone 7

echo "# --cancel leaves a current head alone"
reset ok
run 8
printf '%s\n' "pr-8 558 $(tip pr-8)" >"$stub/inflight"
run --cancel 8
expect "a head that contains main is not cancelled" [ ! -e "$stub/cancelled" ]
expect "it still verifies" said "#8 pr-8 local success"

echo "# --cancel and --status do not combine"
run --status --cancel 7
expect "usage error" status_is 2

echo "# a cancelled run is reported cancelled, not FAILED or STALE, and not retried"
reset ok
touch "$stub/container"
printf '%s\n' cancelled-moved ok >"$stub/dispatch-script"
run 7
expect "the line says cancelled" said "#7 pr-7 101 cancelled (no record, no status"
expect "it is not labelled STALE" bash -c '! printf "%s\n" "$0" | grep -Fq STALE' "$out"
expect "it is not labelled FAILED" bash -c '! printf "%s\n" "$0" | grep -Fq FAILED' "$out"
expect "it is not retried" bash -c '! printf "%s\n" "$0" | grep -Fq retry' "$out"
expect "exit status 1" status_is 1
expect "the lock is released" lock_gone 7
run --status 7
expect "--status shows cancelled" said "#7 pr-7 101 cancelled"
expect "--status: exit status 1" status_is 1

echo "# --cancel ends a reverify that is watching the run, then runs a new one"
reset ok
touch "$stub/container" "$stub/hold-watch-all"
printf '%s\n' cancelled ok >"$stub/dispatch-script"
bg a 7
wait_for "$stub/runs"
/bin/sleep 0.3
move_main
printf '%s\n' "pr-7 101 $(tip pr-7)" >"$stub/inflight"
bg b --cancel 7
wait "$(pid_of a)"
rc_a=$?
wait "$(pid_of b)"
rc_b=$?
expect "the cancelled run is cancelled" cancelled_is "101 "
expect "the watcher reports it cancelled" grep -Fq "#7 pr-7 101 cancelled" "$work/bg.a"
expect "the watcher exits 1" [ "$rc_a" -eq 1 ]
expect "the canceller dispatched a new run and it succeeded" \
    grep -Fq "#7 pr-7 102 success" "$work/bg.b"
expect "the canceller exits 0" [ "$rc_b" -eq 0 ]
expect "the lock is released" lock_gone 7
rm -f "$stub/container" "$stub/hold-watch-all"

echo "# --cancel cancels nothing when a lookup fails or the PR is not open"
arm() { # a PR 7 head behind main with a run in flight, and a clean slate
    reset ok
    move_main
    printf '%s\n' "pr-7 601 $(tip pr-7)" >"$stub/inflight"
}
nothing_cancelled() { [ ! -e "$stub/cancelled" ]; }
arm
touch "$stub/pr-view-fails"
run --cancel 7
expect "gh pr view fails: said so" said "cannot read the pull request; nothing cancelled"
expect "gh pr view fails: nothing cancelled" nothing_cancelled
arm
echo CLOSED >"$stub/pr-state"
run --cancel 7
expect "a PR that is not open: nothing cancelled" nothing_cancelled
arm
git -C "$repo" remote set-url origin "$work/missing.git"
run --cancel 7
git -C "$repo" remote set-url origin "$work/origin.git"
expect "git fetch fails: said so" said "cannot fetch origin; nothing cancelled"
expect "git fetch fails: nothing cancelled" nothing_cancelled
arm
touch "$stub/mb-fail"
run --cancel 7
expect "merge-base exits 128: said so" said "nothing cancelled"
expect "merge-base exits 128: nothing cancelled" nothing_cancelled
arm
touch "$stub/list-fails"
run --cancel 7
expect "gh run list fails: said so" said "cannot list the runs; nothing cancelled"
expect "gh run list fails: nothing cancelled" nothing_cancelled
reset ok
fi

echo "# --timeout: every wait ends with a TIMEOUT line and exit 5 (a minute is a second here)"
export REVERIFY_SECONDS_PER_MIN=1
reset ok
touch "$stub/container" "$stub/hold-watch-all"
run --timeout 1 7
expect "the hosted run: TIMEOUT line with PR, run id and short head" \
    said_re "^#7 TIMEOUT: pr-7 run 101 head [0-9a-f]{7} still running after 1 min"
expect "the hosted run: exit status 5" status_is 5
expect "the hosted run: the lock is released" lock_gone 7
/bin/sleep 1
# Before the exit trap's cleanup: a leaked watcher would show here.
watcher_gone() { ! pgrep -f -- "$work/bin/gh run watch" >/dev/null; }
expect "the hosted run: the background gh run watch is gone" watcher_gone
run --status 7
expect "--status shows the recorded TIMEOUT" \
    said_re "^#7 TIMEOUT: pr-7 run 101 head [0-9a-f]{7}.*\\(head [0-9a-f]{7}, finished"
expect "--status: exit status 5" status_is 5
rm -f "$stub/container" "$stub/hold-watch-all"

# Stub holders: a live process, its lock target `<pid>|<start>`, and its sidecar.
lock_of() { # lock_of <pid>
    printf '%s|%s' "$1" "$(TZ=UTC LC_ALL=C ps -o lstart= -p "$1" | sed 's/^ *//; s/ *$//')"
}
put_deadline() { # put_deadline <pr> <pid> <seconds from now>
    printf '%s|%s\n' "$(lock_of "$2")" "$(($(date +%s) + $3))" \
        >"$repo/.git/reverify/$1.deadline.new"
    mv -f "$repo/.git/reverify/$1.deadline.new" "$repo/.git/reverify/$1.deadline"
}

# A running reverify records a deadline in the sidecar `<n>.deadline`, `<pid>|<start>|<epoch s>`,
# and keeps its lock `<pid>|<start>`, so that the copy of main reads it.
reset block
bg a 7
wait_for "$stub/publish-pids"
expect "the holder's lock is <pid>|<start>" \
    bash -c "readlink '$repo/.git/reverify/7.lock' | grep -Eq '^[0-9]+[|][^|]+\$'"
expect "the holder's sidecar carries a deadline" \
    bash -c "grep -Eq '^$(pid_of a)[|][^|]+[|][0-9]+\$' '$repo/.git/reverify/7.deadline'"
# This case guards the transition from the pre-#213 lock: 9aea5e9 is the last main before it.
if git -C "$here" show 9aea5e9:scripts/reverify >"$work/old-reverify" 2>/dev/null; then
    chmod +x "$work/old-reverify"
    out="$(cd "$repo" && PATH="$work/bin:$PATH" perl -e 'alarm 60; exec @ARGV' \
        "$work/old-reverify" --status 7 2>&1)"
    rc=$?
    expect "the copy of main reads the new holder's lock: running" \
        said "#7 running: reverify pid $(pid_of a)"
    expect "the copy of main: exit status 3" status_is 3
    out="$(cd "$repo" && PATH="$work/bin:$PATH" perl -e 'alarm 60; exec @ARGV' \
        "$work/old-reverify" 7 2>&1)"
    rc=$?
    expect "the copy of main does not take over the new holder's lock" \
        bash -c '! printf "%s\n" "$0" | grep -Fq "stale"' "$out"
    expect "the copy of main: refused, exit status 3" status_is 3
else
    echo "skip the pre-#213 copy: commit 9aea5e9 is not available"
fi
touch "$stub/release"
wait "$(pid_of a)"
expect "the sidecar is removed with the lock" bash -c "[ ! -e '$repo/.git/reverify/7.deadline' ]"

# The holder renews: `--wait 7 8` takes 7 and queues behind a stub holder of 8; the deadline of 7
# grows while it queues.
reset ok
mkdir -p "$repo/.git/reverify"
/bin/sleep 300 &
hq=$!
ln -s "$(lock_of "$hq")" "$repo/.git/reverify/8.lock"
bg w --wait 7 8
wait_for "$repo/.git/reverify/7.deadline"
d1="$(sed 's/.*|//' "$repo/.git/reverify/7.deadline")"
/bin/sleep 3
d2="$(sed 's/.*|//' "$repo/.git/reverify/7.deadline")"
expect "the deadline of 7 grows while the holder queues for 8" [ "$d2" -gt "$d1" ]
kill -TERM "$(pid_of w)"
wait "$(pid_of w)"
kill "$hq" 2>/dev/null
rm -f "$repo/.git/reverify/8.lock"

/bin/sleep 300 &
h7=$!
/bin/sleep 300 &
h8=$!
/bin/sleep 300 &
h9=$!
# Waiters follow the recorded deadline of the holder. The margin is 15 s here. Lock 7: due in 2 s,
# never renewed. Lock 8: due in 2 s, renewed every second for 20 s. Lock 9: no sidecar (a holder
# of an older script).
ln -s "$(lock_of "$h7")" "$repo/.git/reverify/7.lock"
ln -s "$(lock_of "$h8")" "$repo/.git/reverify/8.lock"
ln -s "$(lock_of "$h9")" "$repo/.git/reverify/9.lock"
put_deadline 7 "$h7" 2
put_deadline 8 "$h8" 2
(
    for _ in $(seq 1 20); do
        put_deadline 8 "$h8" 2
        /bin/sleep 1
    done
) &
t0=$SECONDS
bg q --wait 7
bg c --cancel 7
bg s --status --wait 7
bg r --wait 8
bg n --wait --timeout 1 9
/bin/sleep 10
expect "before the deadline plus the margin the waiters still wait" \
    kill -0 "$(pid_of q)" "$(pid_of c)" "$(pid_of s)"
/bin/sleep 8
expect "a renewed deadline keeps its waiter waiting past where an unrenewed one ends" \
    kill -0 "$(pid_of r)"
wait "$(pid_of q)"
rc_q=$?
t_q=$((SECONDS - t0))
wait "$(pid_of c)"
rc_c=$?
wait "$(pid_of s)"
rc_s=$?
wait "$(pid_of n)"
rc_n=$?
expect "--wait queue: TIMEOUT line says the holder is stalled" \
    grep -Eq \
    "^#7 TIMEOUT: still queued behind the stalled reverify of pid $h7, whose deadline passed" \
    "$work/bg.q"
expect "--wait queue: exit status 5" [ "$rc_q" -eq 5 ]
expect "the waiter gave up after the deadline plus the margin (17 s), not before" [ "$t_q" -ge 17 ]
expect "and not much later (the renewal case below runs past 37 s)" [ "$t_q" -le 30 ]
expect "--cancel (implies --wait): TIMEOUT, exit status 5" \
    bash -c 'grep -Fq "#7 TIMEOUT: still queued" "$0" && [ "$1" -eq 5 ]' "$work/bg.c" "$rc_c"
expect "--status --wait: TIMEOUT, exit status 5" \
    bash -c 'grep -Eq "^#7 TIMEOUT: still running; the reverify of pid $2 is stalled" "$0" &&
        [ "$1" -eq 5 ]' "$work/bg.s" "$rc_s" "$h7"
expect "no sidecar (lock 9): the waiter's own --timeout plus the margin (16 s)" \
    grep -Fq "which recorded no deadline, after 16 min" "$work/bg.n"
expect "no deadline recorded: exit status 5" [ "$rc_n" -eq 5 ]
wait "$(pid_of r)"
rc_r=$?
expect "the renewing holder's waiter ends only after the renewals stop" \
    grep -Fq "#8 TIMEOUT: still queued behind the stalled reverify" "$work/bg.r"
expect "that waiter: exit status 5" [ "$rc_r" -eq 5 ]
expect "the waiter's timeout leaves the holder's lock" bash -c "[ -L '$repo/.git/reverify/7.lock' ]"
kill "$h7" "$h8" "$h9" 2>/dev/null
rm -f "$repo/.git/reverify/7.lock" "$repo/.git/reverify/8.lock" "$repo/.git/reverify/9.lock" \
    "$repo/.git/reverify"/*.deadline

# A failed PR decides the exit status of a call with several PRs.
reset ok
touch "$stub/container" "$stub/hold-watch"
printf '%s\n' fail ok >"$stub/dispatch-script"
run --timeout 1 7 8
expect "several PRs: the failed PR is printed" said "#7 pr-7 101 FAILED (failure)"
expect "several PRs: the timed-out PR is printed" said_re "^#8 TIMEOUT: pr-8 run 102 head"
expect "several PRs: both summaries are printed" \
    bash -c 'printf "%s\n" "$0" | grep -Fq "1 of 2 PR(s) timed out" &&
        printf "%s\n" "$0" | grep -Fq "1 of 2 PR(s) not verified"' "$out"
expect "several PRs: FAILED decides, exit status 1" status_is 1
rm -f "$stub/container" "$stub/hold-watch"

reset ok
run --timeout 0 7
expect "--timeout 0 is a usage error" status_is 2
run --timeout x 7
expect "--timeout x is a usage error" status_is 2
run --timeout
expect "--timeout without a value is a usage error" status_is 2
for bad in 0 x '$(touch /nonexistent-x)'; do
    out="$(cd "$repo" && REVERIFY_SECONDS_PER_MIN="$bad" PATH="$work/bin:$PATH" "$script" 7 2>&1)"
    rc=$?
    expect "REVERIFY_SECONDS_PER_MIN='$bad' is a usage error" status_is 2
done
unset REVERIFY_SECONDS_PER_MIN

echo "# --all-behind: the open PRs whose head lacks origin/main, as one call"
printf '%s\n' "7 pr-7" "8 pr-8" "9 pr-9" >"$stub/open-prs"
reset ok
move_main
git -C "$work/other" fetch -q origin
git -C "$work/other" checkout -q -B pr-9 origin/pr-9
git -C "$work/other" merge -q --no-edit origin/main >/dev/null
git -C "$work/other" push -q origin pr-9 >/dev/null 2>&1
git -C "$work/other" checkout -q main
run --all-behind
expect "the PRs behind main are listed" said "behind origin/main: 7 8"
expect "PR 7 is reverified" said "#7 pr-7 local success"
expect "PR 8 is reverified" said "#8 pr-8 local success"
expect "PR 9 contains main and is left alone" bash -c '! printf "%s\n" "$0" | grep -Fq "#9"' "$out"
expect "--all-behind: exit status 0" status_is 0
expect "--all-behind: one run per PR behind" publishes_are 2
reset ok
run --all-behind
expect "none behind: said so" said "no open pull request is behind origin/main"
expect "none behind: exit status 0" status_is 0
expect "none behind: nothing verified" publishes_are 0
run --all-behind 7
expect "--all-behind with a PR number is a usage error" status_is 2
run --all-behind --status
expect "--all-behind with --status is a usage error" status_is 2

echo "# open-issue IDs are assigned at merge (scripts/assign-oi-ids)"
oi_doc=docs/09-open-issues.md
oi_branch() { # oi_branch <pr> <branch> <row> <file> <text>: a PR from origin/main with a new row
    git -C "$work/other" fetch -q origin
    git -C "$work/other" checkout -q -B "$2" origin/main
    printf '%s\n' "$3" >>"$work/other/$oi_doc"
    printf '%s\n' "$5" >"$work/other/$4"
    git -C "$work/other" add -A
    git -C "$work/other" commit -q -m "$2"
    git -C "$work/other" push -q -f origin "$2" >/dev/null 2>&1
    git -C "$work/other" checkout -q main
    echo "$2" >"$stub/pr-$1"
}
oi_merge() { # oi_merge <branch>: merge it into origin/main, as the maintainer would
    git -C "$work/other" fetch -q origin
    git -C "$work/other" checkout -q -B main origin/main
    git -C "$work/other" merge -q --no-edit "origin/$1" >/dev/null
    git -C "$work/other" push -q origin main >/dev/null 2>&1
}
oi_show() { git -C "$work/other" fetch -q origin && git -C "$work/other" show "origin/$1:$2"; }
oi_has() { oi_show "$1" "$2" | grep -Fq -- "$3"; } # oi_has <branch> <file> <text>
oi_rows() { oi_show "$1" "$oi_doc" | grep -oE '^\| OI[-A-Za-z0-9]+' | tr -d '| \n'; echo; }
oi_head() { git -C "$work/other" rev-parse "origin/$1"; }
rows_are() { [ "$(oi_rows "$1")" = "$2" ]; } # rows_are <branch> <ids joined by nothing>
new=NEW # the placeholders are built here: the gate refuses one in a tracked file
new_a="OI-$new-alpha"
new_b="OI-$new-beta"
oi_branch 11 oi-a "| $new_a | alpha | Open |" a.md "see $new_a, not $new_a-x or OI-01"
oi_branch 12 oi-b "| $new_b | beta | Open |" b.md "see $new_b"
printf '%s\n' "11 oi-a" "12 oi-b" >"$stub/open-prs"

reset ok
run 11
expect "a placeholder is numbered: success" said "#11 oi-a local success"
expect "the number commit is announced" said "assign-oi-ids: $new_a as OI-03"
expect "the row has the number" oi_has oi-a $oi_doc "| OI-03 | alpha | Open |"
expect "every reference has it" oi_has oi-a a.md "see OI-03, not $new_a-x or OI-01"
expect "no placeholder is left in the table" rows_are oi-a OI-01OI-02OI-03
head_a="$(oi_head oi-a)"
reset ok
run 11
expect "a second run changes nothing" test "$(oi_head oi-a)" = "$head_a"
expect "a second run succeeds" said "#11 oi-a local success"

oi_merge oi-a
reset ok
run 12
expect "both rows were appended at the end: no conflict" said "#12 oi-b local success"
expect "the second PR gets the next number, after the first" rows_are oi-b OI-01OI-02OI-03OI-04
expect "its reference follows" oi_has oi-b b.md "see OI-04"
expect "the merged row keeps its number" oi_has oi-b $oi_doc "| OI-03 | alpha | Open |"
expect "its own row has the number" oi_has oi-b $oi_doc "| OI-04 | beta | Open |"
expect "the conflict of the two appended rows is resolved by keeping both" \
    said "assign-oi-ids: kept both sides of the open-issue rows that conflicted"
expect "the rows are put in order afterwards" said "assign-oi-ids: open issues put in number order"

echo "# an open issue numbered before another PR merged is renumbered when its number is taken"
oi_merge oi-b
oi_branch 13 oi-c "| OI-05 | gamma | Open |" c.md "see OI-05 and OI-01; OI-50 is not ours"
oi_branch 14 oi-d "| OI-05 | delta | Open |" d.md "see OI-05 and OI-01; OI-50 is not ours"
oi_merge oi-c
reset ok
run 14
expect "the clash is renumbered: success" said "#14 oi-d local success"
expect "the renumbering is announced" said "assign-oi-ids: OI-05 as OI-06"
expect "the other PR's row stays" oi_has oi-d $oi_doc "| OI-05 | gamma | Open |"
expect "the branch's row moves to the next number" oi_has oi-d $oi_doc "| OI-06 | delta | Open |"
expect "rows are in order" rows_are oi-d OI-01OI-02OI-03OI-04OI-05OI-06
expect "its references follow" oi_has oi-d d.md "see OI-06 and OI-01; OI-50 is not ours"
expect "the merged PR's file is not rewritten" oi_has oi-d c.md "see OI-05 and OI-01"

echo "# a failed merge leaves no number commit behind"
oi_branch 15 oi-e "| OI-$new-eps | epsilon | Open |" init.txt "branch side"
git -C "$work/other" checkout -q -B main origin/main
echo "main side" >"$work/other/init.txt"
git -C "$work/other" commit -q -am "main edits init.txt"
git -C "$work/other" push -q origin main >/dev/null 2>&1
head_e="$(oi_head oi-e)"
reset ok
run 15
expect "a conflicting merge fails as before" said "merge conflict with origin/main"
expect "the number commit is not kept" bash -c \
    '[ "$(git -C "$0" rev-parse oi-e 2>/dev/null || git -C "$0" rev-parse HEAD)" = "$1" ]' \
    "$repo/.claude/worktrees/reverify-15" "$head_e"
expect "nothing was pushed" test "$(oi_head oi-e)" = "$head_e"

echo "# a conflict in the prose of docs/09 is not resolved"
git -C "$work/other" fetch -q origin
git -C "$work/other" checkout -q -B oi-p origin/main
perl -pi -e '$. == 1 and $_ = "# 09 - Open issues (branch)\n"' "$work/other/$oi_doc"
git -C "$work/other" commit -q -am "oi-p"
git -C "$work/other" push -q -f origin oi-p >/dev/null 2>&1
echo oi-p >"$stub/pr-16"
git -C "$work/other" checkout -q -B main origin/main
perl -pi -e '$. == 1 and $_ = "# 09 - Open issues (main)\n"' "$work/other/$oi_doc"
git -C "$work/other" commit -q -am "main edits the title"
git -C "$work/other" push -q origin main >/dev/null 2>&1
head_p="$(oi_head oi-p)"
reset ok
run 16
expect "a prose conflict fails" said "merge conflict with origin/main"
expect "a prose conflict pushes nothing" test "$(oi_head oi-p)" = "$head_p"

echo "# a PR stacked on a merged PR takes its parent's number; an equal slug elsewhere does not"
sa="OI-$new-stack"
sb="OI-$new-child"
oi_branch 21 oi-s1 "| $sa | parent | Open |" sa.md "A $sa"
orig_a="$(oi_head oi-s1)"
oi_branch 22 oi-s3 "| $sa | coincidence | Open |" sc.md "C $sa"
git -C "$work/other" checkout -q -B oi-s2 "$orig_a"
printf '%s\n' "| $sb | child | Open |" >>"$work/other/$oi_doc"
printf '%s\n' "B refs $sa and $sb" >"$work/other/sb.md"
git -C "$work/other" add -A
git -C "$work/other" commit -q -m oi-s2
git -C "$work/other" push -q -f origin oi-s2 >/dev/null 2>&1
git -C "$work/other" checkout -q main
echo oi-s2 >"$stub/pr-23"
reset ok
run 21
expect "the parent is numbered" said "assign-oi-ids: $sa as OI-06"
git -C "$work/other" fetch -q origin
expect "the number is recorded as a trailer" bash -c \
    'git -C "$0" log --format=%B origin/oi-s1 | grep -Fxq "OI-Assigned: $1 OI-06"' \
    "$work/other" "$sa"
oi_merge oi-s1
reset ok
run 23
expect "the child succeeds" said "#23 oi-s2 local success"
expect "the child inherits its parent's number: one row each" \
    rows_are oi-s2 OI-01OI-02OI-03OI-04OI-05OI-06OI-07
expect "its references have both numbers" oi_has oi-s2 sb.md "B refs OI-06 and OI-07"
oi_merge oi-s2
reset ok
run 22
expect "the equal slug is fresh: success" said "#22 oi-s3 local success"
expect "it gets its own number" rows_are oi-s3 OI-01OI-02OI-03OI-04OI-05OI-06OI-07OI-08
expect "its reference follows" oi_has oi-s3 sc.md "C OI-08"
expect "the parent's row is untouched" oi_has oi-s3 $oi_doc "| OI-06 | parent | Open |"

if [ "$failures" -eq 0 ]; then
    echo "reverify: every case holds"
else
    echo "reverify: $failures case(s) failed"
    exit 1
fi
