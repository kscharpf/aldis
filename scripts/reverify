#!/usr/bin/env bash
# Bring open pull requests up to date with main and start their verification run (VER-060).
#
# Usage: scripts/reverify [--wait] [--cancel] [--stale-retries <n>] [--timeout <min>] <pr-number>...
#        scripts/reverify --status [--wait] [--timeout <min>] <pr-number>
#
# Phase 1, per PR in order: check it is open; use the worktree of its head branch (or add one
# under .claude/worktrees/reverify-<n>); refuse when that worktree is dirty or holds commits the
# remote lacks; merge origin/main; run `cargo xtask ci`; push; then, if the merged head needs no
# container (`cargo xtask verify list`: every gating check skipped or reused, as for a stacked
# PR whose base has merged, VER-056), run `cargo xtask verify --publish` here (no image, no
# engine; on macOS it also runs the host-bound test-macos, about two minutes); otherwise
# dispatch verify.yml on the branch and note the new run. A branch already up to date with
# origin/main whose head has a successful or in-progress run reuses that run. A failure marks
# the PR failed and goes on.
# Phase 2: wait for the dispatched runs (they run concurrently on GitHub) and print one line per
# PR: `#<n> <branch> <run-id> <conclusion>` (`local` for a run made here) or
# `#<n> failed: <reason>`. A run that did not succeed is labelled STALE when its head does not
# contain the tip of origin/main (main moved: merge it and run again; the record is published
# for reuse) and FAILED otherwise, decided by ancestry, never by reading logs (VER-058). A STALE
# PR is brought up to date and verified again, at most `--stale-retries` times (default 2), and
# each retry is printed; a FAILED one is never retried. Exits non-zero if any PR failed or any
# run did not succeed. Deletes nothing (see prune-agent-branches).
#
# One reverify per PR at a time, across all worktrees: the PR's lock lives in the git common
# directory (reverify/<n>.lock) and is released when the PR's final line is printed, or when the
# script exits, however it ends. A second `scripts/reverify <n>` while one runs prints the
# holder's pid and exits 3; with `--wait` it queues behind the holder and then runs. A lock whose
# process is gone is taken over. Different PRs run side by side. A PR number is digits only; `07`
# and `7` are one PR.
#
# `--cancel` is the explicit, opt-in way to stop waiting for a run that main has overtaken: before
# anything else it cancels the PR's own in-flight verify.yml run of the PR's head when that head
# does not contain the tip of origin/main (other PRs' runs and runs of a head that is current are
# left alone), then verifies as usual, and it implies `--wait`, so that a reverify that is
# watching the cancelled run ends and releases the lock. Nothing cancels without the flag. A
# cancelled run publishes no record and sets no status, so the next merge of main reuses nothing
# from it (VER-060); the reverify that was watching it prints
# `#<n> <branch> <run> cancelled (...)`, neither FAILED nor STALE, and `--status` shows that line
# (exit 1) until the next run starts.
#
# Every wait has a timeout, `--timeout <min>` (default 60): the wait for the hosted run of a PR, the
# `--wait` queue behind another reverify (so also `--cancel`, which implies it), and `--status
# --wait`. Each wait has its own budget, counted from its start. When one expires the script prints
# a final `#<n> TIMEOUT: ...` line naming the PR, the short head and the run id (when there are
# any), releases the PR's lock, and exits 5 (0, 1, 3 and 4 are taken; 2 is usage). The hosted run
# is left running, and a timed-out run is not cancelled. A timeout while queued or in `--status
# --wait` is not recorded, since another reverify owns the result; a timed-out wait for a run is,
# and `--status` shows it (exit 5). A run made here (`verify --publish`) has no timeout.
#
# `--status <n>` reads, with no network, one line: `#<n> running: ...` (exit 3) while a reverify
# holds the lock, else the final line of the last reverify run on this machine with the head it is
# about (exit 0 when it succeeded, 1 when it did not, 5 when it timed out), else `#<n> no reverify recorded` (exit 4):
# a run that aborts before its final line leaves no record. With `--wait` it first waits until no
# reverify holds the lock, so that the line is the final one.
set -euo pipefail

usage() { awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; }

wait_lock=0
cancel=0
stale_retries=2
timeout_min=60
# Seconds per minute of --timeout: a test knob, so that the tests need not wait minutes.
secs_per_min="${REVERIFY_SECONDS_PER_MIN:-60}"
status_mode=0
args=()
while [ $# -gt 0 ]; do
    case "$1" in
    --wait) wait_lock=1 ;;
    --status) status_mode=1 ;;
    --cancel)
        cancel=1
        wait_lock=1
        ;;
    --stale-retries)
        [ $# -ge 2 ] && [[ "$2" =~ ^[0-9]+$ ]] || { usage; exit 2; }
        stale_retries="$2"
        shift
        ;;
    --timeout)
        [ $# -ge 2 ] && [[ "$2" =~ ^[0-9]+$ ]] && [ "$((10#$2))" -ge 1 ] || { usage; exit 2; }
        timeout_min="$((10#$2))"
        shift
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    -*)
        usage
        exit 2
        ;;
    *)
        [[ "$1" =~ ^[0-9]+$ ]] || { usage; exit 2; }
        args+=("$((10#$1))")
        ;;
    esac
    shift
done
if [ "${#args[@]}" -eq 0 ] || { [ "$status_mode" -eq 1 ] && [ "${#args[@]}" -ne 1 ]; } ||
    { [ "$status_mode" -eq 1 ] && [ "$cancel" -eq 1 ]; }; then
    usage
    exit 2
fi

timeout_s=$((timeout_min * secs_per_min))

export NO_COLOR=1 GH_FORCE_TTY=0 GH_NO_UPDATE_NOTIFIER=1

main_checkout="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
state_dir="$(git rev-parse --path-format=absolute --git-common-dir)/reverify"
mkdir -p "$state_dir"

# The start time of process $1, empty when it is gone: with its pid, the identity of a lock holder
# (a reused pid has another start time).
# The locale and zone are fixed, so that the same process always prints the same start time.
proc_start() { TZ=UTC LC_ALL=C ps -o lstart= -p "$1" 2>/dev/null | sed 's/^ *//; s/ *$//' || true; }

# The final line of a PR, kept for `--status`; $1 pr, $2 ok or fail, $3 the line, $4 the head
# commit it is about (empty when the run never got one).
record_final() {
    local head=""
    [ -z "$4" ] || head="head ${4:0:7}, "
    printf '%s\n%s (%sfinished %s)\n' "$2" "$3" "$head" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$state_dir/$1.last"
}

# True when the lock of PR $1 is held by a live process; sets `holder`.
lock_held() {
    holder="$(readlink "$state_dir/$1.lock" 2>/dev/null)" &&
        [ -n "$(proc_start "${holder%%|*}")" ] &&
        [ "$(proc_start "${holder%%|*}")" = "${holder#*|}" ]
}

if [ "$status_mode" -eq 1 ]; then
    pr="${args[0]}"
    if [ "$wait_lock" -eq 1 ]; then
        wait_start=$SECONDS
        # bound: ends when the holder's reverify ends or the wait has lasted --timeout.
        while lock_held "$pr"; do
            if [ $((SECONDS - wait_start)) -ge "$timeout_s" ]; then
                echo "#$pr TIMEOUT: still running after $timeout_min min (reverify pid ${holder%%|*} since ${holder#*|})"
                exit 5
            fi
            sleep 5
        done
    fi
    if lock_held "$pr"; then
        echo "#$pr running: reverify pid ${holder%%|*} since ${holder#*|}"
        exit 3
    fi
    if [ -s "$state_dir/$pr.last" ]; then
        { read -r verdict; read -r line; } <"$state_dir/$pr.last"
        echo "$line"
        [ "$verdict" != timeout ] || exit 5
        [ "$verdict" = ok ]
        exit $?
    fi
    echo "#$pr no reverify recorded"
    exit 4
fi

# Locks. A lock is a symlink `<n>.lock` whose target is `<pid>|<start time>` of the holder: creating
# it is one atomic step, so there is no moment with a lock and no owner. Taking over a stale one
# goes through a second symlink, `<n>.lock.take`, so that two takers cannot both win.
me="$$|$(proc_start $$)"
held=()
watcher=""

release_locks() {
    local pr
    [ -z "$watcher" ] || kill "$watcher" 2>/dev/null || true
    for pr in ${held[@]+"${held[@]}"}; do
        if [ "$(readlink "$state_dir/$pr.lock" 2>/dev/null || true)" = "$me" ]; then
            rm -f "$state_dir/$pr.lock"
        fi
    done
    held=()
}
trap release_locks EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# True when the process named by the lock target $1 (`<pid>|<start>`) is still the holder.
holder_alive() {
    local start
    start="$(proc_start "${1%%|*}")"
    [ -n "$start" ] && [ "$start" = "${1#*|}" ]
}

# Take the lock of PR $1. Returns 3 when another reverify holds it (and --wait is off).
lock_acquire() {
    local pr="$1" lock="$state_dir/$1.lock" holder taker announced=0 wait_start=$SECONDS
    # bound: each pass takes the lock, returns, or waits for a live holder (--wait only, at most
    # --timeout); a stale lock is removed by the one taker, and a crashed taker's mutex is removed
    # as stale.
    while true; do
        if ln -s "$me" "$lock" 2>/dev/null; then
            held+=("$pr")
            return 0
        fi
        holder="$(readlink "$lock" 2>/dev/null)" || continue
        if holder_alive "$holder"; then
            if [ "$wait_lock" -eq 0 ]; then
                echo "#$pr: a reverify is running (pid ${holder%%|*}, since ${holder#*|}); wait for its final line (scripts/reverify --status $pr), or run with --wait" >&2
                return 3
            fi
            if [ "$announced" -eq 0 ]; then
                echo "#$pr: waiting for the reverify of pid ${holder%%|*}"
                announced=1
            fi
            if [ $((SECONDS - wait_start)) -ge "$timeout_s" ]; then
                echo "#$pr TIMEOUT: still queued after $timeout_min min behind the reverify of pid ${holder%%|*} (no run, no head)"
                return 5
            fi
            sleep 5
            continue
        fi
        if ln -s "$me" "$lock.take" 2>/dev/null; then
            if [ "$(readlink "$lock" 2>/dev/null || true)" = "$holder" ]; then
                echo "#$pr: the lock of pid ${holder%%|*} is stale; taking it over"
                rm -f "$lock"
            fi
            rm -f "$lock.take"
        else
            taker="$(readlink "$lock.take" 2>/dev/null || true)"
            if [ -n "$taker" ] && ! holder_alive "$taker"; then
                rm -f "$lock.take"
            fi
            sleep 0.2
        fi
    done
}

# Wait for the hosted run $1 to end, at most --timeout. Returns 0 when it ended and 5 when the wait
# expired (the run goes on; only the watcher is stopped).
watch_run() {
    local start=$SECONDS
    gh run watch "$1" --interval 60 --exit-status >/dev/null 2>&1 &
    watcher=$!
    # bound: ends when the watcher exits or the wait has lasted --timeout.
    while kill -0 "$watcher" 2>/dev/null; do
        if [ $((SECONDS - start)) -ge "$timeout_s" ]; then
            kill "$watcher" 2>/dev/null || true
            wait "$watcher" 2>/dev/null || true
            watcher=""
            return 5
        fi
        sleep 1
    done
    wait "$watcher" 2>/dev/null || true
    watcher=""
    return 0
}

# Cancel the in-flight verify.yml runs of PR $1 (--cancel) that are of the PR's own head and
# whose head does not contain the tip of origin/main. The runs are listed for the PR's own branch
# and only those of the head commit count, so another PR's run is never cancelled; a PR that is
# not open, a head that is current, and any lookup that fails cancel nothing (prepare_one reports
# a PR that is not open). Returns 0 always.
cancel_inflight() {
    local pr="$1" info branch head runs id sha rc=0
    info="$(gh pr view "$pr" --json state,headRefName --jq '.state + " " + .headRefName')" ||
        { echo "#$pr: cannot read the pull request; nothing cancelled"; return 0; }
    [ "${info%% *}" = "OPEN" ] || return 0
    branch="${info#* }"
    git -C "$main_checkout" fetch --quiet origin ||
        { echo "#$pr: cannot fetch origin; nothing cancelled"; return 0; }
    head="$(git -C "$main_checkout" rev-parse "origin/$branch")" || return 0
    # Only exit status 1 says "main is not in the head's history"; 0 is a current head, more is an error.
    git -C "$main_checkout" merge-base --is-ancestor origin/main "$head" || rc=$?
    if [ "$rc" -gt 1 ]; then
        echo "#$pr: cannot compare ${head:0:7} with origin/main; nothing cancelled"
        return 0
    fi
    [ "$rc" -eq 1 ] || return 0
    runs="$(gh run list --workflow=verify.yml --branch "$branch" -L 20 --json databaseId,headSha,status \
        --jq '.[] | select(.status != "completed") | "\(.databaseId) \(.headSha)"')" ||
        { echo "#$pr: cannot list the runs; nothing cancelled"; return 0; }
    while read -r id sha; do
        [ -n "$id" ] && [ "$sha" = "$head" ] || continue
        if gh run cancel "$id" >/dev/null; then
            echo "#$pr: cancelled run $id of ${head:0:7}, which is behind main (no record, no status)"
        else
            echo "#$pr: could not cancel run $id"
        fi
    done <<<"$runs"
    return 0
}

sorted_prs="$(printf '%s\n' "${args[@]}" | sort -n -u)"
# Before the locks: a reverify that is watching the run ends when the run is cancelled, and then
# releases the lock this one waits for (--cancel implies --wait).
if [ "$cancel" -eq 1 ]; then
    for pr in $sorted_prs; do cancel_inflight "$pr"; done
fi
# Ascending, so that two runs that queue for the same PRs cannot wait on each other.
for pr in $sorted_prs; do
    lock_acquire "$pr" || { rc=$?; release_locks; exit "$rc"; }
    # A run that aborts before its final line must not leave the previous run's line as the result.
    rm -f "$state_dir/$pr.last"
done
# Again, now that no other reverify can dispatch: a holder that was still preparing may have
# dispatched a run since the first pass.
if [ "$cancel" -eq 1 ]; then
    for pr in $sorted_prs; do cancel_inflight "$pr"; done
fi

git -C "$main_checkout" fetch --quiet origin

# The path of the worktree that has `refs/heads/$1` checked out, or nothing.
worktree_of() {
    git -C "$main_checkout" worktree list --porcelain | awk -v ref="refs/heads/$1" '
        $1 == "worktree" { path = substr($0, 10) }
        $1 == "branch" && $2 == ref { print path; exit }'
}

reason=""
branch=""
run_id=""
work_dir=""
work_head=""

# STALE when `$2` does not contain the tip of origin/main (fetched first), else FAILED: the label
# of a verification that did not succeed. Ancestry decides, not the logs.
failure_label() {
    if git -C "$1" fetch --quiet origin main &&
        ! git -C "$1" merge-base --is-ancestor origin/main "$2"; then
        echo STALE
    else
        echo FAILED
    fi
}

# Record why the PR failed; always returns 1.
fail() {
    reason="$1"
    return 1
}

# Prepare one PR. Sets `branch`, `run_id` (dispatched or reused) and, on failure, `reason`.
prepare_one() {
    local pr="$1" info state dir head dispatched before found plan
    reason=""
    branch=""
    run_id=""
    work_dir=""
    work_head=""
    info="$(gh pr view "$pr" --json state,headRefName --jq '.state + " " + .headRefName')" ||
        fail "cannot read the pull request" || return 1
    state="${info%% *}"
    branch="${info#* }"
    [ "$state" = "OPEN" ] || fail "$state, not OPEN" || return 1

    dir="$(worktree_of "$branch")"
    if [ -z "$dir" ]; then
        dir="$main_checkout/.claude/worktrees/reverify-$pr"
        if git -C "$main_checkout" show-ref --verify --quiet "refs/heads/$branch"; then
            git -C "$main_checkout" worktree add "$dir" "$branch" ||
                fail "cannot add a worktree for $branch" || return 1
        else
            git -C "$main_checkout" worktree add -b "$branch" "$dir" "origin/$branch" ||
                fail "cannot add a worktree for $branch" || return 1
        fi
    fi
    echo "#$pr: branch $branch in $dir"

    if [ -n "$(git -C "$dir" status --porcelain)" ]; then
        fail "worktree $dir is dirty; commit or discard first" || return 1
    fi
    if [ "$(git -C "$dir" rev-list --count "origin/$branch..HEAD")" -gt 0 ]; then
        fail "worktree $dir has commits origin/$branch lacks; push or resolve first" || return 1
    fi
    git -C "$dir" merge --ff-only --quiet "origin/$branch" ||
        fail "cannot fast-forward to origin/$branch" || return 1

    if ! git -C "$dir" merge --no-edit origin/main; then
        git -C "$dir" merge --abort || true
        fail "merge conflict with origin/main; resolve by hand in $dir" || return 1
    fi
    head="$(git -C "$dir" rev-parse HEAD)"
    work_dir="$dir"
    work_head="$head"

    # Up to date with main (the merge changed nothing): reuse a good run of this exact head.
    if [ "$head" = "$(git -C "$dir" rev-parse "origin/$branch")" ]; then
        found="$(gh run list --workflow=verify.yml --branch "$branch" -L 20 \
            --json databaseId,headSha,status,conclusion \
            --jq "[.[] | select(.headSha == \"$head\" and (.status != \"completed\" or .conclusion == \"success\"))][0].databaseId // empty")" ||
            found=""
        if [ -n "$found" ]; then
            run_id="$found"
            echo "#$pr: reusing run $run_id for $head"
            return 0
        fi
    fi

    (cd "$dir" && cargo xtask ci) || fail "cargo xtask ci failed in $dir" || return 1
    git -C "$dir" push --quiet origin "HEAD:refs/heads/$branch" || fail "push failed" || return 1

    # The head needs no container when the input rule skips or reuses every gating check: then
    # the run is made here, with no engine, and the commit is already on GitHub (VER-056).
    plan="$(cd "$dir" && cargo xtask verify list 2>&1)" ||
        fail "cargo xtask verify list failed in $dir" || return 1
    if grep -q 'the run would start a container' <<<"$plan"; then
        :
    elif grep -q 'no container would be started' <<<"$plan"; then
        echo "#$pr: no container is needed; verifying here"
        (cd "$dir" && cargo xtask verify --publish) ||
            fail "$(failure_label "$dir" "$head"): cargo xtask verify --publish in $dir" ||
            return 1
        run_id="local"
        return 0
    else
        fail "cannot read the plan of cargo xtask verify list" || return 1
    fi

    dispatched="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    before="$(gh run list --workflow=verify.yml --branch "$branch" -L 1 --json databaseId --jq '.[0].databaseId // 0')" ||
        before=0
    gh workflow run verify.yml --ref "$branch" || fail "dispatch failed" || return 1
    for _ in $(seq 1 20); do
        sleep 5
        found="$(gh run list --workflow=verify.yml --branch "$branch" -L 1 --json databaseId,createdAt \
            --jq ".[0] | select(.createdAt >= \"$dispatched\" and .databaseId != $before) | .databaseId")" ||
            found=""
        if [ -n "$found" ]; then
            run_id="$found"
            echo "#$pr: dispatched run $run_id"
            return 0
        fi
    done
    fail "the dispatched run did not appear" || return 1
}

prs=()
branches=()
runs=()
reasons=()
dirs=()
heads=()
for pr in "${args[@]}"; do
    prepare_one "$pr" || true
    dirs+=("$work_dir")
    heads+=("$work_head")
    prs+=("$pr")
    branches+=("$branch")
    runs+=("$run_id")
    reasons+=("$reason")
done

# Print and record the final line of PR $1: $2 ok or fail, $3 the line, $4 the head commit; then
# release its lock, so that a waiter for this PR does not wait for the PRs that follow it.
finish() {
    echo "$3"
    record_final "$1" "$2" "$3" "$4"
    if [ "$(readlink "$state_dir/$1.lock" 2>/dev/null || true)" = "$me" ]; then
        rm -f "$state_dir/$1.lock"
    fi
}

failed=0
timed_out=0
for i in "${!prs[@]}"; do
    pr="${prs[$i]}"
    tries=0
    # bound: each pass either ends the PR or retries it, and retries stop at --stale-retries.
    while true; do
        verdict=""
        line=""
        if [ -n "${reasons[$i]}" ]; then
            line="#$pr failed: ${reasons[$i]}"
            case "${reasons[$i]}" in
            STALE:*) verdict=stale ;;
            *) verdict=fail ;;
            esac
        elif [ "${runs[$i]}" = "local" ]; then
            # `verify --publish` exited 0: the record passed and the status is set.
            line="#$pr ${branches[$i]} local success"
            verdict=ok
        else
            watch_rc=0
            watch_run "${runs[$i]}" || watch_rc=$?
            conclusion=""
            if [ "$watch_rc" -eq 0 ]; then
                conclusion="$(gh run view "${runs[$i]}" --json conclusion --jq '.conclusion')" ||
                    conclusion="unknown"
            fi
            if [ "$watch_rc" -ne 0 ]; then
                line="#$pr TIMEOUT: ${branches[$i]} run ${runs[$i]} head ${heads[$i]:0:7} still running after $timeout_min min; stopped waiting, the run goes on (scripts/reverify $pr again, or gh run watch ${runs[$i]})"
                verdict=timeout
            elif [ "$conclusion" = "success" ]; then
                line="#$pr ${branches[$i]} ${runs[$i]} $conclusion"
                verdict=ok
            elif [ "$conclusion" = "cancelled" ]; then
                # By `reverify --cancel`, by a newer dispatch, or by hand: the run published no
                # record and set no status. Neither FAILED nor STALE, and not retried here.
                line="#$pr ${branches[$i]} ${runs[$i]} cancelled (no record, no status; run scripts/reverify $pr again)"
                verdict=cancelled
            else
                label="$(failure_label "${dirs[$i]}" "${heads[$i]}")"
                line="#$pr ${branches[$i]} ${runs[$i]} $label ($conclusion)"
                if [ "$label" = STALE ]; then verdict=stale; else verdict=fail; fi
            fi
        fi
        if [ "$verdict" = stale ] && [ "$tries" -lt "$stale_retries" ]; then
            tries=$((tries + 1))
            echo "$line"
            echo "#$pr: main moved during the run; retry $tries of $stale_retries (merge origin/main, push, verify again)"
            prepare_one "$pr" || true
            dirs[$i]="$work_dir"
            heads[$i]="$work_head"
            branches[$i]="$branch"
            runs[$i]="$run_id"
            reasons[$i]="$reason"
            continue
        fi
        break
    done
    if [ "$verdict" = ok ]; then
        finish "$pr" ok "$line" "${heads[$i]}"
    elif [ "$verdict" = timeout ]; then
        finish "$pr" timeout "$line" "${heads[$i]}"
        timed_out=$((timed_out + 1))
    elif [ "$verdict" = cancelled ]; then
        finish "$pr" cancelled "$line" "${heads[$i]}"
        failed=$((failed + 1))
    else
        finish "$pr" fail "$line" "${heads[$i]}"
        failed=$((failed + 1))
    fi
done
[ "$timed_out" -eq 0 ] || { echo "reverify: $timed_out of ${#prs[@]} PR(s) timed out"; exit 5; }
[ "$failed" -eq 0 ] || { echo "reverify: $failed of ${#prs[@]} PR(s) not verified"; exit 1; }
