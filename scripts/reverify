#!/usr/bin/env bash
# Bring open pull requests up to date with main and start their verification run (VER-060).
#
# Usage: scripts/reverify <pr-number>...
#
# Per PR: check it is open; use the worktree of its head branch (or add one under
# .claude/worktrees/reverify-<n>); refuse when that worktree is dirty or holds commits the
# remote lacks; merge origin/main; run `cargo xtask ci`; push; dispatch verify.yml on the
# branch; wait for the run and print its conclusion. Deletes nothing (see prune-agent-branches).
set -euo pipefail

if [ $# -eq 0 ]; then
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
fi

export NO_COLOR=1 GH_FORCE_TTY=0 GH_NO_UPDATE_NOTIFIER=1

main_checkout="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
git -C "$main_checkout" fetch --quiet origin

# The path of the worktree that has `refs/heads/$1` checked out, or nothing.
worktree_of() {
    git -C "$main_checkout" worktree list --porcelain | awk -v ref="refs/heads/$1" '
        $1 == "worktree" { path = substr($0, 10) }
        $1 == "branch" && $2 == ref { print path; exit }'
}

reverify_one() {
    local pr="$1" info state branch dir run_id before conclusion
    info="$(gh pr view "$pr" --json state,headRefName --jq '.state + " " + .headRefName')" || return 1
    state="${info%% *}"
    branch="${info#* }"
    if [ "$state" != "OPEN" ]; then
        echo "#$pr: $state, not OPEN; skipped"
        return 1
    fi

    dir="$(worktree_of "$branch")"
    if [ -z "$dir" ]; then
        dir="$main_checkout/.claude/worktrees/reverify-$pr"
        if git -C "$main_checkout" show-ref --verify --quiet "refs/heads/$branch"; then
            git -C "$main_checkout" worktree add "$dir" "$branch" || return 1
        else
            git -C "$main_checkout" worktree add -b "$branch" "$dir" "origin/$branch" || return 1
        fi
    fi
    echo "#$pr: branch $branch in $dir"

    if [ -n "$(git -C "$dir" status --porcelain)" ]; then
        echo "#$pr: worktree is dirty; commit or discard first"
        return 1
    fi
    if [ "$(git -C "$dir" rev-list --count "origin/$branch..HEAD")" -gt 0 ]; then
        echo "#$pr: the worktree has commits origin/$branch lacks; push or resolve first"
        return 1
    fi
    git -C "$dir" merge --ff-only --quiet "origin/$branch" || {
        echo "#$pr: cannot fast-forward to origin/$branch"
        return 1
    }

    if ! git -C "$dir" merge --no-edit origin/main; then
        git -C "$dir" merge --abort || true
        echo "#$pr: merge conflict with origin/main; resolve by hand in $dir"
        return 1
    fi
    (cd "$dir" && cargo xtask ci) || {
        echo "#$pr: cargo xtask ci failed in $dir"
        return 1
    }
    git -C "$dir" push --quiet origin "HEAD:refs/heads/$branch" || return 1

    before="$(gh run list --workflow=verify.yml --branch "$branch" -L 1 --json databaseId --jq '.[0].databaseId // 0')"
    gh workflow run verify.yml --ref "$branch" || return 1
    run_id="$before"
    for _ in $(seq 1 30); do
        sleep 4
        run_id="$(gh run list --workflow=verify.yml --branch "$branch" -L 1 --json databaseId --jq '.[0].databaseId // 0')"
        [ "$run_id" != "$before" ] && break
    done
    if [ "$run_id" = "$before" ]; then
        echo "#$pr: the dispatched run did not appear"
        return 1
    fi
    echo "#$pr: watching run $run_id"
    gh run watch "$run_id" --exit-status >/dev/null || true
    conclusion="$(gh run view "$run_id" --json conclusion --jq '.conclusion')"
    echo "#$pr: verify run $run_id: $conclusion"
    [ "$conclusion" = "success" ]
}

failed=0
for pr in "$@"; do
    reverify_one "$pr" || failed=$((failed + 1))
done
[ "$failed" -eq 0 ] || { echo "reverify: $failed of $# PR(s) not verified"; exit 1; }
