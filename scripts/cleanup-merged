#!/usr/bin/env bash
# Remove the worktree and branches of named branches whose pull request has merged, or whose
# closed train pull request left no commit outside origin/main. Dry run unless --apply.
#
# Usage: scripts/cleanup-merged [--apply] <branch>...
#
# A branch is cleaned only when all hold; otherwise the script says which does not and keeps it:
#   - a merged pull request has it as its head branch, and its tip is an ancestor of origin/main
#     (never of the local main, which may be stale); or
#   - it matches train/*, a closed pull request that did not merge has it as its head branch, and
#     `git log --no-merges origin/main..<branch>` is empty (a rebuilt train: coordinator.md,
#     "Failure"), for the local branch and for the remote branch alike;
#   - its worktree, if it has one, is clean and is not the main checkout. A clean worktree locked
#     by Claude Code for a finished agent (reason `claude agent agent-<id> (pid N)`, with an
#     optional ` start <time>` after the pid) is unlocked first; a lock with any other reason
#     fails the removal.
# Then: the worktree is removed, the local branch deleted (-D: the ancestry test, or for a closed
# train the no-unique-commits test, is the proof it is safe), and the remote branch deleted if it
# still exists and meets the same test as the local branch (an ancestor of origin/main; for a
# closed train, no commit outside origin/main). For a closed train both refs are tested before
# anything is deleted: if either fails, both are kept and the script says which.
# Bulk cleanup of leftovers is scripts/prune-agent-branches.
set -euo pipefail

usage() { awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; }

apply=0
branches=()
for arg in "$@"; do
    case "$arg" in
        --apply) apply=1 ;;
        -*) echo "unknown option $arg" >&2; usage; exit 2 ;;
        *) branches+=("$arg") ;;
    esac
done
if [ "${#branches[@]}" -eq 0 ]; then
    usage
    exit 2
fi

export NO_COLOR=1 GH_FORCE_TTY=0 GH_NO_UPDATE_NOTIFIER=1

main_checkout="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
g() { git -C "$main_checkout" "$@"; }
g fetch --quiet --prune origin

# The path of the worktree that has refs/heads/$1 checked out, or nothing.
worktree_of() {
    g worktree list --porcelain | awk -v ref="refs/heads/$1" '
        $1 == "worktree" { path = substr($0, 10) }
        $1 == "branch" && $2 == ref { print path; exit }'
}

# Whether worktree $1 is locked by Claude Code for a finished agent (reason `claude agent
# agent-<id> (pid N)`, with an optional ` start <time>` after the pid; N is the coordinator's own
# session, so liveness cannot tell). Called only for a clean worktree whose branch is merged.
# Any other lock is not ours to remove.
claude_lock() {
    g worktree list --porcelain | awk -v wt="$1" '
        $1 == "worktree" { in_wt = (substr($0, 10) == wt) }
        in_wt && $1 == "locked" { print substr($0, 8) }' \
        | grep -Eq '^claude agent agent-[0-9a-f]+ \(pid [0-9]+( start [^)]*)?\)$'
}

act() { # act <description> <command...>
    local what="$1"
    shift
    if [ "$apply" -eq 1 ]; then
        echo "  removing: $what"
        "$@" || { echo "  FAILED: $what"; return 1; }
    else
        echo "  would remove: $what"
    fi
}

# Whether ref $1 has no non-merge commit outside origin/main. The test reads the local
# origin/main ref, which the script fetched at its start (`g fetch --prune origin`); a stale ref
# can only keep a branch, never delete one wrongly.
no_unique_commits() {
    [ -z "$(g log --no-merges --format=%h "origin/main..$1")" ]
}

clean_one() {
    local b="$1" pr wt local_branch=0 remote_branch=0 closed=0
    if g show-ref --verify --quiet "refs/heads/$b"; then local_branch=1; fi
    if g show-ref --verify --quiet "refs/remotes/origin/$b"; then remote_branch=1; fi
    if [ "$local_branch" -eq 0 ] && [ "$remote_branch" -eq 0 ]; then
        echo "$b: nothing to clean (no local or remote branch)"
        return 0
    fi

    pr="$(gh pr list --head "$b" --state merged --json number --jq '.[0].number // empty')" \
        || { echo "$b: KEEP (gh could not list its pull requests)"; return 1; }
    if [ -z "$pr" ]; then
        case "$b" in
            train/*)
                pr="$(gh pr list --head "$b" --state closed --json number,mergedAt \
                    --jq 'map(select((.mergedAt // "") == "")) | .[0].number // empty')" \
                    || { echo "$b: KEEP (gh could not list its pull requests)"; return 1; }
                [ -z "$pr" ] || closed=1
                ;;
        esac
    fi
    if [ -z "$pr" ]; then
        echo "$b: KEEP (no merged pull request has it as its head branch)"
        return 1
    fi

    if [ "$closed" -eq 1 ]; then
        local failed=""
        if [ "$local_branch" -eq 1 ] && ! no_unique_commits "refs/heads/$b"; then
            failed="the local branch"
        fi
        if [ "$remote_branch" -eq 1 ] && ! no_unique_commits "refs/remotes/origin/$b"; then
            failed="${failed:+$failed and }origin/$b"
        fi
        if [ -n "$failed" ]; then
            echo "$b: KEEP (PR #$pr closed, but $failed has a non-merge commit" \
                "outside origin/main; both refs kept)"
            return 1
        fi
        echo "$b: PR #$pr closed train, no commits outside origin/main"
    else
        if [ "$local_branch" -eq 1 ] \
            && ! g merge-base --is-ancestor "refs/heads/$b" origin/main; then
            echo "$b: KEEP (PR #$pr merged, but the tip is not an ancestor of origin/main:" \
                "commits after the merge, or a squash merge)"
            return 1
        fi
        echo "$b: PR #$pr merged"
    fi
    wt="$(worktree_of "$b")"
    if [ -n "$wt" ]; then
        if [ "$wt" = "$main_checkout" ]; then
            echo "  KEEP: $b is checked out in the main checkout"
            return 1
        fi
        if [ -n "$(git -C "$wt" status --porcelain)" ]; then
            echo "  KEEP: the worktree $wt is dirty"
            return 1
        fi
        if claude_lock "$wt"; then
            act "the Claude Code lock of worktree $wt" g worktree unlock "$wt" || return 1
        fi
        act "worktree $wt" g worktree remove "$wt" || return 1
    fi
    if [ "$local_branch" -eq 1 ]; then
        act "local branch $b" g branch -D "$b" || return 1
    fi
    if [ "$remote_branch" -eq 1 ]; then
        if [ "$closed" -eq 1 ]; then
            echo "  origin/$b has no commits outside origin/main"
            act "remote branch origin/$b" g push --quiet origin --delete "$b" || return 1
        elif g merge-base --is-ancestor "refs/remotes/origin/$b" origin/main; then
            act "remote branch origin/$b" g push --quiet origin --delete "$b" || return 1
        else
            echo "  KEEP: origin/$b is not an ancestor of origin/main"
            return 1
        fi
    else
        echo "  the remote branch is already gone"
    fi
    return 0
}

kept=0
for b in "${branches[@]}"; do
    clean_one "$b" || kept=$((kept + 1))
done
[ "$apply" -eq 1 ] || echo "dry run; pass --apply to act"
if [ "$kept" -ne 0 ]; then
    echo "cleanup-merged: kept or failed $kept of ${#branches[@]} branch(es)"
    exit 1
fi
