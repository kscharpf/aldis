#!/usr/bin/env bash
# Build a merge train: one branch off origin/main into which the heads of several reviewed pull
# requests are merged, opened as one pull request and verified once (docs/process/coordinator.md,
# "Merge trains").
#
# Usage: scripts/train --plan <pr>...                        preflight: do they merge? (below)
#        scripts/train [--dry-run] [--allow-open-train] <pr>...
#                                                            build a train from the PRs, in order
#        scripts/train [--dry-run] --rebuild <train-pr> --without <pr>...
#                                                            build it again without those PRs
# Only the maintainer assigns PRs to trains (coordinator.md): run this only for PRs and an order
# the maintainer named. A second train must not overlap the first, so a real build refuses while
# another `train/*` PR is open (the one --rebuild replaces excepted); `--allow-open-train` is the
# override, for use when the maintainer names it. --dry-run is not refused.
# Readiness: every PR must be `READY FOR TRAIN` by `scripts/pr-status --train` (open, not a
# draft, reviewed, the review answered by a reply that names the head, no force-push after the
# reply, no label `needs-maintainer`);
# the script refuses any other, naming the verdict, and merges the exact head SHA it checked,
# not the branch tip: a push between the check and the merge refuses the PR.
# A stacked PR (its base branch is not main) is refused unless the PR of its base branch is
# earlier in the same train: it rides the train after its base (roadmap §6 rule 10).
# Build: fetch; a worktree `.claude/worktrees/train/<date>-<n>` on the new branch
# `train/<YYYY-MM-DD>-<n>` (n: one more than the train PRs of today in any state, or the live
# train branches of today if more) off
# origin/main; per PR in the order given, a merge commit `Merge pull request #<pr> from
# <owner>/<branch>` whose body is the PR title (the form GitHub writes, so that `cargo xtask
# changelog` reads it); push; a PR titled `chore(train): <date>-<n>, #<pr> ...` whose body
# (docs/process/pr-body.md) lists the constituent PRs with titles and links.
# A conflict stops the build: the merge is undone, nothing is pushed, the script names the PR
# that conflicts and exits 1. That PR is the later one in the agreed order: leave it out and
# return it to its owner.
# --rebuild: the constituents are the `- #<n>` lines of the Summary of the train PR, in order,
# without the PRs named by --without; the old train PR is closed with a comment naming the new
# one (a failed train is dropped, never force-pushed over).
# --dry-run: builds and merges in the worktree, pushes and opens nothing, says so, and removes
# the branch and the worktree again (also when the build fails), so that a real run with the
# same PRs follows it.
# A failure after the push (`gh pr create`) deletes the pushed branch and the worktree.
# A conflict that is only in lockfiles (Cargo.lock of the root, refapp/, exerciser/, fuzz/,
# crosscheck/) does not stop the build: the script takes the side already in the train, runs
# `cargo metadata --offline` in that workspace (it adds what the merged manifests need and upgrades
# nothing already locked there; no network), checks the result with `--locked`, and compares
# package versions: a (name, version) that the PR's lock introduced against the merge base and the
# result lacks, such as a deliberate `cargo update`, makes the PR a conflict (named on stderr,
# merge undone, as below). Otherwise it commits the merge and prints `#<pr>: <path> regenerated`.
# Any other conflict stops as above.
# After the merges the script checks every lockfile against the merged manifests
# (`cargo metadata --locked --offline` in the root, refapp/, exerciser/, fuzz/, crosscheck/; a
# merged result can have a stale lock though nothing conflicted: one PR changes a Cargo.toml,
# another carries the lock). A stale lock is regenerated, committed on the train branch as
# `chore(train): regenerate <path> ...`, and named in a line, followed by the (name, version)
# pairs of the old lock that the new one lacks (not compared with each constituent's lock). A
# workspace cargo cannot read offline is left as merged and named.
# --plan: the preflight, before the maintainer is asked to assign a train. No worktree, no push,
# no readiness check, seconds: for the exact head of each PR it trial-merges (`git merge-tree`)
# into origin/main and reports the conflicted paths; then merges the PRs cumulatively in the
# order given and names each PR that conflicts, with what it conflicts with (origin/main, or the
# earlier PRs it conflicts with alone); that PR is left out of the rest of the plan, and the
# first one named is where a build would stop. It prints a pairwise matrix (X: the two heads
# conflict), and checks the lockfiles of the merged result in a temporary export (`lockfile needs
# regenerating: <path>`, with the versions the regeneration drops; informational: the build
# regenerates it). A lockfile-only conflict is reported as `lock` and is not a conflict, unless
# the PR bumped a package the base already locks and the other side lacks that version (without
# cargo, only bumps can be told from new dependencies); then it is a conflict, as in the build.
# Exit status 1 when any other conflict exists.
# Exit status: 0 on success, 1 on a conflict or a PR that cannot ride, 2 on a usage error or
# when git or gh fails.
set -euo pipefail

marker='🤖 Generated with [Claude Code](https://claude.com/claude-code)'
export NO_COLOR=1 GH_FORCE_TTY=0 GH_NO_UPDATE_NOTIFIER=1

usage() {
    awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
    exit 2
}

joined() { # joined <n>...: "#1, #2"
    local out
    out="$(printf ', #%s' "$@")"
    printf '%s' "${out#, }"
}

dry=0 allow_open=0 plan=0 rebuild="" prs=() without=()
while [ $# -gt 0 ]; do
    case "$1" in
    --dry-run) dry=1 ;;
    --allow-open-train) allow_open=1 ;;
    --plan) plan=1 ;;
    --rebuild)
        [ $# -ge 2 ] || usage
        rebuild="$2"
        shift
        ;;
    --without)
        [ $# -ge 2 ] || usage
        without+=("$2")
        shift
        ;;
    -h | --help) usage ;;
    -*) usage ;;
    *) prs+=("$1") ;;
    esac
    shift
done
for n in ${prs[@]+"${prs[@]}"} ${without[@]+"${without[@]}"} ${rebuild:+"$rebuild"}; do
    [[ $n =~ ^[0-9]+$ ]] || { echo "not a PR number: $n" >&2; exit 2; }
done
if [ "$plan" -eq 1 ]; then
    { [ ${#prs[@]} -gt 0 ] && [ ${#without[@]} -eq 0 ] && [ -z "$rebuild" ] &&
        [ "$dry" -eq 0 ] && [ "$allow_open" -eq 0 ]; } || usage
elif [ -n "$rebuild" ]; then
    { [ ${#prs[@]} -eq 0 ] && [ ${#without[@]} -gt 0 ]; } || usage
elif [ ${#prs[@]} -eq 0 ] || [ ${#without[@]} -gt 0 ]; then
    usage
fi

main_checkout="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
g() { git -C "$main_checkout" "$@"; }

g fetch --quiet origin
die2() { echo "$*" >&2; exit 2; }

# conflicts <a> <b>: trial-merge commit b into a with no worktree. Sets `mt_tree` (the merged
# tree, with conflict markers in the conflicted files) and `mt_paths` (the conflicted paths,
# space separated, empty when clean). Returns 2 when git fails.
conflicts() {
    local out rc=0
    out="$(g merge-tree --write-tree --name-only --no-messages "$1" "$2" 2>/dev/null)" || rc=$?
    [ "$rc" -le 1 ] || return 2
    mt_tree="$(printf '%s\n' "$out" | sed -n '1p')"
    mt_paths="$(printf '%s\n' "$out" | sed '1d' | grep . | paste -sd ' ' - || true)"
}
is_lockfile() { [[ $1 =~ ^((refapp|exerciser|fuzz|crosscheck)/)?Cargo\.lock$ ]]; }
only_lockfiles() { # only_lockfiles <paths, space separated>: true when all are lockfiles
    local p
    [ -n "$1" ] || return 1
    for p in $1; do is_lockfile "$p" || return 1; done
}
verdict() { # verdict <paths>: "clean", "lock" (lockfiles only) or "conflict"
    if [ -z "$1" ]; then
        echo clean
    elif only_lockfiles "$1"; then
        echo lock
    else
        echo conflict
    fi
}

# lock_pairs <file>: the `name version` of every package of a Cargo.lock, sorted.
lock_pairs() {
    awk '/^name = /{n=$3; gsub(/"/,"",n)} /^version = /{v=$3; gsub(/"/,"",v); print n " " v}' \
        "$1" | sort -u
}
# lost_versions <base> <theirs> <result> <bumps only: 0|1>: the `name version` pairs that the
# PR's side (theirs) introduced against the merge base and the result lacks, one line each. With
# bumps only, a pair counts only when the base has the package under another version (a bump,
# not a new dependency, whose version a regeneration picks).
lost_versions() {
    comm -13 <(lock_pairs "$1") <(lock_pairs "$2") | {
        if [ "$4" = 1 ]; then
            awk 'NR == FNR { seen[$1] = 1; next } ($1 in seen)' <(lock_pairs "$1") -
        else
            cat
        fi
    } | comm -23 - <(lock_pairs "$3")
}
blob() { # blob <git dir> <spec> <out>: the file at <spec> (rev:path or :stage:path), else empty
    git -C "$1" show "$2" >"$3" 2>/dev/null || : >"$3"
}
# classify <a> <b>: `conflicts`, then sets `mt_v` to clean, lock (only lockfiles conflict and
# no version b introduced into them is lost) or conflict. For a lockfile conflict it compares
# against a: a version bump of b that a lacks would be lost by the build's regeneration, so it
# is a conflict, named in `mt_paths`. (The build also checks new dependencies; this needs cargo.)
classify() {
    local p mb tmp lost out=""
    conflicts "$1" "$2" || return 2
    mt_v="$(verdict "$mt_paths")"
    [ "$mt_v" = lock ] || return 0
    mb="$(g merge-base "$1" "$2")" || return 2
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/train-lock.XXXXXX")" || return 2
    for p in $mt_paths; do
        blob "$main_checkout" "$mb:$p" "$tmp/base"
        blob "$main_checkout" "$2:$p" "$tmp/theirs"
        blob "$main_checkout" "$1:$p" "$tmp/ours"
        lost="$(lost_versions "$tmp/base" "$tmp/theirs" "$tmp/ours" 1 | paste -sd, - |
            sed 's/ /@/g; s/,/, /g')"
        [ -z "$lost" ] || out+="${out:+; }$p: version bump lost ($lost)"
    done
    rm -rf "$tmp"
    if [ -n "$out" ]; then mt_v=conflict mt_paths="$mt_paths [$out]"; fi
}

LOCKDIRS=(. refapp exerciser fuzz crosscheck)
# stale_locks <dir>: print the workspaces of the tree in <dir> whose Cargo.lock does not satisfy
# its manifests offline: `cargo metadata --locked --offline` fails, and `cargo metadata
# --offline` then changes the lockfile (it adds what the manifests need and upgrades nothing).
# The lockfile is left regenerated; a line `!<path>: <name version>...` names the packages of
# the old lock that the new one lacks (changed or dropped versions). A workspace that cannot be
# read offline at all prints `?<path>`: no verdict, its lockfile restored.
stale_locks() {
    local dir="$1" w lock rel changed
    for w in "${LOCKDIRS[@]}"; do
        lock="$dir/$w/Cargo.lock"
        [ -f "$lock" ] || continue
        (cd "$dir/$w" && cargo metadata --locked --offline --format-version 1 >/dev/null 2>&1) &&
            continue
        cp "$lock" "$lock.before"
        if [ "$w" = . ]; then rel=Cargo.lock; else rel="$w/Cargo.lock"; fi
        if (cd "$dir/$w" && cargo metadata --offline --format-version 1 >/dev/null 2>&1) &&
            ! cmp -s "$lock" "$lock.before"; then
            echo "$rel"
            changed="$(comm -23 <(lock_pairs "$lock.before") <(lock_pairs "$lock") |
                sed 's/ /@/' | paste -sd' ' -)"
            [ -z "$changed" ] || echo "!$rel: versions of the old lock not in the new one: $changed"
            rm -f "$lock.before"
        else
            mv "$lock.before" "$lock"
            echo "?$w"
        fi
    done
}

if [ "$plan" -eq 1 ]; then
    planned=() shas=() bad=0
    for n in "${prs[@]}"; do
        info="$(gh pr view "$n" --json headRefName,headRefOid --jq '[.headRefName, .headRefOid]
            | @tsv')" || die2 "#$n: gh could not read the pull request"
        IFS=$'\t' read -r branch sha <<<"$info"
        g fetch --quiet origin "$branch" || die2 "#$n: cannot fetch $branch"
        [ "$(g rev-parse FETCH_HEAD)" = "$sha" ] ||
            die2 "#$n: $branch moved while it was read: run again"
        planned+=("$n") shas+=("$sha")
    done
    export GIT_AUTHOR_NAME=plan GIT_AUTHOR_EMAIL=plan@localhost
    export GIT_COMMITTER_NAME=plan GIT_COMMITTER_EMAIL=plan@localhost
    echo "origin/main $(g rev-parse --short origin/main)"
    echo "against origin/main:"
    for i in "${!planned[@]}"; do
        classify origin/main "${shas[i]}" || die2 "#${planned[i]}: git merge-tree failed"
        v="$mt_v"
        echo "  #${planned[i]} ${shas[i]:0:7}: $v${mt_paths:+ ($mt_paths)}"
        [ "$v" != conflict ] || bad=1
    done
    echo "cumulative, in the order given:"
    cur="$(g rev-parse origin/main)"
    kept=()
    for i in "${!planned[@]}"; do
        classify "$cur" "${shas[i]}" || die2 "#${planned[i]}: git merge-tree failed"
        v="$mt_v"
        if [ "$v" = conflict ]; then
            # Who is it? origin/main alone, else each kept PR it conflicts with alone.
            who=""
            classify origin/main "${shas[i]}" || die2 "git merge-tree failed"
            [ "$mt_v" != conflict ] || who="origin/main"
            for k in ${kept[@]+"${kept[@]}"}; do
                classify "${shas[k]}" "${shas[i]}" || die2 "git merge-tree failed"
                [ "$mt_v" != conflict ] || who+="${who:+, }#${planned[k]}"
            done
            classify "$cur" "${shas[i]}" || die2 "git merge-tree failed"
            echo "  #${planned[i]}: conflicts with ${who:-the combination of earlier PRs}" \
                "($mt_paths); left out of the rest of this plan"
            bad=1
            continue
        fi
        cur="$(g commit-tree "$mt_tree" -p "$cur" -p "${shas[i]}" -m "plan #${planned[i]}")" ||
            die2 "#${planned[i]}: cannot write the trial merge"
        kept+=("$i")
        echo "  #${planned[i]}: $v${mt_paths:+ ($mt_paths)}"
    done
    echo "pairwise (X: the two heads conflict, l: lockfile only):"
    row="      "
    for n in "${planned[@]}"; do row+="$(printf '%-7s' "#$n")"; done
    echo "$row"
    for i in "${!planned[@]}"; do
        row="$(printf '%-6s' "#${planned[i]}")"
        for j in "${!planned[@]}"; do
            if [ "$i" -eq "$j" ]; then
                cell="-"
            else
                classify "${shas[i]}" "${shas[j]}" || die2 "git merge-tree failed"
                case "$mt_v" in
                clean) cell="." ;;
                lock) cell="l" ;;
                *) cell="X" ;;
                esac
            fi
            row+="$(printf '%-7s' " $cell")"
        done
        echo "$row"
    done
    for i in "${!planned[@]}"; do
        for ((j = i + 1; j < ${#planned[@]}; j++)); do
            classify "${shas[i]}" "${shas[j]}" || die2 "git merge-tree failed"
            [ "$mt_v" != conflict ] ||
                echo "  #${planned[i]} x #${planned[j]}: $mt_paths"
        done
    done
    scratch="$(mktemp -d "${TMPDIR:-/tmp}/train-plan.XXXXXX")" || die2 "cannot make a temp dir"
    trap 'rm -rf "$scratch"' EXIT
    if g archive "$cur" | tar -x -C "$scratch"; then
        while IFS= read -r l; do
            case "$l" in
            "") ;;
            \?*) echo "lockfile not checked (cargo cannot read ${l#?} offline)" ;;
            !*) echo "  ${l#!}" ;;
            *) echo "lockfile needs regenerating: $l" ;;
            esac
        done < <(stale_locks "$scratch")
    fi
    if [ "$bad" -eq 0 ]; then echo "plan: no conflict"; exit 0; fi
    echo "plan: conflicts" >&2
    exit 1
fi

if [ "$dry" -eq 0 ] && [ "$allow_open" -eq 0 ]; then
    open_trains="$(gh pr list --state open --limit 200 --json number,headRefName \
        --jq "[.[] | select((.headRefName | startswith(\"train/\"))
            and (.number | tostring) != \"${rebuild:-0}\") | \"#\" + (.number | tostring)]
            | join(\" \")")" || { echo "gh could not list the open pull requests" >&2; exit 2; }
    [ -z "$open_trains" ] || {
        echo "train PR $open_trains is open: only the maintainer assigns PRs to trains and a" \
            "second train must not overlap it; pass --allow-open-train when the maintainer" \
            "names it" >&2
        exit 1
    }
fi

if [ -n "$rebuild" ]; then
    body="$(gh pr view "$rebuild" --json body --jq .body)" ||
        { echo "#$rebuild: gh could not read the train PR" >&2; exit 2; }
    while IFS= read -r n; do
        skip=0
        for w in ${without[@]+"${without[@]}"}; do
            [ "$w" != "$n" ] || skip=1
        done
        [ "$skip" -eq 1 ] || prs+=("$n")
    done < <(printf '%s\n' "$body" | sed -n 's/^- #\([0-9][0-9]*\) .*/\1/p')
    [ ${#prs[@]} -gt 0 ] || { echo "#$rebuild lists no constituent PR left" >&2; exit 1; }
fi

here="$(cd "$(dirname "$0")" && pwd)"
head_of() { # head_of <pr>: the head commit of a PR
    gh pr view "$1" --json headRefOid --jq .headRefOid
}

# Per PR: number, head SHA, head ref name, owner, title; refuse one that is not ready.
heads=() branches=() owners=() titles=()
for n in "${prs[@]}"; do
    sha="$(head_of "$n")" || die2 "#$n: gh could not read the pull request"
    info="$(gh pr view "$n" --json headRefName,baseRefName,headRepositoryOwner,title \
        --jq '[.headRefName, .baseRefName, .headRepositoryOwner.login, .title] | @tsv')" ||
        die2 "#$n: gh could not read the pull request"
    IFS=$'\t' read -r branch base owner title <<<"$info"
    case "$branch" in train/*) echo "#$n is a train PR, not a constituent" >&2; exit 1 ;; esac
    # A stacked PR (base branch other than main) rides after the PR it is stacked on.
    if [ "$base" != main ]; then
        below=0
        for b in ${branches[@]+"${branches[@]}"}; do
            [ "$b" != "$base" ] || below=1
        done
        [ "$below" -eq 1 ] || {
            echo "#$n is stacked on $base, whose PR is not earlier in this train: put it" \
                "after its base PR, or wait until the base has merged" >&2
            exit 1
        }
    fi
    verdict="$("$here/pr-status" --train "$n" 2>/dev/null | grep -E "^#$n: (READY|NOT READY)" |
        tail -n 1)" || verdict=""
    if [ "$verdict" != "#$n: READY FOR TRAIN" ]; then
        echo "#$n cannot ride a train: ${verdict:-no verdict from scripts/pr-status --train}" >&2
        exit 1
    fi
    [ "$(head_of "$n")" = "$sha" ] ||
        { echo "#$n was pushed during the check: run again" >&2; exit 1; }
    g fetch --quiet origin "$branch" || die2 "#$n: cannot fetch $branch"
    [ "$(g rev-parse FETCH_HEAD)" = "$sha" ] ||
        { echo "#$n: $branch is not at the checked head ${sha:0:7}: run again" >&2; exit 1; }
    heads+=("$sha") branches+=("$branch") owners+=("$owner") titles+=("$title")
done

date="$(date -u +%Y-%m-%d)"
# The next number: train PRs of the date in any state (a merged train's branch is deleted),
# or the live train branches of the date, whichever is more.
prs_today="$(gh pr list --state all --limit 200 --json headRefName \
    --jq "[.[] | select(.headRefName | startswith(\"train/$date-\"))] | length")" ||
    die2 "gh could not list the pull requests"
live="$(g ls-remote --heads origin "refs/heads/train/$date-*" | wc -l | tr -d ' ')"
taken=$((prs_today > live ? prs_today : live))
name="$date-$((taken + 1))"
tbranch="train/$name"
wt="$main_checkout/.claude/worktrees/train/$name"

g worktree add --quiet -b "$tbranch" "$wt" origin/main || die2 "cannot add the worktree"
cleanup() {
    g worktree remove --force "$wt" 2>/dev/null || true
    g branch -D "$tbranch" >/dev/null 2>&1 || true
}
# resolve_lockfiles <worktree>: finish a conflicted merge when every conflicted path is a
# lockfile. The side already in the train is kept (it holds the versions accepted so far), then
# `cargo metadata --offline` adds what the merged manifests need: cargo changes a lockfile only
# where a manifest requires it, never upgrades a locked version, and --offline forbids the
# network, so the result follows from the merged manifests and the kept side alone. `--locked`
# then proves the lockfile is complete. A package version that the PR's side introduced against the
# merge base (`:3:` against `:1:`) and the result lacks, such as a deliberate `cargo update`, is
# a conflict: it is named on stderr and the merge is left for the caller to abort. Returns 1,
# merge left in place, on that and on anything else.
resolve_lockfiles() {
    local wt="$1" paths p dir tmp lost
    paths="$(git -C "$wt" diff --name-only --diff-filter=U)"
    [ -n "$paths" ] || return 1
    while IFS= read -r p; do is_lockfile "$p" || return 1; done <<<"$paths"
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/train-lock.XXXXXX")" || return 1
    while IFS= read -r p; do
        dir="$(dirname "$p")"
        blob "$wt" ":1:$p" "$tmp/base"
        blob "$wt" ":3:$p" "$tmp/theirs"
        git -C "$wt" checkout --ours -- "$p" || { rm -rf "$tmp"; return 1; }
        (cd "$wt/$dir" && cargo metadata --offline --format-version 1 >/dev/null) ||
            { rm -rf "$tmp"; return 1; }
        (cd "$wt/$dir" && cargo metadata --offline --locked --format-version 1 >/dev/null) ||
            { rm -rf "$tmp"; return 1; }
        lost="$(lost_versions "$tmp/base" "$tmp/theirs" "$wt/$p" 0 | sed 's/ /@/' | paste -sd' ' -)"
        if [ -n "$lost" ]; then
            echo "#$2: $p: versions the PR locked are not in the regenerated lock ($lost):" \
                "a lockfile change that is lost is a conflict" >&2
            rm -rf "$tmp"
            return 1
        fi
        git -C "$wt" add -- "$p" || { rm -rf "$tmp"; return 1; }
        echo "#$2: $p regenerated with cargo metadata --offline after a lockfile conflict;" \
            "every version the PR locked is in the result; check the diff of the train"
    done <<<"$paths"
    rm -rf "$tmp"
    git -C "$wt" commit -q --no-edit
}

for i in "${!prs[@]}"; do
    n="${prs[i]}"
    if ! git -C "$wt" merge --no-ff --quiet \
        -m "Merge pull request #$n from ${owners[i]}/${branches[i]}" -m "${titles[i]}" \
        "${heads[i]}" >/dev/null 2>&1 && ! resolve_lockfiles "$wt" "$n"; then
        git -C "$wt" merge --abort 2>/dev/null || true
        cleanup
        echo "#$n conflicts with origin/main or an earlier PR of the train" \
            "($(printf '#%s ' "${prs[@]:0:i}")): leave it out and return it to its owner" >&2
        exit 1
    fi
done

while IFS= read -r l; do
    case "$l" in
    "") ;;
    \?*) echo "lockfile not checked (cargo cannot read ${l#?} offline); left as merged," \
        "verify decides" ;;
    !*) echo "  ${l#!}" ;;
    *)
        git -C "$wt" add -- "$l" || { cleanup; die2 "cannot stage $l"; }
        git -C "$wt" commit -q -m "chore(train): regenerate $l for the merged manifests" \
            -m "cargo metadata --offline; the versions it dropped are named in the build output." ||
            { cleanup; die2 "cannot commit $l"; }
        echo "$l was stale after the merges: regenerated with cargo metadata --offline and" \
            "committed on $tbranch"
        ;;
    esac
done < <(stale_locks "$wt")

if [ "$dry" -eq 1 ]; then
    short="$(git -C "$wt" rev-parse --short HEAD)" || { cleanup; die2 "cannot read the build"; }
    cleanup
    echo "dry run: $tbranch built at $short with $(joined "${prs[@]}");" \
        "nothing pushed, no PR opened; branch and worktree removed again"
    exit 0
fi

git -C "$wt" push --quiet -u origin "$tbranch" || { cleanup; die2 "cannot push $tbranch"; }

repo="$(gh repo view --json url --jq .url)" || {
    g push --quiet origin --delete "$tbranch" || true
    cleanup
    die2 "gh could not read the repository; $tbranch deleted again"
}
list=""
for i in "${!prs[@]}"; do
    list+="- #${prs[i]} [${titles[i]}]($repo/pull/${prs[i]})"$'\n'
done
body="## Summary

Merge train $name: one verify run for these reviewed pull requests, merged in this order. Each
keeps its own review and reply ([coordinator.md](docs/process/coordinator.md), Merge trains).

${list}
## Evidence

The verify record of this head, \`cargo xtask verify check <head>\`, is the evidence for every
constituent. Reviews: each constituent pull request.

## Merge Danger

Merge with a merge commit, never squash or rebase: \`cargo xtask changelog\` reads the
constituents from the merges between the first and the second parent of the merge commit.
The constituents become merged when this one does; a
failure drops the pull request that caused it and rebuilds the train
(\`scripts/train --rebuild <this PR> --without <PR>\`).

$marker"
title="chore(train): $name, $(joined "${prs[@]}")"
url="$(gh pr create --base main --head "$tbranch" --title "$title" --body "$body")" || {
    g push --quiet origin --delete "$tbranch" || true
    cleanup
    die2 "gh could not open the train PR; $tbranch deleted again"
}
echo "train $name: $url"
if [ -n "$rebuild" ]; then
    gh pr close "$rebuild" --comment "Replaced by $url, rebuilt without $(joined "${without[@]}").

$marker" >/dev/null
    echo "closed #$rebuild"
fi
git -C "$wt" status --short >/dev/null
g worktree remove --force "$wt"
