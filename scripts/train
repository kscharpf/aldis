#!/usr/bin/env bash
# Build a merge train: one branch off origin/main into which the heads of several reviewed pull
# requests are merged, opened as one pull request and verified once (docs/process/coordinator.md,
# "Merge trains").
#
# Usage: scripts/train [--dry-run] <pr>...                   build a train from the PRs, in order
#        scripts/train [--dry-run] --rebuild <train-pr> --without <pr>...
#                                                            build it again without those PRs
# Build: fetch; a worktree `.claude/worktrees/train/<date>-<n>` on the new branch
# `train/<YYYY-MM-DD>-<n>` (n: one more than the train branches of today on origin) off
# origin/main; per PR in the order given, a merge commit `Merge pull request #<pr> from
# <owner>/<branch>` whose body is the PR title (the form GitHub writes, so that `cargo xtask
# changelog` reads it); push; a PR titled `chore(train): <date>-<n>, #<pr> ...` whose body
# (docs/process/pr-body.md) lists the constituent PRs with titles and links.
# A conflict stops the build: the merge is undone, nothing is pushed, the script names the PR
# that conflicts and exits 1. That PR is the later one in the agreed order: leave it out and
# return it to its owner.
# --rebuild: the constituents are the `- #<n>` lines of the Summary of the train PR, in order,
# without the PRs named by --without; the old train PR is closed with a comment naming the new
# one (a failed train is dropped, never force-pushed over).
# --dry-run: builds and merges in the worktree, pushes and opens nothing, and says so.
# Each PR must be OPEN and not a draft; whether it is ready is `scripts/pr-status`.
# Exit status: 0 on success, 1 on a conflict or a PR that cannot ride, 2 on a usage error or
# when git or gh fails.
set -euo pipefail

marker='🤖 Generated with [Claude Code](https://claude.com/claude-code)'
export NO_COLOR=1 GH_FORCE_TTY=0 GH_NO_UPDATE_NOTIFIER=1

usage() {
    awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
    exit 2
}

joined() { # joined <n>...: "#1, #2"
    local out
    out="$(printf ', #%s' "$@")"
    printf '%s' "${out#, }"
}

dry=0 rebuild="" prs=() without=()
while [ $# -gt 0 ]; do
    case "$1" in
    --dry-run) dry=1 ;;
    --rebuild)
        [ $# -ge 2 ] || usage
        rebuild="$2"
        shift
        ;;
    --without)
        [ $# -ge 2 ] || usage
        without+=("$2")
        shift
        ;;
    -h | --help) usage ;;
    -*) usage ;;
    *) prs+=("$1") ;;
    esac
    shift
done
for n in ${prs[@]+"${prs[@]}"} ${without[@]+"${without[@]}"} ${rebuild:+"$rebuild"}; do
    [[ $n =~ ^[0-9]+$ ]] || { echo "not a PR number: $n" >&2; exit 2; }
done
if [ -n "$rebuild" ]; then
    { [ ${#prs[@]} -eq 0 ] && [ ${#without[@]} -gt 0 ]; } || usage
elif [ ${#prs[@]} -eq 0 ] || [ ${#without[@]} -gt 0 ]; then
    usage
fi

main_checkout="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
g() { git -C "$main_checkout" "$@"; }

g fetch --quiet origin

if [ -n "$rebuild" ]; then
    body="$(gh pr view "$rebuild" --json body --jq .body)" ||
        { echo "#$rebuild: gh could not read the train PR" >&2; exit 2; }
    while IFS= read -r n; do
        skip=0
        for w in ${without[@]+"${without[@]}"}; do
            [ "$w" != "$n" ] || skip=1
        done
        [ "$skip" -eq 1 ] || prs+=("$n")
    done < <(printf '%s\n' "$body" | sed -n 's/^- #\([0-9][0-9]*\) .*/\1/p')
    [ ${#prs[@]} -gt 0 ] || { echo "#$rebuild lists no constituent PR left" >&2; exit 1; }
fi

# Per PR: number, head ref name, owner, title; refuse one that cannot ride.
heads=() branches=() owners=() titles=()
for n in "${prs[@]}"; do
    info="$(gh pr view "$n" --json state,isDraft,headRefName,headRepositoryOwner,title \
        --jq '[.state, (.isDraft|tostring), .headRefName, .headRepositoryOwner.login, .title]
              | @tsv')" || { echo "#$n: gh could not read the pull request" >&2; exit 2; }
    IFS=$'\t' read -r state draft branch owner title <<<"$info"
    if [ "$state" != OPEN ] || [ "$draft" = true ]; then
        echo "#$n cannot ride a train: it is $state$([ "$draft" = true ] && echo ', a draft')" >&2
        exit 1
    fi
    case "$branch" in train/*) echo "#$n is a train PR, not a constituent" >&2; exit 1 ;; esac
    g fetch --quiet origin "$branch"
    heads+=("$(g rev-parse FETCH_HEAD)")
    branches+=("$branch") owners+=("$owner") titles+=("$title")
done

date="$(date -u +%Y-%m-%d)"
taken="$(g ls-remote --heads origin "refs/heads/train/$date-*" | wc -l | tr -d ' ')"
name="$date-$((taken + 1))"
tbranch="train/$name"
wt="$main_checkout/.claude/worktrees/train/$name"

g worktree add --quiet -b "$tbranch" "$wt" origin/main
cleanup() {
    g worktree remove --force "$wt" 2>/dev/null || true
    g branch -D "$tbranch" >/dev/null 2>&1 || true
}
for i in "${!prs[@]}"; do
    n="${prs[i]}"
    if ! git -C "$wt" merge --no-ff --quiet \
        -m "Merge pull request #$n from ${owners[i]}/${branches[i]}" -m "${titles[i]}" \
        "${heads[i]}" >/dev/null 2>&1; then
        git -C "$wt" merge --abort 2>/dev/null || true
        cleanup
        echo "#$n conflicts with origin/main or an earlier PR of the train" \
            "($(printf '#%s ' "${prs[@]:0:i}")): leave it out and return it to its owner" >&2
        exit 1
    fi
done

if [ "$dry" -eq 1 ]; then
    echo "dry run: $tbranch built at $(git -C "$wt" rev-parse --short HEAD) with $(joined "${prs[@]}");" \
        "nothing pushed, no PR opened; worktree $wt"
    exit 0
fi

git -C "$wt" push --quiet -u origin "$tbranch"

repo="$(gh repo view --json url --jq .url)"
list=""
for i in "${!prs[@]}"; do
    list+="- #${prs[i]} [${titles[i]}]($repo/pull/${prs[i]})"$'\n'
done
body="## Summary

Merge train $name: one verify run for these reviewed pull requests, merged in this order. Each
keeps its own review and reply ([coordinator.md](docs/process/coordinator.md), Merge trains).

${list}
## Evidence

The verify record of this head, \`cargo xtask verify check <head>\`, is the evidence for every
constituent. Reviews: each constituent pull request.

## Merge Danger

Merge with a merge commit, never squash or rebase: \`cargo xtask changelog\` reads the
constituents from the second parent. The constituents become merged when this one does; a
failure drops the pull request that caused it and rebuilds the train
(\`scripts/train --rebuild <this PR> --without <PR>\`).

$marker"
title="chore(train): $name, $(joined "${prs[@]}")"
url="$(gh pr create --base main --head "$tbranch" --title "$title" --body "$body")"
echo "train $name: $url"
if [ -n "$rebuild" ]; then
    gh pr close "$rebuild" --comment "Replaced by $url, rebuilt without $(joined "${without[@]}").

$marker" >/dev/null
    echo "closed #$rebuild"
fi
git -C "$wt" status --short >/dev/null
g worktree remove --force "$wt"
