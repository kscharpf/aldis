{
  "kind": "codec",
  "standard": "Bit numbering convention common to all v1 Blue Books (e.g. 133.0-B-2 \u00a71.6.3)",
  "provenance": "hand-derived",
  "provenance_note": "Bit 0 is the first transmitted bit and the MSB; values computed by big-integer shifting in an independent Python reference.",
  "cases": [
    {
      "id": "bits-get-spp-version",
      "requirements": [
        "GEN-050",
        "GEN-051"
      ],
      "description": "Space Packet version (bits 0-2)",
      "operation": "bits_get",
      "input_hex": "0001C0000000AB",
      "params": {
        "bit_offset": 0,
        "width": 3
      },
      "expect": {
        "ok": true,
        "value": 0
      }
    },
    {
      "id": "bits-get-spp-type",
      "requirements": [
        "GEN-050",
        "GEN-051"
      ],
      "description": "Packet type (bit 3)",
      "operation": "bits_get",
      "input_hex": "0001C0000000AB",
      "params": {
        "bit_offset": 3,
        "width": 1
      },
      "expect": {
        "ok": true,
        "value": 0
      }
    },
    {
      "id": "bits-get-spp-shf",
      "requirements": [
        "GEN-050",
        "GEN-051"
      ],
      "description": "Secondary header flag (bit 4)",
      "operation": "bits_get",
      "input_hex": "0001C0000000AB",
      "params": {
        "bit_offset": 4,
        "width": 1
      },
      "expect": {
        "ok": true,
        "value": 0
      }
    },
    {
      "id": "bits-get-spp-apid",
      "requirements": [
        "GEN-050",
        "GEN-051"
      ],
      "description": "APID (bits 5-15)",
      "operation": "bits_get",
      "input_hex": "0001C0000000AB",
      "params": {
        "bit_offset": 5,
        "width": 11
      },
      "expect": {
        "ok": true,
        "value": 1
      }
    },
    {
      "id": "bits-get-spp-seqflags",
      "requirements": [
        "GEN-050",
        "GEN-051"
      ],
      "description": "Sequence flags (bits 16-17)",
      "operation": "bits_get",
      "input_hex": "0001C0000000AB",
      "params": {
        "bit_offset": 16,
        "width": 2
      },
      "expect": {
        "ok": true,
        "value": 3
      }
    },
    {
      "id": "bits-get-spp-count",
      "requirements": [
        "GEN-050",
        "GEN-051"
      ],
      "description": "Sequence count (bits 18-31)",
      "operation": "bits_get",
      "input_hex": "0001C0000000AB",
      "params": {
