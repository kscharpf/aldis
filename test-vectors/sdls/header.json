{
  "kind": "codec",
  "standard": "355.0-B-2",
  "provenance": "hand-derived",
  "provenance_note": "Hand-derived from CCSDS 355.0-B-2 §4.1.1 (Security Header: 16-bit SPI, optional IV, SN, Pad Length; SPI 0 and 65535 reserved) and Annex E (14-octet AES-GCM baseline header: 2-octet SPI + 12-octet IV).",
  "cases": [
    {
      "id": "sdls-hdr-decode-baseline-gcm",
      "description": "Decode a 14-octet AES-GCM baseline Security Header (SPI = 1, 12-octet IV).",
      "requirements": ["API-070", "API-071"],
      "operation": "decode_header",
      "config": {"iv_len": 12, "sn_len": 0, "pl_len": 0},
      "input_hex": "000100000000000000000000002A",
      "expect": {"ok": true, "spi": 1, "iv_hex": "00000000000000000000002A", "sn_hex": "", "pad_len_hex": ""}
    },
    {
      "id": "sdls-hdr-decode-reserved-spi-zero",
      "description": "SPI 0 is reserved by 355.0-B-2 §4.1.1.2.3 and rejected with ReservedValue.",
      "requirements": ["API-070"],
      "operation": "decode_header",
      "config": {"iv_len": 12, "sn_len": 0, "pl_len": 0},
      "input_hex": "0000000000000000000000000001",
      "expect": {"ok": false, "error": "ReservedValue", "field": 8}
    },
    {
      "id": "sdls-hdr-decode-reserved-spi-max",
      "description": "SPI 65535 is reserved by 355.0-B-2 §4.1.1.2.3 and rejected with ReservedValue.",
      "requirements": ["API-070"],
      "operation": "decode_header",
      "config": {"iv_len": 12, "sn_len": 0, "pl_len": 0},
      "input_hex": "FFFF000000000000000000000001",
      "expect": {"ok": false, "error": "ReservedValue", "field": 8}
    },
    {
      "id": "sdls-hdr-decode-length-mismatch",
      "description": "A Security Header shorter than 2 + iv_len + sn_len + pl_len fails with LengthMismatch.",
      "requirements": ["API-070"],
      "operation": "decode_header",
      "config": {"iv_len": 12, "sn_len": 0, "pl_len": 0},
      "input_hex": "000100000000",
      "expect": {"ok": false, "error": "LengthMismatch", "field": 8}
    },
    {
      "id": "sdls-hdr-decode-with-sn-and-pl",
      "description": "Decode a Security Header carrying SPI, 4-octet IV, 4-octet SN, and 1-octet Pad Length.",
      "requirements": ["API-070", "API-071"],
      "operation": "decode_header",
      "config": {"iv_len": 4, "sn_len": 4, "pl_len": 1},
      "input_hex": "0102AABBCCDD0000000703",
      "expect": {"ok": true, "spi": 258, "iv_hex": "AABBCCDD", "sn_hex": "00000007", "pad_len_hex": "03"}
    }
  ]
}
