      "requirements": ["LNK-052", "LNK-051"],
      "steps": [
        {"at_us": 1000, "input": {"frame": {"frame_hex": "CC0DE7E0002F00A1A2A33F0020FFFFFFFF6DB6D861451F11F19716723CBE7E00B1DE90B262107AF83494CEE3323F1C0C"}}, "expect": [{"deliver": {"kind": "InsertSdu", "data_hex": "A1A2A3"}}]},
        {"at_us": 2000, "input": {"frame": {"frame_hex": "CC0DE7E0002F0A0028B1B2B33F001A0354BEF5C1528C9BB9ED35FDBC23D9BC2F07576D987881BDF8484501040805F963"}}, "expect": [{"deliver": {"kind": "InsertSdu", "data_hex": "B1B2B3"}}, {"deliver": {"kind": "Ocf", "scope": "mc", "report": "Type1", "ocf_hex": "01040805"}}]},
        {"at_us": 3000, "input": {"frame": {"frame_hex": "CC0DE7E0002F02005AA1A2A33F001ECBCC7F38959BA73E4F69C80256BA6C7B92D4D82D01468B56CF391B3839C7F9CC46"}}, "expect": [{"deliver": {"kind": "InsertSdu", "data_hex": "A1A2A3"}}]},
        {"at_us": 4000, "input": {"query": {"counter": "oid_frames"}}, "expect": [{"counter": {"name": "oid_frames", "value": 3}}]},
        {"at_us": 5000, "input": {"query": {"counter": "gaps"}}, "expect": [{"counter": {"name": "gaps", "value": 0}}]}
