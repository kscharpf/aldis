{
  "kind": "engine-scenario",
  "engine": "map-reassembler",
  "provenance": "hand-derived",
  "provenance_note": "Hand-derived from 232.0-B-4 4.1.3.2, 4.4.1 to 4.4.4 and 04-engines LNK-070, LNK-071, OI-72. Model test-vectors/models/link_recv.py, written blind (TV-023) by a Claude agent from the Blue Books and docs/ only, without reading any implementation; for format only it read the COP-1 model and scenario files (cop1.py, the cop1 directory). The input scripts were chosen by hand; the expected outputs are the model's. Where the documents are silent the model refuses the case (see the README of test-vectors/link/recv/), so no scenario pins a behavior that 04 or the Blue Books leave open. The file is written by the model (--write) and never edited by hand.",
  "config": {"protocol": "tc", "vc": 1, "maps": [{"map": 0, "service": "packets"}, {"map": 1, "service": "sdu"}, {"map": 2, "service": "sdu"}]},
  "scenarios": [
    {
      "id": "link-recv-reassemble-tc-segments",
      "description": "A MAP_SDU in three segments (flags 01, 00, 10) is rebuilt in order and delivered when the last segment arrives; a whole SDU (flags 11) is delivered at once (232.0 4.1.3.2.2.2, Table 4-2, 4.4.2.3).",
      "requirements": ["LNK-070"],
      "steps": [
        {"at_us": 1000, "input": {"fdu": {"vc": 1, "data_hex": "411011121314151617"}}, "expect": []},
        {"at_us": 2000, "input": {"fdu": {"vc": 1, "data_hex": "0118191A1B1C1D1E1F"}}, "expect": []},
        {"at_us": 3000, "input": {"fdu": {"vc": 1, "data_hex": "812021222324"}}, "expect": [{"deliver": {"kind": "Sdu", "vc": 1, "map": 1, "data_hex": "101112131415161718191A1B1C1D1E1F2021222324"}}]},
        {"at_us": 4000, "input": {"fdu": {"vc": 1, "data_hex": "C15051525354"}}, "expect": [{"deliver": {"kind": "Sdu", "vc": 1, "map": 1, "data_hex": "5051525354"}}]}
      ]
    },
    {
      "id": "link-recv-reassemble-tc-maps-interleaved",
      "description": "The Blue Book lets FDUs of different MAPs of a TC VC be multiplexed after any FDU: each MAP is reassembled separately (232.0 4.3.3.1-2, LNK-041).",
      "requirements": ["LNK-070"],
      "steps": [
        {"at_us": 1000, "input": {"fdu": {"vc": 1, "data_hex": "411011121314151617"}}, "expect": []},
        {"at_us": 2000, "input": {"fdu": {"vc": 1, "data_hex": "42606162636465"}}, "expect": []},
        {"at_us": 3000, "input": {"fdu": {"vc": 1, "data_hex": "0118191A1B1C1D1E1F"}}, "expect": []},
        {"at_us": 4000, "input": {"fdu": {"vc": 1, "data_hex": "8270717273"}}, "expect": [{"deliver": {"kind": "Sdu", "vc": 1, "map": 2, "data_hex": "60616263646570717273"}}]},
        {"at_us": 5000, "input": {"fdu": {"vc": 1, "data_hex": "812021222324"}}, "expect": [{"deliver": {"kind": "Sdu", "vc": 1, "map": 1, "data_hex": "101112131415161718191A1B1C1D1E1F2021222324"}}]}
      ]
    },
    {
      "id": "link-recv-reassemble-tc-sequence-violations",
      "description": "A continuation, or a last segment, without a first segment raises SequenceViolation and delivers nothing; a first segment while an SDU is in progress discards the partial SDU, raises SequenceViolation, and begins the new SDU (OI-72); the counter counts the events.",
      "requirements": ["LNK-070"],
      "steps": [
        {"at_us": 1000, "input": {"fdu": {"vc": 1, "data_hex": "0101020304"}}, "expect": [{"reassembly_event": {"kind": "SequenceViolation", "vc": 1, "map": 1}}]},
        {"at_us": 2000, "input": {"fdu": {"vc": 1, "data_hex": "8102030405"}}, "expect": [{"reassembly_event": {"kind": "SequenceViolation", "vc": 1, "map": 1}}]},
        {"at_us": 3000, "input": {"fdu": {"vc": 1, "data_hex": "4103040506"}}, "expect": []},
        {"at_us": 4000, "input": {"fdu": {"vc": 1, "data_hex": "4104050607"}}, "expect": [{"reassembly_event": {"kind": "SequenceViolation", "vc": 1, "map": 1}}]},
        {"at_us": 5000, "input": {"fdu": {"vc": 1, "data_hex": "8105060708"}}, "expect": [{"deliver": {"kind": "Sdu", "vc": 1, "map": 1, "data_hex": "0405060705060708"}}]},
        {"at_us": 6000, "input": {"query": {"counter": "SequenceViolation"}}, "expect": [{"counter": {"name": "SequenceViolation", "value": 3}}]}
      ]
    },
    {
      "id": "link-recv-reassemble-tc-unknown-map",
      "description": "A FDU for a MAP ID that is not configured is discarded with the event UnknownMap (232.0 4.4.3.3); an SDU in progress on a known MAP is not disturbed.",
      "requirements": ["LNK-070"],
      "steps": [
        {"at_us": 1000, "input": {"fdu": {"vc": 1, "data_hex": "411011121314151617"}}, "expect": []},
        {"at_us": 2000, "input": {"fdu": {"vc": 1, "data_hex": "C901020304"}}, "expect": [{"reassembly_event": {"kind": "UnknownMap", "vc": 1, "map": 9}}]},
        {"at_us": 3000, "input": {"fdu": {"vc": 1, "data_hex": "8118191A1B1C1D1E1F2021222324"}}, "expect": [{"deliver": {"kind": "Sdu", "vc": 1, "map": 1, "data_hex": "101112131415161718191A1B1C1D1E1F2021222324"}}]},
        {"at_us": 4000, "input": {"query": {"counter": "UnknownMap"}}, "expect": [{"counter": {"name": "UnknownMap", "value": 1}}]}
      ]
    },
    {
      "id": "link-recv-reassemble-tc-blocked-packets",
      "description": "A FDU of a packet MAP with flags 11 holds several packets and is split into individual packets by the length field of each, Space and Encapsulation Packets mixed (232.0 4.4.1.3); a packet cut into three segments is delivered once, whole.",
      "requirements": ["LNK-071", "LNK-070"],
      "steps": [
        {"at_us": 1000, "input": {"fdu": {"vc": 1, "data_hex": "C00001C0000002010203FD070708090A0B0002C0000005020304050607"}}, "expect": [{"deliver": {"kind": "Packet", "vc": 1, "map": 0, "pvn": 0, "data_hex": "0001C0000002010203", "incomplete": false}}, {"deliver": {"kind": "Packet", "vc": 1, "map": 0, "pvn": 7, "data_hex": "FD070708090A0B", "incomplete": false}}, {"deliver": {"kind": "Packet", "vc": 1, "map": 0, "pvn": 0, "data_hex": "0002C0000005020304050607", "incomplete": false}}]},
        {"at_us": 2000, "input": {"fdu": {"vc": 1, "data_hex": "400003C000001703040506"}}, "expect": []},
        {"at_us": 3000, "input": {"fdu": {"vc": 1, "data_hex": "000708090A0B0C0D0E0F10"}}, "expect": []},
        {"at_us": 4000, "input": {"fdu": {"vc": 1, "data_hex": "801112131415161718191A"}}, "expect": [{"deliver": {"kind": "Packet", "vc": 1, "map": 0, "pvn": 0, "data_hex": "0003C0000017030405060708090A0B0C0D0E0F101112131415161718191A", "incomplete": false}}]}
      ]
    },
    {
      "id": "link-recv-reassemble-tc-reconfigure",
      "description": "Reconfigure discards the SDUs in progress: one Discarded notification with the total number of octets; a later last segment is then a sequence violation.",
      "requirements": ["LNK-003", "LNK-070"],
      "steps": [
        {"at_us": 1000, "input": {"fdu": {"vc": 1, "data_hex": "411011121314151617"}}, "expect": []},
        {"at_us": 2000, "input": {"fdu": {"vc": 1, "data_hex": "420102030405"}}, "expect": []},
        {"at_us": 3000, "input": {"reconfigure": {}}, "expect": [{"notify": {"kind": "Discarded", "octets": 13}}]},
        {"at_us": 4000, "input": {"fdu": {"vc": 1, "data_hex": "8118191A1B1C1D1E1F2021222324"}}, "expect": [{"reassembly_event": {"kind": "SequenceViolation", "vc": 1, "map": 1}}]},
        {"at_us": 5000, "input": {"reconfigure": {}}, "expect": []}
      ]
    }
  ]
}
