{
  "kind": "codec",
  "standard": "301.0-B-4 \u00a73.3-3.5, Annex A",
  "provenance": "hand-derived",
  "provenance_note": "Hand-derived from TIME-033 and docs/standards/time-codes.md \u00a75.2 (D3, OI-18, OI-29). Expected values computed with Python's datetime ordinal arithmetic, independent of the closed-form day conversion in the Rust code.",
  "cases": [
    {
      "id": "time-conv-001",
      "requirements": [
        "TIME-033"
      ],
      "description": "CDS epoch day to CCS month/day",
      "operation": "convert",
      "params": {
        "from": {
          "code": "cds",
          "format": {
            "epoch": "ccsds",
            "day_bits": 16,
            "subms": "none"
          },
          "value": {
            "day": 0,
            "ms_of_day": 0,
            "subms": 0
          }
        },
        "to": {
          "code": "ccs",
          "variation": "month_day",
          "subsecond_octets": 0
        }
      },
      "expect": {
        "ok": true,
        "value": {
          "year": 1958,
          "month": 1,
          "day": 1,
          "day_of_year": null,
          "hour": 0,
          "minute": 0,
          "second": 0,
          "subsecond": 0
        }
      }
    },
    {
      "id": "time-conv-002",
      "requirements": [
        "TIME-033"
      ],
      "description": "CDS microseconds to CCS day-of-year with 3 sub-second octets",
      "operation": "convert",
      "params": {
        "from": {
          "code": "cds",
          "format": {
            "epoch": "ccsds",
            "day_bits": 16,
            "subms": "us"
          },
          "value": {
            "day": 23131,
            "ms_of_day": 62443123,
            "subms": 456
          }
        },
        "to": {
          "code": "ccs",
          "variation": "day_of_year",
          "subsecond_octets": 3
        }
      },
      "expect": {
        "ok": true,
        "value": {
          "year": 2021,
          "month": null,
          "day": null,
          "day_of_year": 121,
          "hour": 17,
          "minute": 20,
          "second": 43,
          "subsecond": 123456
        }
      }
    },
    {
      "id": "time-conv-003",
      "requirements": [
        "TIME-033",
        "TIME-022"
      ],
      "description": "CDS leap-second milliseconds to ASCII 23:59:60",
      "operation": "convert",
      "params": {
        "from": {
          "code": "cds",
          "format": {
            "epoch": "ccsds",
            "day_bits": 16,
            "subms": "us"
          },
          "value": {
            "day": 0,
            "ms_of_day": 86400500,
            "subms": 7
          }
        },
        "to": {
          "code": "ascii",
          "variation": "A",
          "fraction_digits": 6,
          "z": true
        }
      },
      "expect": {
        "ok": true,
        "text": "1958-01-01T23:59:60.500007Z"
      }
    },
    {
      "id": "time-conv-004",
      "requirements": [
        "TIME-033"
      ],
      "description": "CCS to CDS picoseconds",
      "operation": "convert",
      "params": {
        "from": {
          "code": "ccs",
          "format": {
            "variation": "month_day",
            "subsecond_octets": 6
          },
          "value": {
            "year": 1988,
            "month": 1,
            "day": 18,
            "day_of_year": null,
            "hour": 17,
            "minute": 20,
            "second": 43,
            "subsecond": 123456789012
          }
        },
        "to": {
          "code": "cds",
          "epoch": "ccsds",
          "day_bits": 16,
          "subms": "ps"
        }
      },
      "expect": {
        "ok": true,
        "value": {
          "day": 10974,
          "ms_of_day": 62443123,
          "subms": 456789012
        }
      }
    },
