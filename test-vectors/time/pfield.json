{
  "kind": "codec",
  "standard": "301.0-B-4 \u00a73.1, \u00a73.2.2, \u00a73.6",
  "provenance": "hand-derived",
  "provenance_note": "Hand-derived from 301.0-B-4 \u00a73.1, \u00a73.2.2, \u00a73.6 with the decisions in docs/standards/time-codes.md (OI-15, OI-18). Expected values computed by an independent Python model of the Blue Book text, written before the Rust codec. CCSDS bit 0 is the most significant bit. Decode outputs list the P-field, the format, and every value field; fields that do not apply are null. CUC fine time is given as its raw octets.",
  "cases": [
    {
      "id": "time-pf-001",
      "requirements": [
        "TIME-001",
        "TIME-003",
        "API-010"
      ],
      "description": "CUC Level 1 one-octet P-field, 4 coarse + 2 fine octets",
      "operation": "decode",
      "input_hex": "1E000000018000",
      "expect": {
        "ok": true,
        "code": "cuc",
        "pfield_hex": "1E",
        "format": {
          "epoch": "level1",
          "coarse_octets": 4,
          "fine_octets": 2,
          "mission_bits": 0,
          "octet2": false,
          "pfield_tail_hex": ""
        },
        "value": {
          "coarse": 1,
          "fine_hex": "8000"
        },
        "consumed": 7,
        "anomalies": []
      }
    },
    {
      "id": "time-pf-002",
