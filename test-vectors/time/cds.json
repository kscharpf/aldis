  "provenance": "hand-derived",
  "provenance_note": "Hand-derived from 301.0-B-4 \u00a73.3, Annex A with the decisions in docs/standards/time-codes.md (OI-15, OI-18). Expected values computed by an independent Python model of the Blue Book text, written before the Rust codec. CCSDS bit 0 is the most significant bit. Decode outputs list the P-field, the format, and every value field; fields that do not apply are null. CUC fine time is given as its raw octets.",
  "cases": [
    {
      "id": "time-cds-001",
      "requirements": [
        "TIME-020",
        "TIME-001",
        "TIME-003"
      ],
      "description": "16-bit day, ms only",
      "operation": "decode",
      "input_hex": "405A5B00000100",
      "expect": {
        "ok": true,
        "code": "cds",
        "pfield_hex": "40",
        "format": {
          "epoch": "ccsds",
          "day_bits": 16,
          "subms": "none",
          "pfield_tail_hex": ""
        },
        "value": {
          "day": 23131,
          "ms_of_day": 256,
          "subms": 0
        },
        "consumed": 7,
        "anomalies": []
      }
    },
