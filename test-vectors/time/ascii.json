      "id": "time-ascii-001",
      "requirements": [
        "TIME-031"
      ],
      "description": "301.0 \u00a73.5.1.1 example, code A",
      "operation": "ascii_parse",
      "params": {
        "text": "1988-01-18T17:20:43.123456Z"
      },
      "expect": {
        "ok": true,
        "variation": "A",
        "year": 1988,
        "month": 1,
        "day": 18,
        "day_of_year": null,
        "hour": 17,
        "minute": 20,
        "second": 43,
        "fraction_digits": 6,
        "fraction": 123456,
        "z": true
      }
    },
