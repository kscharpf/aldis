      "config": {
        "max_packet_len": 10
      },
      "params": {
        "packet_type": 0,
        "apid": 260,
        "secondary_header_indicator": false,
        "octets_hex": "0000000000",
        "sequence_count": 0
      },
      "expect": {
        "ok": false,
        "error": "OutOfRange"
      }
    }
  ]
