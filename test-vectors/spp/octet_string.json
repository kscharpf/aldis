      },
      "expect": {
        "ok": false,
        "error": "InvalidField"
      }
    },
    {
      "id": "spp-oct-006",
      "requirements": [
        "SPP-012",
        "SPP-006"
      ],
      "description": "Above max_packet_len is OutOfRange",
