{
  "kind": "codec",
  "standard": "133.0-B-2 \u00a74.1, \u00a75",
  "provenance": "hand-derived",
  "provenance_note": "Hand-derived from 133.0-B-2 \u00a74.1 (Figure 4-2, \u00a74.1.3\u20134.1.4), \u00a73.4, and Table 5-1, with the rules of docs/standards/space-packet.md \u00a75 (OI-16, OI-30). 133.0 prints no worked example packets. Expected values computed by an independent Python model of the Blue Book text, written before the Rust codec. Decode outputs list every view field; packet_name is null for telemetry packets.",
  "cases": [
    {
      "id": "spp-spl-001",
      "requirements": [
        "SPP-007",
        "API-010"
      ],
      "description": "Opaque 2-octet secondary header, 3 user data octets",
      "operation": "split",
      "params": {
        "secondary_header_len": 2
      },
      "input_hex": "0850C0000004A0A1010203",
      "expect": {
        "ok": true,
        "secondary_header_hex": "A0A1",
        "user_data_hex": "010203"
      }
    },
    {
      "id": "spp-spl-002",
      "requirements": [
        "SPP-007",
        "API-010"
      ],
      "description": "Secondary header fills the data field: user data empty",
      "operation": "split",
      "params": {
        "secondary_header_len": 2
      },
      "input_hex": "0850C0000001A0A1",
      "expect": {
        "ok": true,
        "secondary_header_hex": "A0A1",
        "user_data_hex": ""
      }
    },
    {
      "id": "spp-spl-003",
      "requirements": [
        "SPP-007",
        "API-010"
      ],
      "description": "No layout and flag 0: everything is user data",
      "operation": "split",
      "params": {
        "secondary_header_len": null
      },
      "input_hex": "0051C0000002010203",
      "expect": {
        "ok": true,
        "secondary_header_hex": "",
        "user_data_hex": "010203"
      }
    },
    {
      "id": "spp-spl-004",
      "requirements": [
        "SPP-007",
        "API-010"
      ],
      "description": "Data field shorter than the secondary header: LengthMismatch",
      "operation": "split",
      "params": {
        "secondary_header_len": 2
      },
      "input_hex": "0850C0000000A0",
      "expect": {
        "ok": false,
        "error": "LengthMismatch"
      }
    },
    {
      "id": "spp-spl-005",
      "requirements": [
        "SPP-007",
        "API-010"
      ],
      "description": "Flag 1 but no layout: InvalidField",
      "operation": "split",
      "params": {
        "secondary_header_len": null
      },
      "input_hex": "0852C00000010102",
      "expect": {
        "ok": false,
        "error": "InvalidField"
      }
    },
    {
      "id": "spp-spl-006",
      "requirements": [
        "SPP-007",
        "API-010"
      ],
      "description": "Flag 0 but a layout: InvalidField",
      "operation": "split",
      "params": {
        "secondary_header_len": 1
      },
      "input_hex": "0053C00000010102",
      "expect": {
        "ok": false,
        "error": "InvalidField"
      }
    }
  ]
}
