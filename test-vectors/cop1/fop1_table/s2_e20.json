      "expect": [
        {
          "event": "directive_notify",
          "handle": 1,
          "type": "accept"
        },
        {
          "event": "directive_notify",
          "handle": 1,
          "type": "positive_confirm"
        }
      ],
      "expect_state": "S1"
    },
    {
      "at_us": 2000,
      "input": {
        "request_ad": {
          "handle": 2,
          "data_hex": "A002"
        }
      },
      "expect": [
        {
          "event": "transfer_notify",
          "handle": 2,
          "type": "accept"
        },
        {
          "transmit": {
            "kind": "AD",
            "ns": 0,
            "retransmission": false,
            "frame_hex": "002A040800A002733D"
          }
        }
      ],
      "expect_state": "S1",
      "expect_timeout_us": 2002000
    },
    {
      "at_us": 3000,
      "input": {
        "request_ad": {
          "handle": 3,
          "data_hex": "A003"
        }
      },
      "expect": [],
      "expect_state": "S1",
      "expect_timeout_us": 2002000
    },
    {
      "at_us": 4000,
      "input": {
        "clcw": {
          "lockout": false,
          "wait": false,
          "retransmit": true,
          "n_r": 0
        }
      },
      "expect": [
        {
          "event": "abort"
        }
      ],
      "expect_state": "S2",
      "expect_timeout_us": 2004000
    },
    {
      "at_us": 5000,
      "input": {
        "request_ad": {
          "handle": 5,
          "data_hex": "A005"
        }
      },
      "expect": [
        {
          "event": "transfer_notify",
          "handle": 5,
          "type": "reject"
        }
      ],
      "expect_state": "S2",
      "expect_timeout_us": 2004000
    },
    {
      "at_us": 5000,
      "input": {
        "query": "next_deadline"
      },
      "expect": [
        {
          "next_deadline": 2004000
        }
      ],
      "expect_state": "S2",
      "expect_timeout_us": 2004000
