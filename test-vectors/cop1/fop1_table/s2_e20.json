{
  "kind": "engine-scenario",
  "engine": "fop1",
  "id": "cop1-fop1-s2-e20",
  "description": "FOP-1 Table 5-1, S2 x E20: Request to transfer an AD FDU, Wait_Queue occupied. setup of 4 step(s), then the trigger.",
  "requirements": [
    "COP-001",
    "COP-005",
    "COP-012",
    "COP-010",
    "COP-013",
    "COP-006"
  ],
  "provenance": "hand-derived",
