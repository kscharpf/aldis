{
  "kind": "engine-scenario",
  "engine": "fop1",
  "id": "cop1-fop1-clcw-pattern-type",
  "description": "A word whose Control Word Type is 1 is an invalid pattern (E15) and raises Alert[CLCW].",
  "requirements": [
    "COP-001",
    "COP-012",
    "COP-017",
    "COP-006"
  ],
  "provenance": "hand-derived",
  "provenance_note": "Hand-derived from 232.1-B-2 Cor. 1 Table 5-1, 5.1 and 5.2, 232.0-B-4 4.1.2, 4.1.3.3, 4.1.4.2 and docs/standards/cop1.md; expected values come from the independent model test-vectors/models/cop1.py, written blind by an agent that had not read the implementation (TV-023).",
  "config": {
    "frame_target": "tc",
    "scid": 42,
    "vcid": 1,
    "t1_initial_us": 2000000,
    "transmission_limit": 3,
    "timeout_type": 0,
    "k": 3,
    "fecf": true
  },
  "steps": [
    {
      "at_us": 0,
      "input": {
        "directive": {
          "handle": 1,
          "type": "initiate_ad_without_clcw_check"
        }
      },
      "expect": [
        {
          "event": "directive_notify",
          "handle": 1,
          "type": "accept"
        },
        {
          "event": "directive_notify",
          "handle": 1,
          "type": "positive_confirm"
        }
      ],
      "expect_state": "S1"
    },
    {
      "at_us": 1000,
      "input": {
        "clcw": {
          "lockout": false,
          "wait": false,
          "retransmit": false,
          "n_r": 0,
          "control_word_type": 1
        }
      },
      "expect": [
        {
          "event": "alert",
          "reason": "clcw",
          "event_number": 15,
          "prior_state": "S1"
        }
      ],
      "expect_state": "S6"
    }
  ]
}
