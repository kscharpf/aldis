{
  "kind": "engine-scenario",
  "engine": "fop1",
  "id": "cop1-fop1-initiate-set-vr",
  "description": "Initiate AD with Set V(R) 200 sets V(S) and NN(R) to 200, sends the Set V(R) frame, and the next AD frame carries N(S) 200.",
  "requirements": [
    "COP-001",
    "COP-012",
    "COP-010",
    "COP-013",
    "COP-006"
  ],
  "provenance": "hand-derived",
