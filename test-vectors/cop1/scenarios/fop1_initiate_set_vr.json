      ],
      "expect_state": "S1",
      "expect_timeout_us": 2003000
    },
    {
      "at_us": 4000,
      "input": {
        "transmit_done": {
          "kind": "AD",
          "response": "accept"
        }
      },
      "expect": [],
      "expect_state": "S1",
      "expect_timeout_us": 2003000
    },
    {
      "at_us": 5000,
      "input": {
        "clcw": {
          "lockout": false,
          "wait": false,
          "retransmit": false,
          "n_r": 201
