        {
          "transmit": {
            "kind": "BC",
            "ns": 0,
            "retransmission": false,
            "frame_hex": "302A0409008200C849F9"
          }
        }
      ],
      "expect_state": "S5",
      "expect_timeout_us": 2000000
    },
    {
      "at_us": 1000,
      "input": {
        "transmit_done": {
          "kind": "BC",
          "response": "accept"
        }
      },
      "expect": [],
      "expect_state": "S5",
      "expect_timeout_us": 2000000
    },
    {
      "at_us": 2000,
      "input": {
        "clcw": {
          "lockout": false,
          "wait": false,
          "retransmit": false,
          "n_r": 200
        }
      },
      "expect": [
        {
          "event": "directive_notify",
          "handle": 1,
          "type": "positive_confirm"
