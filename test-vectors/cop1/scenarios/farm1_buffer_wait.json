{
  "kind": "engine-scenario",
  "engine": "farm1",
  "id": "cop1-farm1-buffer-wait",
  "description": "No buffer for the expected frame: Wait and Retransmit set; the frame is refused until the buffer is released; the retransmission is then accepted and Retransmit clears.",
  "requirements": [
    "COP-002",
    "COP-033"
  ],
  "provenance": "hand-derived",
  "provenance_note": "Hand-derived from 232.1-B-2 Cor. 1 Table 6-1, 6.1 and 6.2 and 232.0-B-4 4.1.2, 4.1.3.3, 4.2.1. Model test-vectors/models/cop1.py, written blind (TV-023) by a Claude agent from the Blue Books and docs/ only, without reading any implementation; docs/verification/reviews/cop1-tables.md was read as input and the transcription compared with it. The input script was chosen by hand; the expected outputs are the model's.",
  "config": {
    "frame_target": "tc",
    "scid": 42,
    "vcid": 1,
    "fecf": true,
    "status_field": 0,
    "window": {
      "retransmission_allowed": true,
      "w": 8
    },
    "v_r": 0
  },
  "steps": [
    {
      "at_us": 0,
      "input": {
        "frame": {
          "frame_hex": "002A040800C0DE72E6",
          "buffer_available": false
        }
      },
      "expect": [
        {
          "event": "frame_discarded",
          "event_number": 2,
          "state": "S1"
        },
        {
          "event": "state_changed",
          "event_number": 2,
          "from": "S1",
          "to": "S2"
        }
      ],
      "expect_state": "S2"
    },
    {
      "at_us": 1000,
      "input": {
        "query": "clcw"
      },
      "expect": [
        {
          "clcw": {
            "lockout": false,
            "wait": true,
            "retransmit": true,
            "farm_b_counter": 0,
            "n_r": 0,
            "cop_in_effect": 1,
            "vcid": 1,
            "status_field": 0,
            "no_rf_available": false,
            "no_bit_lock": false
          },
          "clcw_hex": "01041800"
        }
      ],
      "expect_state": "S2"
    },
    {
      "at_us": 2000,
      "input": {
        "frame": {
          "frame_hex": "002A040800C0DE72E6",
          "buffer_available": true
        }
      },
      "expect": [
        {
          "error": "InvalidState"
        }
      ],
      "expect_state": "S2"
    },
    {
      "at_us": 3000,
      "input": {
        "buffer_released": {}
      },
      "expect": [
        {
          "event": "state_changed",
          "event_number": 10,
          "from": "S2",
          "to": "S1"
        }
      ],
      "expect_state": "S1"
    },
    {
      "at_us": 4000,
      "input": {
        "query": "clcw"
      },
      "expect": [
        {
          "clcw": {
            "lockout": false,
            "wait": false,
            "retransmit": true,
            "farm_b_counter": 0,
            "n_r": 0,
            "cop_in_effect": 1,
            "vcid": 1,
            "status_field": 0,
            "no_rf_available": false,
            "no_bit_lock": false
          },
          "clcw_hex": "01040800"
        }
      ],
      "expect_state": "S1"
    },
    {
      "at_us": 5000,
      "input": {
        "frame": {
          "frame_hex": "002A040800C0DE72E6",
          "buffer_available": true
        }
      },
      "expect": [
        {
          "deliver": {
            "kind": "AD",
            "ns": 0,
            "data_hex": "C0DE"
          }
        }
      ],
      "expect_state": "S1"
    },
    {
      "at_us": 6000,
      "input": {
        "query": "clcw"
      },
      "expect": [
        {
          "clcw": {
            "lockout": false,
            "wait": false,
            "retransmit": false,
            "farm_b_counter": 0,
            "n_r": 1,
            "cop_in_effect": 1,
            "vcid": 1,
            "status_field": 0,
            "no_rf_available": false,
            "no_bit_lock": false
          },
          "clcw_hex": "01040001"
        }
      ],
      "expect_state": "S1"
    },
    {
      "at_us": 7000,
      "input": {
        "frame": {
          "frame_hex": "002A040801C0DE45D6",
          "buffer_available": true
        }
      },
      "expect": [
        {
          "deliver": {
            "kind": "AD",
            "ns": 1,
            "data_hex": "C0DE"
          }
        }
      ],
      "expect_state": "S1"
    },
    {
      "at_us": 8000,
      "input": {
        "query": "clcw"
      },
      "expect": [
        {
          "clcw": {
            "lockout": false,
            "wait": false,
            "retransmit": false,
            "farm_b_counter": 0,
            "n_r": 2,
            "cop_in_effect": 1,
            "vcid": 1,
            "status_field": 0,
            "no_rf_available": false,
            "no_bit_lock": false
          },
          "clcw_hex": "01040002"
        }
      ],
      "expect_state": "S1"
    }
  ]
}
