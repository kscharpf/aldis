{
  "kind": "engine-scenario",
  "engine": "fop1",
  "id": "cop1-fop1-suspend-resume",
  "description": "With Timeout_Type 1 the exhausted Transmission_Limit suspends the service without purging; Resume returns to the saved state and restarts the timer.",
  "requirements": [
    "COP-001",
    "COP-012",
    "COP-010",
    "COP-011",
    "COP-013",
    "COP-014",
    "COP-006"
  ],
  "provenance": "hand-derived",
  "provenance_note": "Hand-derived from 232.1-B-2 Cor. 1 Table 5-1, 5.1 and 5.2, 232.0-B-4 4.1.2, 4.1.3.3, 4.1.4.2 and docs/standards/cop1.md; expected values come from the independent model test-vectors/models/cop1.py, written blind by an agent that had not read the implementation (TV-023).",
  "config": {
    "frame_target": "tc",
    "scid": 42,
    "vcid": 1,
    "t1_initial_us": 2000000,
    "transmission_limit": 2,
    "timeout_type": 1,
    "k": 3,
    "fecf": true
  },
  "steps": [
    {
      "at_us": 0,
      "input": {
        "directive": {
          "handle": 1,
          "type": "initiate_ad_without_clcw_check"
        }
      },
      "expect": [
        {
          "event": "directive_notify",
          "handle": 1,
          "type": "accept"
        },
        {
          "event": "directive_notify",
          "handle": 1,
          "type": "positive_confirm"
        }
      ],
      "expect_state": "S1"
    },
    {
      "at_us": 1000,
      "input": {
        "request_ad": {
          "handle": 2,
          "data_hex": "A002"
        }
      },
      "expect": [
        {
          "event": "transfer_notify",
          "handle": 2,
          "type": "accept"
        },
        {
          "transmit": {
            "kind": "AD",
            "ns": 0,
            "retransmission": false,
            "frame_hex": "002A040800A002733D"
          }
        }
      ],
      "expect_state": "S1",
      "expect_timeout_us": 2001000
    },
    {
      "at_us": 2000,
      "input": {
        "transmit_done": {
          "kind": "AD",
          "response": "accept"
        }
      },
      "expect": [],
      "expect_state": "S1",
      "expect_timeout_us": 2001000
    },
    {
      "at_us": 2001000,
      "input": {
        "timeout": {}
      },
      "expect": [
        {
          "event": "abort"
        },
        {
          "transmit": {
            "kind": "AD",
            "ns": 0,
            "retransmission": true,
            "frame_hex": "002A040800A002733D"
          }
        }
      ],
      "expect_state": "S1",
      "expect_timeout_us": 4001000
    },
    {
      "at_us": 2002000,
      "input": {
        "transmit_done": {
          "kind": "AD",
          "response": "accept"
        }
      },
      "expect": [],
      "expect_state": "S1",
      "expect_timeout_us": 4001000
    },
    {
      "at_us": 4001000,
      "input": {
        "timeout": {}
      },
      "expect": [
        {
          "event": "suspend"
        }
      ],
      "expect_state": "S6"
    },
    {
      "at_us": 4002000,
      "input": {
        "directive": {
          "handle": 3,
          "type": "resume_ad"
        }
      },
      "expect": [
        {
          "event": "directive_notify",
          "handle": 3,
          "type": "accept"
        },
        {
          "event": "directive_notify",
          "handle": 3,
          "type": "positive_confirm"
        }
      ],
      "expect_state": "S1",
      "expect_timeout_us": 6002000
    },
    {
      "at_us": 4003000,
      "input": {
        "clcw": {
          "lockout": false,
          "wait": false,
          "retransmit": false,
          "n_r": 1
        }
      },
      "expect": [
        {
          "event": "transfer_notify",
          "handle": 2,
          "type": "positive_confirm"
        }
      ],
      "expect_state": "S1"
    }
  ]
}
