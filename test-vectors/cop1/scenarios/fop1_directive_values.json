{
  "kind": "engine-scenario",
  "engine": "fop1",
  "id": "cop1-fop1-directive-values",
  "description": "A K outside 1..255, a Transmission_Limit of 0, a Timeout_Type above 1, a T1_Initial of 0, a V(S) above 255, and an unknown directive are rejected; K = 2 is accepted.",
  "requirements": [
    "COP-001",
    "COP-015",
    "COP-006"
  ],
  "provenance": "hand-derived",
  "provenance_note": "Hand-derived from 232.1-B-2 Cor. 1 Table 5-1, 5.1 and 5.2, 232.0-B-4 4.1.2, 4.1.3.3, 4.1.4.2 and docs/standards/cop1.md; expected values come from the independent model test-vectors/models/cop1.py, written blind by an agent that had not read the implementation (TV-023).",
  "config": {
    "frame_target": "tc",
    "scid": 42,
    "vcid": 1,
    "t1_initial_us": 2000000,
    "transmission_limit": 3,
    "timeout_type": 0,
    "k": 3,
    "fecf": true
  },
  "steps": [
    {
      "at_us": 0,
      "input": {
        "directive": {
          "handle": 1,
          "type": "set_k",
          "value": 0
        }
      },
      "expect": [
        {
          "event": "directive_notify",
          "handle": 1,
          "type": "reject"
        }
      ],
      "expect_state": "S6"
    },
    {
      "at_us": 1000,
      "input": {
        "directive": {
          "handle": 2,
          "type": "set_k",
          "value": 256
        }
      },
      "expect": [
        {
          "event": "directive_notify",
          "handle": 2,
          "type": "reject"
        }
      ],
      "expect_state": "S6"
    },
    {
      "at_us": 2000,
      "input": {
        "directive": {
          "handle": 3,
          "type": "set_k",
          "value": 2
        }
      },
      "expect": [
        {
          "event": "directive_notify",
          "handle": 3,
          "type": "accept"
        },
        {
          "event": "directive_notify",
          "handle": 3,
          "type": "positive_confirm"
        }
      ],
      "expect_state": "S6"
    },
    {
      "at_us": 3000,
      "input": {
        "directive": {
          "handle": 4,
          "type": "set_transmission_limit",
          "value": 0
        }
      },
      "expect": [
        {
          "event": "directive_notify",
          "handle": 4,
          "type": "reject"
        }
      ],
      "expect_state": "S6"
    },
    {
      "at_us": 4000,
      "input": {
        "directive": {
          "handle": 5,
          "type": "set_timeout_type",
          "value": 2
        }
      },
      "expect": [
        {
          "event": "directive_notify",
          "handle": 5,
          "type": "reject"
        }
      ],
      "expect_state": "S6"
    },
    {
      "at_us": 5000,
      "input": {
        "directive": {
          "handle": 6,
          "type": "set_t1_initial",
          "value": 0
        }
      },
      "expect": [
        {
          "event": "directive_notify",
          "handle": 6,
          "type": "reject"
        }
      ],
      "expect_state": "S6"
    },
    {
      "at_us": 6000,
      "input": {
        "directive": {
          "handle": 7,
          "type": "no_such_directive"
        }
      },
      "expect": [
        {
          "event": "directive_notify",
          "handle": 7,
          "type": "reject"
        }
      ],
      "expect_state": "S6"
    },
    {
      "at_us": 7000,
      "input": {
        "directive": {
          "handle": 8,
          "type": "set_v_s",
          "value": 256
        }
      },
      "expect": [
        {
          "event": "directive_notify",
          "handle": 8,
          "type": "reject"
        }
      ],
      "expect_state": "S6"
    }
  ]
}
