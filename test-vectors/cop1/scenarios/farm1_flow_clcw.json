        {"at_us": 3000, "input": {"frame": {"frame_hex": "202A040800BD015887", "buffer_available": false}}, "expect": [{"deliver": {"kind": "BD", "ns": 0, "data_hex": "BD01"}}], "expect_state": "S1"},
