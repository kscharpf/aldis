        {"at_us": 1000, "input": {"query": "clcw"}, "expect": [{"clcw": {"lockout": false, "wait": true, "retransmit": true, "farm_b_counter": 0, "n_r": 0, "cop_in_effect": 1, "vcid": 1, "status_field": 0, "no_rf_available": false, "no_bit_lock": false}, "clcw_hex": "01041800"}], "expect_state": "S2"},
        {"at_us": 2000, "input": {"frame": {"frame_hex": "002A040800C0DE72E6", "buffer_available": true}}, "expect": [{"error": "InvalidState"}], "expect_state": "S2"},
        {"at_us": 3000, "input": {"buffer_released": {}}, "expect": [{"event": "state_changed", "event_number": 10, "from": "S2", "to": "S1"}], "expect_state": "S1"},
        {"at_us": 4000, "input": {"query": "clcw"}, "expect": [{"clcw": {"lockout": false, "wait": false, "retransmit": true, "farm_b_counter": 0, "n_r": 0, "cop_in_effect": 1, "vcid": 1, "status_field": 0, "no_rf_available": false, "no_bit_lock": false}, "clcw_hex": "01040800"}], "expect_state": "S1"},
