        {"at_us": 6000, "input": {"frame": {"frame_hex": "302A0407000020E7", "buffer_available": true}}, "expect": [{"event": "unlocked"}], "expect_state": "S1"},
        {"at_us": 7000, "input": {"query": "clcw"}, "expect": [{"clcw": {"lockout": false, "wait": false, "retransmit": false, "farm_b_counter": 2, "n_r": 0, "cop_in_effect": 1, "vcid": 1, "status_field": 0, "no_rf_available": false, "no_bit_lock": false}, "clcw_hex": "01040400"}], "expect_state": "S1"}
