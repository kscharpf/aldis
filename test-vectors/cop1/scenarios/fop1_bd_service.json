{
  "kind": "engine-scenario",
  "engine": "fop1",
  "id": "cop1-fop1-bd-service",
  "description": "BD frames carry N(S) 0, do not start the timer, and a request is refused while the Lower Procedures hold the previous frame.",
  "requirements": [
    "COP-001",
    "COP-010",
    "COP-006",
    "COP-013"
  ],
  "provenance": "hand-derived",
  "provenance_note": "Hand-derived from 232.1-B-2 Cor. 1 Table 5-1, 5.1 and 5.2, 232.0-B-4 4.1.2, 4.1.3.3, 4.1.4.2 and docs/standards/cop1.md; expected values come from the independent model test-vectors/models/cop1.py, written blind by an agent that had not read the implementation (TV-023).",
  "config": {
    "frame_target": "tc",
    "scid": 42,
    "vcid": 1,
    "t1_initial_us": 2000000,
    "transmission_limit": 3,
    "timeout_type": 0,
    "k": 3,
    "fecf": true
  },
  "steps": [
    {
      "at_us": 0,
      "input": {
        "request_bd": {
          "handle": 1,
          "data_hex": "A001"
        }
      },
      "expect": [
        {
          "event": "transfer_notify",
          "handle": 1,
          "type": "accept"
        },
        {
          "transmit": {
            "kind": "BD",
            "ns": 0,
            "retransmission": false,
            "frame_hex": "202A040800A0012DA8"
          }
        }
      ],
      "expect_state": "S6"
    },
    {
      "at_us": 1000,
      "input": {
        "request_bd": {
          "handle": 2,
          "data_hex": "A002"
        }
      },
      "expect": [
        {
          "event": "transfer_notify",
          "handle": 2,
          "type": "reject"
        }
      ],
      "expect_state": "S6"
    },
    {
      "at_us": 2000,
      "input": {
        "transmit_done": {
          "kind": "BD",
          "response": "accept"
        }
      },
      "expect": [
        {
          "event": "transfer_notify",
          "handle": 1,
          "type": "accept"
        }
      ],
      "expect_state": "S6"
    },
    {
      "at_us": 3000,
      "input": {
        "request_bd": {
          "handle": 3,
          "data_hex": "A003"
        }
      },
      "expect": [
        {
          "event": "transfer_notify",
          "handle": 3,
          "type": "accept"
        },
        {
          "transmit": {
            "kind": "BD",
            "ns": 0,
            "retransmission": false,
            "frame_hex": "202A040800A0030DEA"
          }
        }
      ],
      "expect_state": "S6"
    }
  ]
}
