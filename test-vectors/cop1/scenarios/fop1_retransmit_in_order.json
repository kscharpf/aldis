{
  "kind": "engine-scenario",
  "engine": "fop1",
  "id": "cop1-fop1-retransmit-in-order",
  "description": "A Retransmit CLCW makes FOP-1 send the whole Sent_Queue again, oldest first, one frame per AD_Accept.",
  "requirements": [
    "COP-001",
    "COP-011"
  ],
  "provenance": "hand-derived",
  "provenance_note": "Hand-derived from 232.1-B-2 Cor. 1 Table 5-1, 5.1 and 5.2 and 232.0-B-4 4.1.2, 4.1.3.3, 4.1.4.2. Model test-vectors/models/cop1.py, written blind (TV-023) by a Claude agent from the Blue Books and docs/ only, without reading any implementation; docs/verification/reviews/cop1-tables.md was read as input and the transcription compared with it. The input script was chosen by hand; the expected outputs are the model's.",
  "config": {
    "frame_target": "tc",
    "scid": 42,
    "vcid": 1,
    "t1_initial_us": 2000000,
    "transmission_limit": 3,
    "timeout_type": 0,
    "k": 3,
    "fecf": true
  },
  "steps": [
    {
      "at_us": 0,
      "input": {
        "directive": {
          "handle": 1,
          "type": "initiate_ad_without_clcw_check"
        }
      },
      "expect": [
        {
          "event": "directive_notify",
          "handle": 1,
          "type": "accept"
        },
        {
          "event": "directive_notify",
          "handle": 1,
          "type": "positive_confirm"
        }
      ],
      "expect_state": "S1"
    },
    {
      "at_us": 1000,
      "input": {
        "request_ad": {
          "handle": 2,
          "data_hex": "A002"
        }
      },
      "expect": [
        {
          "event": "transfer_notify",
          "handle": 2,
          "type": "accept"
        },
        {
          "transmit": {
            "kind": "AD",
            "ns": 0,
            "retransmission": false,
            "frame_hex": "002A040800A002733D"
          }
        }
      ],
      "expect_state": "S1",
      "expect_timeout_us": 2001000
    },
    {
      "at_us": 2000,
      "input": {
        "transmit_done": {
          "kind": "AD",
          "response": "accept"
        }
      },
      "expect": [],
      "expect_state": "S1",
      "expect_timeout_us": 2001000
    },
    {
      "at_us": 3000,
      "input": {
        "request_ad": {
          "handle": 3,
          "data_hex": "A003"
        }
      },
      "expect": [
        {
          "event": "transfer_notify",
          "handle": 3,
          "type": "accept"
        },
        {
          "transmit": {
            "kind": "AD",
            "ns": 1,
            "retransmission": false,
            "frame_hex": "002A040801A003542C"
          }
