          }
        }
      ],
      "expect_state": "S2",
      "expect_timeout_us": 2007000
    },
    {
      "at_us": 9000,
      "input": {
        "transmit_done": {
          "kind": "AD",
          "response": "accept"
        }
      },
      "expect": [
        {
          "transmit": {
            "kind": "AD",
            "ns": 2,
            "retransmission": true,
            "frame_hex": "002A040802A0047D9B"
          }
        }
      ],
      "expect_state": "S2",
      "expect_timeout_us": 2007000
    },
    {
      "at_us": 10000,
      "input": {
        "transmit_done": {
          "kind": "AD",
          "response": "accept"
