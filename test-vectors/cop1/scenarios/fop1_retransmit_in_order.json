        }
      },
      "expect": [
        {
          "event": "transfer_notify",
          "handle": 4,
          "type": "accept"
        },
        {
          "transmit": {
            "kind": "AD",
            "ns": 2,
            "retransmission": false,
            "frame_hex": "002A040802A0047D9B"
          }
