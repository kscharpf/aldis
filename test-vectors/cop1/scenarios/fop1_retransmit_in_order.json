      "expect_timeout_us": 2005000
    },
    {
      "at_us": 7000,
      "input": {
        "clcw": {
          "lockout": false,
          "wait": false,
          "retransmit": true,
          "n_r": 0
        }
      },
      "expect": [
        {
          "event": "abort"
        },
        {
          "transmit": {
            "kind": "AD",
            "ns": 0,
            "retransmission": true,
            "frame_hex": "002A040800A002733D"
          }
        }
      ],
      "expect_state": "S2",
      "expect_timeout_us": 2007000
    },
    {
      "at_us": 8000,
      "input": {
        "transmit_done": {
          "kind": "AD",
          "response": "accept"
        }
      },
      "expect": [
        {
          "transmit": {
            "kind": "AD",
            "ns": 1,
            "retransmission": true,
