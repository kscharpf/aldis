    {
      "id": "epp-inv-001",
      "requirements": [
        "EPP-001"
      ],
      "description": "Version 000 (a Space Packet) is UnsupportedVersion",
      "operation": "decode",
      "input_hex": "0001",
      "expect": {
        "ok": false,
        "error": "UnsupportedVersion"
      }
    },
    {
      "id": "epp-inv-002",
      "requirements": [
        "EPP-001"
      ],
