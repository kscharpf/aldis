{
  "kind": "codec",
  "standard": "133.1-B-3 \u00a74.1, \u00a75",
  "provenance": "hand-derived",
  "provenance_note": "Hand-derived from 133.1-B-3 \u00a74.1.2 (Figure 4-2, Tables 4-1 and 4-2), \u00a74.1.3, and Table 5-1, with the decisions recorded in docs/standards/encapsulation-packet.md (OI-16: EPP-005 is an error in both modes). Expected values computed by an independent Python model of the Blue Book text, written before the Rust codec. Decode outputs list every view field; fields absent from the header size are null.",
  "cases": [
    {
      "id": "epp-idle-001",
      "requirements": [
        "EPP-009"
      ],
      "description": "Total length 1: 1-octet header",
      "operation": "idle",
      "params": {
        "total_len": 1,
        "fill": 85
      },
      "expect": {
        "ok": true,
        "output_hex": "E0"
      }
    },
    {
      "id": "epp-idle-002",
      "requirements": [
        "EPP-009"
      ],
      "description": "Total length 2: 2-octet header, no data",
      "operation": "idle",
      "params": {
        "total_len": 2,
        "fill": 85
      },
      "expect": {
        "ok": true,
        "output_hex": "E102"
      }
    },
    {
      "id": "epp-idle-003",
      "requirements": [
        "EPP-009"
      ],
      "description": "Total length 5: 2-octet header, fill 0xC3",
      "operation": "idle",
      "params": {
        "total_len": 5,
        "fill": 195
      },
      "expect": {
        "ok": true,
        "output_hex": "E105C3C3C3"
      }
    },
    {
      "id": "epp-idle-004",
      "requirements": [
        "EPP-009"
      ],
