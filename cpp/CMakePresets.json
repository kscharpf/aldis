{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Every preset: Ninja, output under target/cpp/<preset>, compile commands for clang-tidy",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../target/cpp/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "host-gcc",
      "inherits": "base",
      "displayName": "Host, GCC (pinned)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-14",
        "CMAKE_CXX_COMPILER": "g++-14",
        "ALDIS_TOOLCHAIN": "GCC"
      }
    },
    {
      "name": "host-clang",
      "inherits": "base",
      "displayName": "Host, Clang (pinned)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "ALDIS_TOOLCHAIN": "LLVM"
      }
    },
    {
      "name": "host-clang-sanitize",
      "inherits": "host-clang",
      "displayName": "Host, Clang, sanitizers (CPP-051)",
      "cacheVariables": {
        "ALDIS_SANITIZE": "ON",
        "ALDIS_HEADER_CHECKS": "OFF"
      }
    },
    {
      "name": "host-clang-coverage",
      "inherits": "host-clang",
      "displayName": "Host, Clang, source-based coverage (CPP-052)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ALDIS_COVERAGE": "ON",
        "ALDIS_HEADER_CHECKS": "OFF"
      }
    },
    {
      "name": "s390x-gcc",
      "inherits": "base",
      "displayName": "s390x Linux (big-endian), GCC (pinned), tests under QEMU user mode",
      "toolchainFile": "${sourceDir}/cmake/toolchains/s390x-gcc.cmake",
      "cacheVariables": { "ALDIS_TOOLCHAIN": "GCC_S390X" }
    },
    {
      "name": "baremetal",
      "hidden": true,
      "inherits": "base",
      "description": "Bare-metal targets: library and header checks only; the exerciser joins in WP-5",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ALDIS_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "cortex-m4f-gcc",
      "inherits": "baremetal",
      "displayName": "Cortex-M4F (thumbv7em-none-eabihf), Arm GNU Toolchain (pinned)",
      "toolchainFile": "${sourceDir}/cmake/toolchains/cortex-m4f-gcc.cmake",
      "cacheVariables": { "ALDIS_TOOLCHAIN": "ARM_GNU" }
    },
    {
      "name": "cortex-m4f-clang",
      "inherits": "baremetal",
      "displayName": "Cortex-M4F (thumbv7em-none-eabihf), Clang (pinned)",
      "toolchainFile": "${sourceDir}/cmake/toolchains/cortex-m4f-clang.cmake",
      "cacheVariables": { "ALDIS_TOOLCHAIN": "LLVM" }
    },
    {
      "name": "cortex-r5f-gcc",
      "inherits": "baremetal",
      "displayName": "Cortex-R5F (armv7r-none-eabihf), Arm GNU Toolchain (pinned)",
      "toolchainFile": "${sourceDir}/cmake/toolchains/cortex-r5f-gcc.cmake",
      "cacheVariables": { "ALDIS_TOOLCHAIN": "ARM_GNU" }
    },
    {
      "name": "cortex-r5f-clang",
      "inherits": "baremetal",
      "displayName": "Cortex-R5F (armv7r-none-eabihf), Clang (pinned)",
      "toolchainFile": "${sourceDir}/cmake/toolchains/cortex-r5f-clang.cmake",
      "cacheVariables": { "ALDIS_TOOLCHAIN": "LLVM" }
    },
    {
      "name": "rv32imac-gcc",
      "inherits": "baremetal",
      "displayName": "RV32IMAC (riscv32imac-unknown-none-elf), xPack RISC-V GCC (pinned)",
      "toolchainFile": "${sourceDir}/cmake/toolchains/rv32imac-gcc.cmake",
      "cacheVariables": { "ALDIS_TOOLCHAIN": "RISCV_GNU" }
    },
    {
      "name": "rv32imac-clang",
      "inherits": "baremetal",
      "displayName": "RV32IMAC (riscv32imac-unknown-none-elf), Clang (pinned)",
      "toolchainFile": "${sourceDir}/cmake/toolchains/rv32imac-clang.cmake",
      "cacheVariables": { "ALDIS_TOOLCHAIN": "LLVM" }
    },
    {
      "name": "leon3-gcc",
      "inherits": "baremetal",
      "displayName": "LEON3 (SPARC V8), Gaisler BCC2 (pinned; non-gating, OI-08)",
      "toolchainFile": "${sourceDir}/cmake/toolchains/leon3-gcc.cmake",
      "cacheVariables": { "ALDIS_TOOLCHAIN": "BCC2" }
    }
  ],
  "buildPresets": [
    { "name": "host-gcc", "configurePreset": "host-gcc" },
    { "name": "host-clang", "configurePreset": "host-clang" },
    { "name": "host-clang-sanitize", "configurePreset": "host-clang-sanitize" },
    { "name": "host-clang-coverage", "configurePreset": "host-clang-coverage" },
    { "name": "s390x-gcc", "configurePreset": "s390x-gcc" },
    { "name": "cortex-m4f-gcc", "configurePreset": "cortex-m4f-gcc" },
    { "name": "cortex-m4f-clang", "configurePreset": "cortex-m4f-clang" },
    { "name": "cortex-r5f-gcc", "configurePreset": "cortex-r5f-gcc" },
    { "name": "cortex-r5f-clang", "configurePreset": "cortex-r5f-clang" },
    { "name": "rv32imac-gcc", "configurePreset": "rv32imac-gcc" },
    { "name": "rv32imac-clang", "configurePreset": "rv32imac-clang" },
    { "name": "leon3-gcc", "configurePreset": "leon3-gcc" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "baremetal-test-base",
      "hidden": true,
      "inherits": "test-base",
      "description": "No bare-metal tests until the exerciser runs under QEMU (WP-5)",
      "execution": { "noTestsAction": "ignore" }
    },
    { "name": "host-gcc", "inherits": "test-base", "configurePreset": "host-gcc" },
    { "name": "host-clang", "inherits": "test-base", "configurePreset": "host-clang" },
    { "name": "host-clang-sanitize", "inherits": "test-base", "configurePreset": "host-clang-sanitize" },
    {
      "name": "host-clang-coverage",
      "inherits": "test-base",
      "configurePreset": "host-clang-coverage",
      "environment": { "LLVM_PROFILE_FILE": "${sourceDir}/../target/cpp/host-clang-coverage/profiles/%p-%m.profraw" }
    },
    { "name": "s390x-gcc", "inherits": "test-base", "configurePreset": "s390x-gcc" },
    { "name": "cortex-m4f-gcc", "inherits": "baremetal-test-base", "configurePreset": "cortex-m4f-gcc" },
    { "name": "cortex-m4f-clang", "inherits": "baremetal-test-base", "configurePreset": "cortex-m4f-clang" },
    { "name": "cortex-r5f-gcc", "inherits": "baremetal-test-base", "configurePreset": "cortex-r5f-gcc" },
    { "name": "cortex-r5f-clang", "inherits": "baremetal-test-base", "configurePreset": "cortex-r5f-clang" },
    { "name": "rv32imac-gcc", "inherits": "baremetal-test-base", "configurePreset": "rv32imac-gcc" },
    { "name": "rv32imac-clang", "inherits": "baremetal-test-base", "configurePreset": "rv32imac-clang" },
    { "name": "leon3-gcc", "inherits": "baremetal-test-base", "configurePreset": "leon3-gcc" }
  ]
}
