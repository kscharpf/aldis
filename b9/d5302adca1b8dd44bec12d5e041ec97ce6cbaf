nightly\" build \"${std[@]}\" -p aldis-ffi --no-default-features \\\n  --features panic-handler,full --target $t --release\n# CABI-004 is reported, not checked, on this target: the compiler_builtins that build-std makes\n# for 32-bit SPARC refers to the quad-float routines of the SPARC ABI (_Q_add, ...), which\n# nothing in the archive defines (OI-08).\nenv -u CARGO_TARGET_SPARC_UNKNOWN_NONE_ELF_RUSTFLAGS RUSTFLAGS=\"$host_flags\" cargo xtask ffi-imports $t || echo \"ffi-imports $t: CABI-004 not met (OI-08)\"\ncd exerciser\n# Panic-freedom link check (VER-010).\ncargo +\"$nightly\" build \"${std[@]}\" --release --locked --target $t\ncargo +\"$nightly\" clippy \"${std[@]}\" --release --locked --target $t\n# Canary: a reachable panic must fail the link.\nif cargo +\"$nightly\" build \"${std[@]}\" --release --locked --target $t --features inject-panic \\\n     2> \"$RUNNER_TEMP/canary.log\"; then\n  echo 'exerciser linked with a reachable panic; the VER-010 check is broken' >&2\n  exit 1\nfi\ngrep -q aldis_panic_is_unreachable \"$RUNNER_TEMP/canary.log\"\necho 'canary failed to link, as it should'\n# Every vector case under QEMU leon3_generic: one retry, each run time-limited.\ntimeout 120 cargo +\"$nightly\" run \"${std[@]}\" --release --locked --target $t \\\n  || timeout 120 cargo +\"$nightly\" run \"${std[@]}\" --release --locked --target $t\n"},{"duration_ms":141285,"gating":true,"host":"container","log_sha256":"55eed1e88e9fd768c20396ef3eef60e8c74e9cf7739f32ebaa86765d75180549","name":"ffi-miri","reason":null,"result":"pass","script":"\n# Every integration test of aldis-ffi but `vectors` under Miri on the tooling nightly, Stacked\n# Borrows (VER-026, GEN-071; m5 plan D4): the unit tests and every test marked\n# `cfg_attr(miri, ignore)` (today one in `sync`) are the nightly check `ffi-miri-lib`, and\n# `vectors`, which takes about two hours, runs weekly (.github/workflows/miri-weekly.yml).\n# Isolation is off: the tests read test-vectors/.\nnightly=\"$(cat tooling-n