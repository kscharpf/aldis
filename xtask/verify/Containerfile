# Image of the verification run, `cargo xtask verify` (docs/06-verification.md §7, VER-056).
#
# Built for the host's native architecture from the files of the commit under test; its tag is a
# hash of this file, entrypoint.sh, rust-toolchain.toml, tooling-nightly, toolchains.lock,
# and setup_cpp.py, so a change to any pin builds a new image. The base image is pinned by
# digest, the shared tools come from toolchains.lock through setup_cpp.py, and Rust
# from rust-toolchain.toml and tooling-nightly (RS-001, RS-002). The LEON3 linker and QEMU
# machine are Ubuntu packages whose upstream versions are asserted where they are installed. The
# other Ubuntu packages are utilities (git, Python, archivers); their versions are listed in
# every evidence record.
FROM docker.io/library/ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac

ARG TARGETARCH
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8

RUN apt-get update -q \
 && apt-get install -y -q --no-install-recommends \
      ca-certificates curl git python3 xz-utils zstd unzip \
 && rm -rf /var/lib/apt/lists/* \
 && git config --system --add safe.directory '*'

# Shared toolchains from the lock file: LLVM (clang, llvm-cov, etc.), GCC (host and s390x cross),
# and QEMU (VER-056). setup_cpp.py finds the lock relative to itself under /opt/aldis. It
# records the tool directories and root variables in the GITHUB_PATH and GITHUB_ENV files;
# entrypoint.sh applies them.
COPY toolchains.lock /opt/aldis/
COPY .github/actions/setup-cpp/setup_cpp.py /opt/aldis/.github/actions/setup-cpp/
RUN mkdir -p /opt/aldis-cpp \
 && GITHUB_PATH=/opt/aldis-cpp/path GITHUB_ENV=/opt/aldis-cpp/env \
      python3 -I /opt/aldis/.github/actions/setup-cpp/setup_cpp.py \
        --downloads /tmp/aldis-cpp-downloads --tools-dir /opt/aldis-cpp/tools install all \
 && rm -rf /tmp/aldis-cpp-downloads /var/lib/apt/lists/* \
 && ln -s "$(command -v gcc-14)" /usr/local/bin/cc \
 && ln -s "$(command -v gcc-14)" /usr/local/bin/gcc \
 && ln -s "$(command -v g++-14)" /usr/local/bin/c++ \
 && ln -s "$(command -v g++-14)" /usr/local/bin/g++

# Rust: rustup-init 1.29.1, checked against its published SHA-256, then the pinned toolchains and
# cargo tools. cbindgen generates include/aldis/aldis.h (CABI-002; MPL-2.0, VER-055); its version
# is also pinned in xtask/src/header.rs, which refuses another. The tooling nightly carries
# rust-src for `-Z build-std` and Clippy for the LEON3 check, whose target is tier 3 (OI-08).
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN case "$TARGETARCH" in \
      amd64) triple=x86_64-unknown-linux-gnu; sha=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71 ;; \
      arm64) triple=aarch64-unknown-linux-gnu; sha=15f6e4ce9f583b929c996c91562bad6d4454f3281de858b02cdfdef615fac433 ;; \
      *) echo "unsupported architecture $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /tmp/rustup-init "https://static.rust-lang.org/rustup/archive/1.29.1/$triple/rustup-init" \
 && echo "$sha  /tmp/rustup-init" | sha256sum -c - \
 && chmod +x /tmp/rustup-init \
 && /tmp/rustup-init -y -q --no-modify-path --profile minimal --default-toolchain none \
 && rm /tmp/rustup-init
COPY rust-toolchain.toml tooling-nightly /opt/aldis-rust/
RUN cd /opt/aldis-rust \
 && rustup toolchain install \
 && rustup target add s390x-unknown-linux-gnu \
 && rustup toolchain install "$(cat tooling-nightly)" --profile minimal \
      --component llvm-tools --component rust-src --component clippy \
 && cargo install --locked --root /opt/cargo cargo-llvm-cov@0.9.1 cargo-deny@0.20.2 \
      cbindgen@0.29.4 \
 && rm -rf /opt/cargo/registry /opt/cargo/git

# LEON3 (SPARC V8) for the non-gating check rust-sparc-leon3 (OI-08): GNU ld, because rust-lld
# links no 32-bit SPARC, and QEMU's leon3_generic machine. Ubuntu 24.04 packages for both host
# architectures (Gaisler's BCC2 exists only for x86_64). As for the other QEMU systems, the
# upstream versions are asserted (binutils 2.42; QEMU_VERSION of toolchains.lock) and the
# Ubuntu revision may float; every evidence record lists it.
RUN apt-get update -q \
 && apt-get install -y -q --no-install-recommends binutils-sparc64-linux-gnu qemu-system-sparc \
 && rm -rf /var/lib/apt/lists/* \
 && sparc64-linux-gnu-ld --version | head -n 1 | grep -q ' 2\.42$' \
 && qemu="$(sed -n 's/^QEMU_VERSION=//p' /opt/aldis/toolchains.lock)" \
 && qemu-system-sparc --version | head -n 1 | grep -q "version $qemu "

# Kani for the non-gating check kani (OI-42, docs/verification/formal-proofs.md §7). The release
# bundle (kani-compiler and CBMC) is checked against the SHA-256 that GitHub records for the
# release asset, then installed from the local file, so that `cargo kani setup` downloads only
# the nightly it is built against, through rustup. The driver comes from crates.io with its lock
# file; its version is also pinned in xtask/src/kani.rs, which refuses another. CBMC's goto-cc
# preprocesses with `gcc`, linked to gcc-14 above.
ENV KANI_HOME=/opt/kani
RUN case "$TARGETARCH" in \
      amd64) triple=x86_64-unknown-linux-gnu; sha=32e2b484d73ede0bbf64a2cf0879c4259422497d8aec4ee67d448de9ae7843d3 ;; \
      arm64) triple=aarch64-unknown-linux-gnu; sha=0042d2688bf1550270def4a79c96aaeea138631818cb4ab5480120f2d51a942c ;; \
      *) echo "unsupported architecture $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /tmp/kani.tar.gz \
      "https://github.com/model-checking/kani/releases/download/kani-0.68.0/kani-0.68.0-$triple.tar.gz" \
 && echo "$sha  /tmp/kani.tar.gz" | sha256sum -c - \
 && cargo install --locked --root /opt/cargo kani-verifier@0.68.0 \
 && cargo kani setup --use-local-bundle /tmp/kani.tar.gz \
 && cargo kani --version | grep -q '0\.68\.0' \
 && rm -rf /tmp/kani.tar.gz /opt/cargo/registry /opt/cargo/git

COPY xtask/verify/entrypoint.sh /usr/local/bin/aldis-verify
RUN chmod 0755 /usr/local/bin/aldis-verify
ENTRYPOINT ["/usr/local/bin/aldis-verify"]
